def _xdg_data_dirs() -> list[str]:
    dirs: list[str] = []
    home = Path.home()
    dirs.append(str(home / ".local" / "share"))
    xdg = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share")
    for part in xdg.split(":"):
        part = part.strip()
        if part and part not in dirs:
            dirs.append(part)
    return dirs


def parse_desktop_entry(path: str | Path) -> dict[str, str]:
    """Parse [Desktop Entry] keys from a .desktop file (best-effort)."""
    out: dict[str, str] = {}
    try:
        text = Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return out
    in_entry = False
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            in_entry = line == "[Desktop Entry]"
            continue
        if not in_entry or "=" not in line:
            continue
        key, _, val = line.partition("=")
        key = key.strip()
        # First wins for plain keys (ignore Name[xx] localization for match later)
        if "[" in key:
            continue
        if key and key not in out:
            out[key] = val.strip()
    return out


def _exec_binary(exec_line: str) -> str:
    """First argv token from Exec=, without field codes."""
    if not exec_line:
        return ""
    cleaned = exec_line
    for code in ("%f", "%F", "%u", "%U", "%i", "%c", "%k"):
        cleaned = cleaned.replace(code, "")
    try:
        parts = shlex.split(cleaned)
    except ValueError:
        parts = cleaned.split()
    if not parts:
        return ""
    return Path(parts[0]).name


def _iter_desktop_files() -> list[Path]:
    seen: set[str] = set()
    files: list[Path] = []
    for data in _xdg_data_dirs():
        app_dir = Path(data) / "applications"
        if not app_dir.is_dir():
            continue
        try:
            for p in app_dir.glob("*.desktop"):
                key = p.name.casefold()
                # Prefer earlier XDG dirs (user over system)
                if key in seen:
                    continue
                if not p.is_file():
                    continue
                seen.add(key)
                files.append(p)
        except OSError:
            continue
    return files


def resolve_desktop_file(app: str) -> Optional[str]:
    """
    Return absolute path to a .desktop file, or None.

    Accepts: absolute .desktop path, desktop id (org.foo.Bar[.desktop]),
    short names (nautilus → org.gnome.Nautilus.desktop via Exec=/Name=).
    """
    app = app.strip().strip("'\"")
    if not app:
        return None
    p = Path(app).expanduser()
    if p.is_file() and p.suffix == ".desktop":
        return str(p.resolve())

    # Exact id / basename
    name = app if app.endswith(".desktop") else f"{app}.desktop"
    base = Path(name).name
    for data in _xdg_data_dirs():
        candidate = Path(data) / "applications" / base
        if candidate.is_file():
            return str(candidate.resolve())

    # Case-insensitive basename
    base_cf = base.casefold()
    for f in _iter_desktop_files():
        if f.name.casefold() == base_cf:
            return str(f.resolve())

    # Fuzzy: short command / name (nautilus, calculator, eog, …)
    q = app.casefold()
    if q.endswith(".desktop"):
        q = q[: -len(".desktop")]
    # Drop reverse-DNS prefix for "files"-style queries? keep full q
    candidates: list[tuple[int, str]] = []  # (score, path) lower is better
    for f in _iter_desktop_files():
        entry = parse_desktop_entry(f)
        if entry.get("Type", "Application") not in ("Application", ""):
            continue
        if entry.get("NoDisplay", "").lower() in ("true", "1"):
            # Still allow if Exec binary is exact match
            pass
        if entry.get("Hidden", "").lower() in ("true", "1"):
            continue
        stem = f.stem.casefold()
        exec_bin = _exec_binary(entry.get("Exec", "")).casefold()
        try_bin = (entry.get("TryExec") or "").casefold()
        if try_bin:
            try_bin = Path(try_bin).name.casefold()
        startup = (entry.get("StartupWMClass") or "").casefold()
        app_name = (entry.get("Name") or "").casefold()

        score: Optional[int] = None
        if exec_bin == q or try_bin == q:
            score = 0
        elif stem == q or stem.endswith("." + q):
            score = 1
        elif startup == q:
            score = 2
        elif app_name == q:
            score = 3
        elif q in stem.split("."):
            score = 4
        elif app_name.startswith(q) or q in app_name.split():
            score = 5
        if score is None:
            continue
        # Prefer visible apps
        if entry.get("NoDisplay", "").lower() in ("true", "1"):
            score += 10
        candidates.append((score, str(f.resolve())))

    if not candidates:
        return None
    candidates.sort(key=lambda t: (t[0], len(t[1]), t[1]))
    best_score = candidates[0][0]
    top = [c for c in candidates if c[0] == best_score]
    # Unique path; if several same score, prefer org.gnome.* then shorter stem
    if len(top) == 1:
        return top[0][1]

    def rank_path(path: str) -> tuple:
        stem = Path(path).stem
        gnome = 0 if stem.startswith("org.gnome.") else 1
        return (gnome, len(stem), stem.casefold())

    top.sort(key=lambda t: rank_path(t[1]))
    return top[0][1]


def _chrome_app_id_from_exec(exec_line: str) -> Optional[str]:
    """Parse --app-id=… / --app-id … from a desktop Exec= line."""
    if not exec_line:
        return None
    cleaned = exec_line
    for code in ("%f", "%F", "%u", "%U", "%i", "%c", "%k"):
        cleaned = cleaned.replace(code, "")
    try:
        parts = shlex.split(cleaned)
    except ValueError:
        parts = cleaned.split()
    for i, p in enumerate(parts):
        if p.startswith("--app-id="):
            aid = p.split("=", 1)[1].strip()
            if aid:
                return aid
        if p == "--app-id" and i + 1 < len(parts):
            aid = str(parts[i + 1]).strip()
            if aid:
                return aid
    return None


def infer_wm_class_hints(app: str, desktop: Optional[str] = None) -> list[str]:
    """
    Ordered candidate wm_class strings for wait / PlaceNext.
    Does not require --wm-class from the user.
    """
    hints: list[str] = []
    seen: set[str] = set()

    def add(v: Optional[str]) -> None:
        if not v:
            return
        v = str(v).strip()
        if not v:
            return
        # Exact casefold only — keep both crx_<id> and chrome-<id>-Default.
        cf = v.casefold()
        if cf in seen:
            return
        seen.add(cf)
        hints.append(v)

    if desktop:
        entry = parse_desktop_entry(desktop)
        startup = entry.get("StartupWMClass")
        exec_line = entry.get("Exec", "") or ""
        # Prefer Meta-facing chrome-<id>-Default, then crx_<id>.
        app_id = _chrome_pwa_app_id(startup or "") or _chrome_app_id_from_exec(exec_line)
        if app_id:
            add(f"chrome-{app_id}-Default")
            add(f"crx_{app_id}")
        else:
            add(startup)
        stem = Path(desktop).stem
        add(stem)
        # Last DNS label often matches Meta class (Nautilus, Calculator)
        if "." in stem:
            add(stem.rsplit(".", 1)[-1])
        add(_exec_binary(exec_line))
        te = entry.get("TryExec") or ""
        if te:
            add(Path(te).name)

    raw = app.strip().strip("'\"")
    if raw:
        add(Path(raw).name)
        if raw.endswith(".desktop"):
            add(Path(raw).stem)
        if "." in raw and not raw.endswith(".desktop"):
            add(raw.rsplit(".", 1)[-1])
    return hints


def _ghostty_exe_from_desktop(desktop: Optional[str]) -> Optional[str]:
    """TryExec/Exec binary path from a Ghostty .desktop, if absolute and present."""
    if not desktop:
        return None
    try:
        entry = parse_desktop_entry(desktop)
    except Exception:
        return None
    for key in ("TryExec", "Exec"):
        raw = entry.get(key) or ""
        if not raw:
            continue
        if key == "Exec":
            token = _exec_binary_path(raw)
        else:
            token = str(raw).strip()
        if token and os.path.isabs(token) and os.path.isfile(token):
            return token
        if token and shutil.which(token):
            return shutil.which(token)
    return None


def _exec_binary_path(exec_line: str) -> str:
    """First argv token from Exec= (path or name), without field codes."""
    if not exec_line:
        return ""
    cleaned = exec_line
    for code in ("%f", "%F", "%u", "%U", "%i", "%c", "%k"):
        cleaned = cleaned.replace(code, "")
    try:
        parts = shlex.split(cleaned)
    except ValueError:
        parts = cleaned.split()
    if not parts:
        return ""
    return parts[0]


def _launch_home() -> str:
    """cwd for CLI-spawned apps — never inherit the shell's project dir."""
    return os.path.expanduser("~") or "/"


# Agent / CI shells (Grok tool runners, etc.) set these so CLI output is plain.
# Desktop apps launched via `forge layout` / `forge launch` must not inherit them:
# terminals (Ghostty) pass the env to interactive shells, and Grok TUI then stays
# monochrome because NO_COLOR is set. Strip the common color-kill suite only.
#
# Also drop durable-job worker markers. Layout runs inside a job worker which sets
# FORGE_JOB=0 + FORGE_JOB_WORKER=1; if those leak into Ghostty, interactive
# `forge install` skips the job runner (always "foreground") and FORGE_JOB=1
# cannot re-enable it. Guake (session-started) never saw those vars — inconsistent.
_LAUNCH_ENV_DROP = frozenset(
    {
        "NO_COLOR",
        "FORCE_COLOR",
        "CLICOLOR",
        "CLICOLOR_FORCE",
        "CARGO_TERM_COLOR",
        "PIP_NO_COLOR",
        "NPM_CONFIG_COLOR",
        "PY_COLORS",
        "PYTHON_COLORS",
        "FORGE_JOB",
        "FORGE_JOB_WORKER",
        "FORGE_JOB_ID",
        "FORGE_JOB_DIR",
    }
)


def _launch_env(base: Optional[dict[str, str]] = None) -> dict[str, str]:
    """
    Environment for CLI-spawned desktop apps.

    Copy of the current process env (or base) with agent/CI color-suppression
    and durable-job worker variables removed so Ghostty/shell/Grok open as
    normal interactive sessions (colors + default job mode for mutators).
    """
    env = dict(os.environ if base is None else base)
    for key in _LAUNCH_ENV_DROP:
        env.pop(key, None)
    return env


def _popen_detached(argv: list[str]) -> subprocess.Popen:
    """Spawn out-of-process with $HOME cwd and a cleaned env (no NO_COLOR, etc.)."""
    return subprocess.Popen(
        argv,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        cwd=_launch_home(),
        env=_launch_env(),
    )


def launch_app(app: str, desktop: Optional[str] = None) -> subprocess.Popen:
    """
    Start an app out-of-process.
    Prefer gio launch / gtk-launch for .desktop ids; else spawn argv.

    Ghostty: never gio the stock single-instance desktop — spawn argv with
    --gtk-single-instance=false so a second terminal can PlaceNext onto mon1.

    Always uses cwd=$HOME so `forge layout` from a project directory does not
    make Ghostty inherit that working directory.

    Strips agent/CI color-suppression env (NO_COLOR, FORCE_COLOR, CLICOLOR, …)
    so terminals opened by layout/launch stay usable for colored TUIs (Grok).
    """
    if desktop is None:
        # Multi-instance argv string still resolves desktop via bare stem for hints
        # callers that already resolved; bare resolve here uses full app.
        desktop = resolve_desktop_file(app)
        if desktop is None and is_ghostty_launch_target(app):
            desktop = resolve_desktop_file("ghostty") or resolve_desktop_file(
                "com.mitchellh.ghostty"
            )

    if is_ghostty_launch_target(app, desktop):
        exe = _ghostty_exe_from_desktop(desktop)
        argv = ghostty_multi_instance_argv(app, desktop=desktop, exe_path=exe)
        exe0 = argv[0]
        if not os.path.isabs(exe0) and not shutil.which(exe0):
            raise RuntimeError(
                f"ghostty multi-instance launch: executable not found: {exe0!r} "
                f"(app={app!r})"
            )
        return _popen_detached(argv)

    if desktop:
        if shutil.which("gio"):
            return _popen_detached(["gio", "launch", desktop])
        if shutil.which("gtk-launch"):
            did = Path(desktop).stem
            return _popen_detached(["gtk-launch", did])
        raise RuntimeError(
            f"found desktop file {desktop} but neither gio nor gtk-launch is on PATH"
        )

    # Executable on PATH or absolute path / shell-ish argv
    argv = shlex.split(app.strip().strip("'\""))
    if not argv:
        raise RuntimeError("empty app command")
    exe = argv[0]
    if not os.path.isabs(exe) and not shutil.which(exe):
        raise RuntimeError(
            f"app not found as desktop id, short name, or executable: {app!r} "
            f"(tried *.desktop under XDG applications and PATH)"
        )
    return _popen_detached(argv)


def _is_chrome_browser_class(s: str) -> bool:
    """Google-chrome / Chromium family (not a PWA instance id)."""
    n = (s or "").strip().casefold()
    if not n:
        return False
    if n in ("google-chrome", "chromium", "chromium-browser", "chrome"):
        return True
    if n.startswith("google-chrome-"):
        return True
    return False


def _chrome_pwa_app_id(s: str) -> Optional[str]:
    """Shared id for crx_<id> and chrome-<id>-Default / profile-ish."""
    n = (s or "").strip().casefold()
    if not n:
        return None
    if n.startswith("crx_") and len(n) > 4:
        return n[4:]
    if not n.startswith("chrome-"):
        return None
    rest = n[len("chrome-") :]
    if rest.endswith("-default") and len(rest) > len("-default"):
        return rest[: -len("-default")]
    m = re.match(r"^(.+)-profile(?:[._-].+)?$", rest)
    if m and m.group(1):
        return m.group(1)
    return None


def _is_chrome_pwa_class(s: str) -> bool:
    return _chrome_pwa_app_id(s) is not None


def _is_chrome_family_class(s: str) -> bool:
    return _is_chrome_browser_class(s) or _is_chrome_pwa_class(s)


def _open_action_is_chrome_family(action: Any) -> bool:
    """True when a plan open will spawn Chrome or a Chrome PWA (same profile)."""
    if not isinstance(action, dict):
        return False
    open_spec = action.get("open") if isinstance(action.get("open"), dict) else {}
    for key in ("wmClass", "wm_class"):
        v = open_spec.get(key)
        if v is not None and _is_chrome_family_class(str(v)):
            return True
    match = action.get("match") if isinstance(action.get("match"), dict) else {}
    v = match.get("class") or match.get("wmClass") or match.get("wm_class")
    if v is not None and _is_chrome_family_class(str(v)):
        return True
    return False


def _class_eq(a: Any, b: Any) -> bool:
    """Casefold + reverse-DNS stem + browser↔PWA / same PWA id / browser↔browser."""
    if a is None or b is None:
        return False
    sa = str(a).strip().casefold()
    sb = str(b).strip().casefold()
    if not sa or not sb:
        return False
    if sa == sb:
        return True
    if sa.endswith("." + sb) or sb.endswith("." + sa):
        return True
    a_id = _chrome_pwa_app_id(sa)
    b_id = _chrome_pwa_app_id(sb)
    if a_id and b_id and a_id == b_id:
        return True
    # Browser ↔ PWA (either side); browser ↔ browser. Never distinct PWA ↔ PWA.
    a_browser = _is_chrome_browser_class(sa)
    b_browser = _is_chrome_browser_class(sb)
    a_pwa = _is_chrome_pwa_class(sa)
    b_pwa = _is_chrome_pwa_class(sb)
    if (a_browser and b_pwa) or (a_pwa and b_browser):
        return True
    if a_browser and b_browser:
        return True
    return False


def merge_launch_wait_classes(
    explicit: Optional[str], hints: list[str]
) -> Optional[list[str]]:
    """Desktop hints first, then explicit; casefold-exact dedupe (keep PWA forms)."""
    wait: list[str] = []
    seen: set[str] = set()

    def push(v: str) -> None:
        cf = v.casefold()
        if cf in seen:
            return
        seen.add(cf)
        wait.append(v)

    for h in hints or []:
        if not h:
            continue
        hv = str(h).strip()
        if hv:
            push(hv)
    if explicit:
        e = str(explicit).strip()
        if e:
            push(e)
    return wait or None


def prefer_launch_place_class(
    explicit: Optional[str], hints: list[str]
) -> Optional[str]:
    """Prefer Meta-facing chrome-*-Default / crx_* over sugar Google-chrome."""
    for h in hints or []:
        if h and _is_chrome_pwa_class(h) and str(h).strip().casefold().startswith("chrome-"):
            return str(h).strip()
    for h in hints or []:
        if h and _is_chrome_pwa_class(h):
            return str(h).strip()
    for h in hints or []:
        if not h:
            continue
        if explicit and _is_chrome_browser_class(explicit) and not _is_chrome_browser_class(h):
            return str(h).strip()
    if hints:
        first = str(hints[0]).strip()
        if first:
            return first
    if explicit:
        e = str(explicit).strip()
        return e or None
    return None


def _iter_tree_windows(node: Any) -> list[dict[str, Any]]:
    """
    Collect WINDOW dicts from a GetTree forest/node.
    Annotates each with path moNwsW/i/j… (does not mutate input nodes).
    Also unions metaWindows / orphanWindows when present (R030).
    """
    out: list[dict[str, Any]] = []
    seen: set[str] = set()

    def add(w: dict[str, Any], path: str = "") -> None:
        if not isinstance(w, dict):
            return
        row = dict(w)
        if not row.get("path") and path:
            row["path"] = path
        wid = row.get("windowId")
        if wid is not None and str(wid).strip() != "":
            key = str(wid).strip()
            if key in seen:
                return
            seen.add(key)
        out.append(row)

    def walk(n: Any, path: str) -> None:
        if not isinstance(n, dict):
            return
        ntype = n.get("nodeType") or n.get("type")
        if ntype == "WINDOW":
            add(n, path)
            kids = n.get("children") or n.get("childNodes") or []
            if isinstance(kids, list):
                for i, c in enumerate(kids):
                    walk(c, f"{path}/{i}" if path else str(i))
            return
        kids = n.get("children") or n.get("childNodes") or []
        if not isinstance(kids, list):
            return
        mon_id = n.get("id") if ntype == "MONITOR" else None
        for i, c in enumerate(kids):
            if mon_id:
                child_path = f"{mon_id}/{i}"
            elif path:
                child_path = f"{path}/{i}"
            else:
                child_path = str(i)
            walk(c, child_path)

    if isinstance(node, dict):
        if "monitors" in node and isinstance(node["monitors"], list):
            for m in node["monitors"]:
                walk(m, "")
        else:
            walk(node, "")
        for extra in (node.get("orphanWindows") or []) + (node.get("metaWindows") or []):
            if not isinstance(extra, dict):
                continue
            if extra.get("placeholder") is True:
                continue
            if extra.get("tracked") is False:
                continue
            add(extra)
    elif isinstance(node, list):
        for m in node:
            walk(m, "")
    return out


def _windows_matching_class(
    forest: Any, wm_class: str | list[str] | None
) -> list[dict[str, Any]]:
    """Match one class, any of several classes, or all windows if wm_class is None."""
    if wm_class is None:
        return _iter_tree_windows(forest)
    want_list = [wm_class] if isinstance(wm_class, str) else list(wm_class)
    want_list = [w for w in want_list if w]
    if not want_list:
        return _iter_tree_windows(forest)
    hits = []
    for w in _iter_tree_windows(forest):
        cls = w.get("wmClass") or w.get("wm_class")
        if any(_class_eq(cls, want) for want in want_list):
            hits.append(w)
    return hits


def _normalize_class_list(wm_class: str | list[str] | None) -> list[str]:
    if wm_class is None:
        return []
    if isinstance(wm_class, str):
        return [wm_class] if wm_class.strip() else []
    return [str(x) for x in wm_class if x and str(x).strip()]


def wait_for_wm_class(
    backend: str,
    wm_class: str | list[str] | None,
    timeout_ms: int,
    *,
    first: bool,
    baseline_ids: Optional[set[str]] = None,
    accept_any_new: bool = False,
    require_settled: bool = True,
) -> dict[str, Any]:
    """
    Poll GetTree until a matching window appears (or timeout).

    Prefer windows whose windowId was not in baseline_ids.
    wm_class may be one string, several candidates, or empty/None.
    When class hints are set: match those first (case-insensitive).
    When accept_any_new is True (default for launch without --wm-class): if the
    timeout elapses with unmatched new windows, return the first new one.
    While polling with no class hints, any new window wins immediately.

    LF5: when require_settled (default), do not return on mere class appear —
    wait until window_is_settled (TILE + id + reasonable rect). Unsettled hits
    are remembered; on timeout still return the hit so callers can try moves.

    CL9 layout deferred opens: require_settled=False waits for map + windowId
    only (FLOAT+hidden is ok); do not require TILE.
    """
    deadline = time.monotonic() + max(0, timeout_ms) / 1000.0
    baseline_ids = baseline_ids or set()
    last_err = "timeout"
    seen_classes: set[str] = set()
    class_list = _normalize_class_list(wm_class)
    last_fresh: list[dict[str, Any]] = []
    pending_unsettled: Optional[dict[str, Any]] = None

    def _chosen(pool: list[dict[str, Any]], matched_by: str) -> dict[str, Any]:
        c = pool[0]
        return {
            "ok": True,
            "windowId": c.get("windowId"),
            "title": c.get("title"),
            "wmClass": c.get("wmClass"),
            "path": c.get("path"),
            "mode": c.get("mode"),
            "matchedBy": matched_by,
            "settled": window_is_settled(c),
        }

    def _pick_settled_or_note(
        hits: list[dict[str, Any]], matched_by: str
    ) -> Optional[dict[str, Any]]:
        nonlocal pending_unsettled
        if not hits:
            return None
        if not require_settled:
            # CL9: map pin only — need windowId; mode may stay FLOAT while deferred.
            with_id = [
                w
                for w in hits
                if w.get("windowId") is not None and str(w.get("windowId")).strip() != ""
            ]
            if with_id:
                return _chosen(with_id, matched_by)
            # Appear without id yet — remember and keep polling.
            if pending_unsettled is None:
                pending_unsettled = _chosen(hits, matched_by)
                pending_unsettled["settled"] = False
            return None
        settled = [w for w in hits if window_is_settled(w)]
        if settled:
            return _chosen(settled, matched_by)
        # Remember first appear; keep polling for TILE / rect.
        if pending_unsettled is None:
            pending_unsettled = _chosen(hits, matched_by)
            pending_unsettled["settled"] = False
        return None

    while time.monotonic() <= deadline:
        try:
            raw = call_method(backend, "GetTree", "{}")
            data = json.loads(raw)
        except Exception as e:
            last_err = str(e)
            time.sleep(0.15)
            continue
        if isinstance(data, dict) and data.get("error"):
            last_err = str(data["error"])
            time.sleep(0.15)
            continue
        all_wins = _iter_tree_windows(data)
        fresh = [
            w
            for w in all_wins
            if w.get("windowId") is None or str(w.get("windowId")) not in baseline_ids
        ]
        for w in fresh:
            cls = w.get("wmClass") or w.get("wm_class")
            if cls:
                seen_classes.add(str(cls))
        if fresh:
            last_fresh = fresh

        if class_list:
            hits = [
                w
                for w in fresh
                if any(
                    _class_eq(w.get("wmClass") or w.get("wm_class"), want)
                    for want in class_list
                )
            ]
            # Also allow class match on pre-existing if no baseline (rare)
            if not hits and not baseline_ids:
                hits = _windows_matching_class(data, class_list)
            picked = _pick_settled_or_note(hits, "wm-class")
            if picked:
                return picked
        else:
            # No hints: first new window (optionally settled)
            picked = _pick_settled_or_note(fresh, "new-window")
            if picked:
                return picked

        # If we already have an id, re-check that leaf in the live tree for settle.
        if require_settled and pending_unsettled and pending_unsettled.get("windowId") is not None:
            wid = pending_unsettled["windowId"]
            live = find_settled_window(all_wins, window_id=wid)
            if live:
                out = _chosen([live], pending_unsettled.get("matchedBy") or "wm-class")
                out["settled"] = True
                return out

        time.sleep(0.12)

    # Class hints never matched — optionally take any new window that appeared
    if accept_any_new and last_fresh:
        picked = _pick_settled_or_note(last_fresh, "new-window")
        if picked:
            return picked
        # Unsettled new window is better than total failure for pin.
        if pending_unsettled:
            pending_unsettled["settleTimeout"] = True
            return pending_unsettled
        return _chosen(last_fresh, "new-window")

    # Appeared but never TILE within timeout: return unsettled so residual can still try.
    if pending_unsettled:
        pending_unsettled["settleTimeout"] = True
        pending_unsettled["ok"] = True
        return pending_unsettled

    out: dict[str, Any] = {
        "ok": False,
        "error": f"wait timeout after {timeout_ms}ms ({last_err})",
    }
    if len(class_list) == 1:
        out["wmClass"] = class_list[0]
    elif class_list:
        out["wmClassCandidates"] = class_list
    if seen_classes:
        out["seenClasses"] = sorted(seen_classes)
    return out


def _baseline_window_ids(backend: str) -> set[str]:
    try:
        raw = call_method(backend, "GetTree", "{}")
        data = json.loads(raw)
    except Exception:
        return set()
    if isinstance(data, dict) and data.get("error"):
        return set()
    ids: set[str] = set()
    for w in _iter_tree_windows(data):
        wid = w.get("windowId")
        if wid is not None:
            ids.add(str(wid))
    return ids


