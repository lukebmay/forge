def _xdg_data_dirs() -> list[str]:
    dirs: list[str] = []
    home = Path.home()
    dirs.append(str(home / ".local" / "share"))
    xdg = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share")
    for part in xdg.split(":"):
        part = part.strip()
        if part and part not in dirs:
            dirs.append(part)
    return dirs


def parse_desktop_entry(path: str | Path) -> dict[str, str]:
    """Parse [Desktop Entry] keys from a .desktop file (best-effort)."""
    out: dict[str, str] = {}
    try:
        text = Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return out
    in_entry = False
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            in_entry = line == "[Desktop Entry]"
            continue
        if not in_entry or "=" not in line:
            continue
        key, _, val = line.partition("=")
        key = key.strip()
        # First wins for plain keys (ignore Name[xx] localization for match later)
        if "[" in key:
            continue
        if key and key not in out:
            out[key] = val.strip()
    return out


def _exec_binary(exec_line: str) -> str:
    """First argv token from Exec=, without field codes."""
    if not exec_line:
        return ""
    cleaned = exec_line
    for code in ("%f", "%F", "%u", "%U", "%i", "%c", "%k"):
        cleaned = cleaned.replace(code, "")
    try:
        parts = shlex.split(cleaned)
    except ValueError:
        parts = cleaned.split()
    if not parts:
        return ""
    return Path(parts[0]).name


def _iter_desktop_files() -> list[Path]:
    seen: set[str] = set()
    files: list[Path] = []
    for data in _xdg_data_dirs():
        app_dir = Path(data) / "applications"
        if not app_dir.is_dir():
            continue
        try:
            for p in app_dir.glob("*.desktop"):
                key = p.name.casefold()
                # Prefer earlier XDG dirs (user over system)
                if key in seen:
                    continue
                if not p.is_file():
                    continue
                seen.add(key)
                files.append(p)
        except OSError:
            continue
    return files


def resolve_desktop_file(app: str) -> Optional[str]:
    """
    Return absolute path to a .desktop file, or None.

    Accepts: absolute .desktop path, desktop id (org.foo.Bar[.desktop]),
    short names (nautilus → org.gnome.Nautilus.desktop via Exec=/Name=).
    """
    app = app.strip().strip("'\"")
    if not app:
        return None
    p = Path(app).expanduser()
    if p.is_file() and p.suffix == ".desktop":
        return str(p.resolve())

    # Exact id / basename
    name = app if app.endswith(".desktop") else f"{app}.desktop"
    base = Path(name).name
    for data in _xdg_data_dirs():
        candidate = Path(data) / "applications" / base
        if candidate.is_file():
            return str(candidate.resolve())

    # Case-insensitive basename
    base_cf = base.casefold()
    for f in _iter_desktop_files():
        if f.name.casefold() == base_cf:
            return str(f.resolve())

    # Fuzzy: short command / name (nautilus, calculator, eog, …)
    q = app.casefold()
    if q.endswith(".desktop"):
        q = q[: -len(".desktop")]
    # Drop reverse-DNS prefix for "files"-style queries? keep full q
    candidates: list[tuple[int, str]] = []  # (score, path) lower is better
    for f in _iter_desktop_files():
        entry = parse_desktop_entry(f)
        if entry.get("Type", "Application") not in ("Application", ""):
            continue
        if entry.get("NoDisplay", "").lower() in ("true", "1"):
            # Still allow if Exec binary is exact match
            pass
        if entry.get("Hidden", "").lower() in ("true", "1"):
            continue
        stem = f.stem.casefold()
        exec_bin = _exec_binary(entry.get("Exec", "")).casefold()
        try_bin = (entry.get("TryExec") or "").casefold()
        if try_bin:
            try_bin = Path(try_bin).name.casefold()
        startup = (entry.get("StartupWMClass") or "").casefold()
        app_name = (entry.get("Name") or "").casefold()

        score: Optional[int] = None
        if exec_bin == q or try_bin == q:
            score = 0
        elif stem == q or stem.endswith("." + q):
            score = 1
        elif startup == q:
            score = 2
        elif app_name == q:
            score = 3
        elif q in stem.split("."):
            score = 4
        elif app_name.startswith(q) or q in app_name.split():
            score = 5
        if score is None:
            continue
        # Prefer visible apps
        if entry.get("NoDisplay", "").lower() in ("true", "1"):
            score += 10
        candidates.append((score, str(f.resolve())))

    if not candidates:
        return None
    candidates.sort(key=lambda t: (t[0], len(t[1]), t[1]))
    best_score = candidates[0][0]
    top = [c for c in candidates if c[0] == best_score]
    # Unique path; if several same score, prefer org.gnome.* then shorter stem
    if len(top) == 1:
        return top[0][1]

    def rank_path(path: str) -> tuple:
        stem = Path(path).stem
        gnome = 0 if stem.startswith("org.gnome.") else 1
        return (gnome, len(stem), stem.casefold())

    top.sort(key=lambda t: rank_path(t[1]))
    return top[0][1]


def _chrome_app_id_from_exec(exec_line: str) -> Optional[str]:
    """Parse --app-id=… / --app-id … from a desktop Exec= line."""
    if not exec_line:
        return None
    cleaned = exec_line
    for code in ("%f", "%F", "%u", "%U", "%i", "%c", "%k"):
        cleaned = cleaned.replace(code, "")
    try:
        parts = shlex.split(cleaned)
    except ValueError:
        parts = cleaned.split()
    for i, p in enumerate(parts):
        if p.startswith("--app-id="):
            aid = p.split("=", 1)[1].strip()
            if aid:
                return aid
        if p == "--app-id" and i + 1 < len(parts):
            aid = str(parts[i + 1]).strip()
            if aid:
                return aid
    return None


def infer_wm_class_hints(app: str, desktop: Optional[str] = None) -> list[str]:
    """
    Ordered candidate wm_class strings for wait / PlaceNext.
    Does not require --wm-class from the user.
    """
    hints: list[str] = []
    seen: set[str] = set()

    def add(v: Optional[str]) -> None:
        if not v:
            return
        v = str(v).strip()
        if not v:
            return
        # Exact casefold only — keep both crx_<id> and chrome-<id>-Default.
        cf = v.casefold()
        if cf in seen:
            return
        seen.add(cf)
        hints.append(v)

    if desktop:
        entry = parse_desktop_entry(desktop)
        startup = entry.get("StartupWMClass")
        exec_line = entry.get("Exec", "") or ""
        # Prefer Meta-facing chrome-<id>-Default, then crx_<id>.
        app_id = _chrome_pwa_app_id(startup or "") or _chrome_app_id_from_exec(exec_line)
        if app_id:
            add(f"chrome-{app_id}-Default")
            add(f"crx_{app_id}")
        else:
            add(startup)
        stem = Path(desktop).stem
        add(stem)
        # Last DNS label often matches Meta class (Nautilus, Calculator)
        if "." in stem:
            add(stem.rsplit(".", 1)[-1])
        add(_exec_binary(exec_line))
        te = entry.get("TryExec") or ""
        if te:
            add(Path(te).name)

    raw = app.strip().strip("'\"")
    if raw:
        add(Path(raw).name)
        if raw.endswith(".desktop"):
            add(Path(raw).stem)
        if "." in raw and not raw.endswith(".desktop"):
            add(raw.rsplit(".", 1)[-1])
    return hints


def _ghostty_exe_from_desktop(desktop: Optional[str]) -> Optional[str]:
    """TryExec/Exec binary path from a Ghostty .desktop, if absolute and present."""
    if not desktop:
        return None
    try:
        entry = parse_desktop_entry(desktop)
    except Exception:
        return None
    for key in ("TryExec", "Exec"):
        raw = entry.get(key) or ""
        if not raw:
            continue
        if key == "Exec":
            token = _exec_binary_path(raw)
        else:
            token = str(raw).strip()
        if token and os.path.isabs(token) and os.path.isfile(token):
            return token
        if token and shutil.which(token):
            return shutil.which(token)
    return None


def _exec_binary_path(exec_line: str) -> str:
    """First argv token from Exec= (path or name), without field codes."""
    if not exec_line:
        return ""
    cleaned = exec_line
    for code in ("%f", "%F", "%u", "%U", "%i", "%c", "%k"):
        cleaned = cleaned.replace(code, "")
    try:
        parts = shlex.split(cleaned)
    except ValueError:
        parts = cleaned.split()
    if not parts:
        return ""
    return parts[0]


def _launch_home() -> str:
    """cwd for CLI-spawned apps — never inherit the shell's project dir."""
    return os.path.expanduser("~") or "/"


# Agent / CI shells (Grok tool runners, etc.) set these so CLI output is plain.
# Desktop apps launched via `forge layout` / `forge launch` must not inherit them:
# terminals (Ghostty) pass the env to interactive shells, and Grok TUI then stays
# monochrome because NO_COLOR is set. Strip the common color-kill suite only.
_LAUNCH_ENV_DROP = frozenset(
    {
        "NO_COLOR",
        "FORCE_COLOR",
        "CLICOLOR",
        "CLICOLOR_FORCE",
        "CARGO_TERM_COLOR",
        "PIP_NO_COLOR",
        "NPM_CONFIG_COLOR",
        "PY_COLORS",
        "PYTHON_COLORS",
    }
)


def _launch_env(base: Optional[dict[str, str]] = None) -> dict[str, str]:
    """
    Environment for CLI-spawned desktop apps.

    Copy of the current process env (or base) with agent/CI color-suppression
    variables removed so Ghostty/shell/Grok open as normal interactive sessions.
    """
    env = dict(os.environ if base is None else base)
    for key in _LAUNCH_ENV_DROP:
        env.pop(key, None)
    return env


def _popen_detached(argv: list[str]) -> subprocess.Popen:
    """Spawn out-of-process with $HOME cwd and a cleaned env (no NO_COLOR, etc.)."""
    return subprocess.Popen(
        argv,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        cwd=_launch_home(),
        env=_launch_env(),
    )


def launch_app(app: str, desktop: Optional[str] = None) -> subprocess.Popen:
    """
    Start an app out-of-process.
    Prefer gio launch / gtk-launch for .desktop ids; else spawn argv.

    Ghostty: never gio the stock single-instance desktop — spawn argv with
    --gtk-single-instance=false so a second terminal can PlaceNext onto mon1.

    Always uses cwd=$HOME so `forge layout` from a project directory does not
    make Ghostty inherit that working directory.

    Strips agent/CI color-suppression env (NO_COLOR, FORCE_COLOR, CLICOLOR, …)
    so terminals opened by layout/launch stay usable for colored TUIs (Grok).
    """
    if desktop is None:
        # Multi-instance argv string still resolves desktop via bare stem for hints
        # callers that already resolved; bare resolve here uses full app.
        desktop = resolve_desktop_file(app)
        if desktop is None and is_ghostty_launch_target(app):
            desktop = resolve_desktop_file("ghostty") or resolve_desktop_file(
                "com.mitchellh.ghostty"
            )

    if is_ghostty_launch_target(app, desktop):
        exe = _ghostty_exe_from_desktop(desktop)
        argv = ghostty_multi_instance_argv(app, desktop=desktop, exe_path=exe)
        exe0 = argv[0]
        if not os.path.isabs(exe0) and not shutil.which(exe0):
            raise RuntimeError(
                f"ghostty multi-instance launch: executable not found: {exe0!r} "
                f"(app={app!r})"
            )
        return _popen_detached(argv)

    if desktop:
        if shutil.which("gio"):
            return _popen_detached(["gio", "launch", desktop])
        if shutil.which("gtk-launch"):
            did = Path(desktop).stem
            return _popen_detached(["gtk-launch", did])
        raise RuntimeError(
            f"found desktop file {desktop} but neither gio nor gtk-launch is on PATH"
        )

    # Executable on PATH or absolute path / shell-ish argv
    argv = shlex.split(app.strip().strip("'\""))
    if not argv:
        raise RuntimeError("empty app command")
    exe = argv[0]
    if not os.path.isabs(exe) and not shutil.which(exe):
        raise RuntimeError(
            f"app not found as desktop id, short name, or executable: {app!r} "
            f"(tried *.desktop under XDG applications and PATH)"
        )
    return _popen_detached(argv)


def _is_chrome_browser_class(s: str) -> bool:
    """Google-chrome / Chromium family (not a PWA instance id)."""
    n = (s or "").strip().casefold()
    if not n:
        return False
    if n in ("google-chrome", "chromium", "chromium-browser", "chrome"):
        return True
    if n.startswith("google-chrome-"):
        return True
    return False


def _chrome_pwa_app_id(s: str) -> Optional[str]:
    """Shared id for crx_<id> and chrome-<id>-Default / profile-ish."""
    n = (s or "").strip().casefold()
    if not n:
        return None
    if n.startswith("crx_") and len(n) > 4:
        return n[4:]
    if not n.startswith("chrome-"):
        return None
    rest = n[len("chrome-") :]
    if rest.endswith("-default") and len(rest) > len("-default"):
        return rest[: -len("-default")]
    m = re.match(r"^(.+)-profile(?:[._-].+)?$", rest)
    if m and m.group(1):
        return m.group(1)
    return None


def _is_chrome_pwa_class(s: str) -> bool:
    return _chrome_pwa_app_id(s) is not None


def _is_chrome_family_class(s: str) -> bool:
    return _is_chrome_browser_class(s) or _is_chrome_pwa_class(s)


def _class_eq(a: Any, b: Any) -> bool:
    """Casefold + reverse-DNS stem + browser↔PWA / same PWA id / browser↔browser."""
    if a is None or b is None:
        return False
    sa = str(a).strip().casefold()
    sb = str(b).strip().casefold()
    if not sa or not sb:
        return False
    if sa == sb:
        return True
    if sa.endswith("." + sb) or sb.endswith("." + sa):
        return True
    a_id = _chrome_pwa_app_id(sa)
    b_id = _chrome_pwa_app_id(sb)
    if a_id and b_id and a_id == b_id:
        return True
    # Browser ↔ PWA (either side); browser ↔ browser. Never distinct PWA ↔ PWA.
    a_browser = _is_chrome_browser_class(sa)
    b_browser = _is_chrome_browser_class(sb)
    a_pwa = _is_chrome_pwa_class(sa)
    b_pwa = _is_chrome_pwa_class(sb)
    if (a_browser and b_pwa) or (a_pwa and b_browser):
        return True
    if a_browser and b_browser:
        return True
    return False


def merge_launch_wait_classes(
    explicit: Optional[str], hints: list[str]
) -> Optional[list[str]]:
    """Desktop hints first, then explicit; casefold-exact dedupe (keep PWA forms)."""
    wait: list[str] = []
    seen: set[str] = set()

    def push(v: str) -> None:
        cf = v.casefold()
        if cf in seen:
            return
        seen.add(cf)
        wait.append(v)

    for h in hints or []:
        if not h:
            continue
        hv = str(h).strip()
        if hv:
            push(hv)
    if explicit:
        e = str(explicit).strip()
        if e:
            push(e)
    return wait or None


def prefer_launch_place_class(
    explicit: Optional[str], hints: list[str]
) -> Optional[str]:
    """Prefer Meta-facing chrome-*-Default / crx_* over sugar Google-chrome."""
    for h in hints or []:
        if h and _is_chrome_pwa_class(h) and str(h).strip().casefold().startswith("chrome-"):
            return str(h).strip()
    for h in hints or []:
        if h and _is_chrome_pwa_class(h):
            return str(h).strip()
    for h in hints or []:
        if not h:
            continue
        if explicit and _is_chrome_browser_class(explicit) and not _is_chrome_browser_class(h):
            return str(h).strip()
    if hints:
        first = str(hints[0]).strip()
        if first:
            return first
    if explicit:
        e = str(explicit).strip()
        return e or None
    return None


def _iter_tree_windows(node: Any) -> list[dict[str, Any]]:
    """
    Collect WINDOW dicts from a GetTree forest/node.
    Annotates each with path moNwsW/i/j… (does not mutate input nodes).
    """
    out: list[dict[str, Any]] = []

    def walk(n: Any, path: str) -> None:
        if not isinstance(n, dict):
            return
        ntype = n.get("nodeType") or n.get("type")
        if ntype == "WINDOW":
            w = dict(n)
            if not w.get("path"):
                w["path"] = path or None
            out.append(w)
            return
        kids = n.get("children") or n.get("childNodes") or []
        if not isinstance(kids, list):
            return
        mon_id = n.get("id") if ntype == "MONITOR" else None
        for i, c in enumerate(kids):
            if mon_id:
                child_path = f"{mon_id}/{i}"
            elif path:
                child_path = f"{path}/{i}"
            else:
                child_path = str(i)
            walk(c, child_path)

    if isinstance(node, dict):
        if "monitors" in node and isinstance(node["monitors"], list):
            for m in node["monitors"]:
                walk(m, "")
        else:
            walk(node, "")
    elif isinstance(node, list):
        for m in node:
            walk(m, "")
    return out


def _windows_matching_class(
    forest: Any, wm_class: str | list[str] | None
) -> list[dict[str, Any]]:
    """Match one class, any of several classes, or all windows if wm_class is None."""
    if wm_class is None:
        return _iter_tree_windows(forest)
    want_list = [wm_class] if isinstance(wm_class, str) else list(wm_class)
    want_list = [w for w in want_list if w]
    if not want_list:
        return _iter_tree_windows(forest)
    hits = []
    for w in _iter_tree_windows(forest):
        cls = w.get("wmClass") or w.get("wm_class")
        if any(_class_eq(cls, want) for want in want_list):
            hits.append(w)
    return hits


def _normalize_class_list(wm_class: str | list[str] | None) -> list[str]:
    if wm_class is None:
        return []
    if isinstance(wm_class, str):
        return [wm_class] if wm_class.strip() else []
    return [str(x) for x in wm_class if x and str(x).strip()]


def wait_for_wm_class(
    backend: str,
    wm_class: str | list[str] | None,
    timeout_ms: int,
    *,
    first: bool,
    baseline_ids: Optional[set[str]] = None,
    accept_any_new: bool = False,
    require_settled: bool = True,
) -> dict[str, Any]:
    """
    Poll GetTree until a matching window appears (or timeout).

    Prefer windows whose windowId was not in baseline_ids.
    wm_class may be one string, several candidates, or empty/None.
    When class hints are set: match those first (case-insensitive).
    When accept_any_new is True (default for launch without --wm-class): if the
    timeout elapses with unmatched new windows, return the first new one.
    While polling with no class hints, any new window wins immediately.

    LF5: when require_settled (default), do not return on mere class appear —
    wait until window_is_settled (TILE + id + reasonable rect). Unsettled hits
    are remembered; on timeout still return the hit so callers can try moves.

    CL9 layout deferred opens: require_settled=False waits for map + windowId
    only (FLOAT+hidden is ok); do not require TILE.
    """
    deadline = time.monotonic() + max(0, timeout_ms) / 1000.0
    baseline_ids = baseline_ids or set()
    last_err = "timeout"
    seen_classes: set[str] = set()
    class_list = _normalize_class_list(wm_class)
    last_fresh: list[dict[str, Any]] = []
    pending_unsettled: Optional[dict[str, Any]] = None

    def _chosen(pool: list[dict[str, Any]], matched_by: str) -> dict[str, Any]:
        c = pool[0]
        return {
            "ok": True,
            "windowId": c.get("windowId"),
            "title": c.get("title"),
            "wmClass": c.get("wmClass"),
            "path": c.get("path"),
            "mode": c.get("mode"),
            "matchedBy": matched_by,
            "settled": window_is_settled(c),
        }

    def _pick_settled_or_note(
        hits: list[dict[str, Any]], matched_by: str
    ) -> Optional[dict[str, Any]]:
        nonlocal pending_unsettled
        if not hits:
            return None
        if not require_settled:
            # CL9: map pin only — need windowId; mode may stay FLOAT while deferred.
            with_id = [
                w
                for w in hits
                if w.get("windowId") is not None and str(w.get("windowId")).strip() != ""
            ]
            if with_id:
                return _chosen(with_id, matched_by)
            # Appear without id yet — remember and keep polling.
            if pending_unsettled is None:
                pending_unsettled = _chosen(hits, matched_by)
                pending_unsettled["settled"] = False
            return None
        settled = [w for w in hits if window_is_settled(w)]
        if settled:
            return _chosen(settled, matched_by)
        # Remember first appear; keep polling for TILE / rect.
        if pending_unsettled is None:
            pending_unsettled = _chosen(hits, matched_by)
            pending_unsettled["settled"] = False
        return None

    while time.monotonic() <= deadline:
        try:
            raw = call_method(backend, "GetTree", "{}")
            data = json.loads(raw)
        except Exception as e:
            last_err = str(e)
            time.sleep(0.15)
            continue
        if isinstance(data, dict) and data.get("error"):
            last_err = str(data["error"])
            time.sleep(0.15)
            continue
        all_wins = _iter_tree_windows(data)
        fresh = [
            w
            for w in all_wins
            if w.get("windowId") is None or str(w.get("windowId")) not in baseline_ids
        ]
        for w in fresh:
            cls = w.get("wmClass") or w.get("wm_class")
            if cls:
                seen_classes.add(str(cls))
        if fresh:
            last_fresh = fresh

        if class_list:
            hits = [
                w
                for w in fresh
                if any(
                    _class_eq(w.get("wmClass") or w.get("wm_class"), want)
                    for want in class_list
                )
            ]
            # Also allow class match on pre-existing if no baseline (rare)
            if not hits and not baseline_ids:
                hits = _windows_matching_class(data, class_list)
            picked = _pick_settled_or_note(hits, "wm-class")
            if picked:
                return picked
        else:
            # No hints: first new window (optionally settled)
            picked = _pick_settled_or_note(fresh, "new-window")
            if picked:
                return picked

        # If we already have an id, re-check that leaf in the live tree for settle.
        if require_settled and pending_unsettled and pending_unsettled.get("windowId") is not None:
            wid = pending_unsettled["windowId"]
            live = find_settled_window(all_wins, window_id=wid)
            if live:
                out = _chosen([live], pending_unsettled.get("matchedBy") or "wm-class")
                out["settled"] = True
                return out

        time.sleep(0.12)

    # Class hints never matched — optionally take any new window that appeared
    if accept_any_new and last_fresh:
        picked = _pick_settled_or_note(last_fresh, "new-window")
        if picked:
            return picked
        # Unsettled new window is better than total failure for pin.
        if pending_unsettled:
            pending_unsettled["settleTimeout"] = True
            return pending_unsettled
        return _chosen(last_fresh, "new-window")

    # Appeared but never TILE within timeout: return unsettled so residual can still try.
    if pending_unsettled:
        pending_unsettled["settleTimeout"] = True
        pending_unsettled["ok"] = True
        return pending_unsettled

    out: dict[str, Any] = {
        "ok": False,
        "error": f"wait timeout after {timeout_ms}ms ({last_err})",
    }
    if len(class_list) == 1:
        out["wmClass"] = class_list[0]
    elif class_list:
        out["wmClassCandidates"] = class_list
    if seen_classes:
        out["seenClasses"] = sorted(seen_classes)
    return out


def wait_for_window_ids_settled(
    backend: str,
    window_ids: list[str] | set[str],
    timeout_ms: int = HARD_TIMEOUT_MS,
    *,
    call_started_mono: Optional[float] = None,
) -> dict[str, Any]:
    """
    Poll until every windowId is hard-ready (TILE+rect+mon) or hard timeout.

    LF5 / SE2: used before residual/belt Move and focus phase hard-ready.
    Default timeout HARD_TIMEOUT_MS (5s). Call clock from call_started_mono
    when the forge act that needs hard-ready was just issued.
    """
    t0 = call_started_mono if call_started_mono is not None else time.monotonic()
    last_err: Optional[str] = None

    def load_windows() -> list[dict[str, Any]]:
        nonlocal last_err
        raw = call_method(backend, "GetTree", "{}")
        data = json.loads(raw)
        if isinstance(data, dict) and data.get("error"):
            last_err = str(data["error"])
            raise RuntimeError(last_err)
        last_err = None
        return list(_iter_tree_windows(data))

    out = wait_until_hard_ready(
        load_windows,
        window_ids,
        timeout_ms=timeout_ms,
        call_started_mono=t0,
    )
    if not out.get("ok") and last_err and not out.get("error"):
        out["error"] = f"hard-ready timeout ({last_err})"
    return out


def _baseline_window_ids(backend: str) -> set[str]:
    try:
        raw = call_method(backend, "GetTree", "{}")
        data = json.loads(raw)
    except Exception:
        return set()
    if isinstance(data, dict) and data.get("error"):
        return set()
    ids: set[str] = set()
    for w in _iter_tree_windows(data):
        wid = w.get("windowId")
        if wid is not None:
            ids.add(str(wid))
    return ids


def cmd_get(backend: str, args: argparse.Namespace) -> int:
    key = (args.key or "").strip()
    if not key:
        _eprint("forge get: key required")
        return 1
    return _cmd_result(backend, "GetSetting", key, label="get")


def cmd_set(backend: str, args: argparse.Namespace) -> int:
    key = (args.key or "").strip()
    if not key:
        _eprint("forge set: key required")
        return 1
    # Join remaining tokens so `forge set key true` and `forge set key '["a"]'` work
    value = args.value
    if isinstance(value, list):
        value = " ".join(value)
    if value is None:
        _eprint("forge set: value required")
        return 1
    return _cmd_result(backend, "SetSetting", key, str(value), label="set")


def cmd_settings(backend: str, args: argparse.Namespace) -> int:
    action = (args.settings_action or "").strip().lower()
    name = (args.name or "").strip()
    if action not in ("save", "load"):
        _eprint("forge settings: action must be save or load")
        return 1
    if not name:
        _eprint(f"forge settings {action}: name required")
        return 1
    method = "SettingsSave" if action == "save" else "SettingsLoad"
    return _cmd_result(backend, method, name, label=f"settings {action}")


def _load_steps_payload(raw: str) -> Any:
    """Parse JSON steps payload (array or {steps,...})."""
    try:
        return json.loads(raw)
    except json.JSONDecodeError as e:
        raise ValueError(f"invalid JSON: {e}") from e


def _payload_has_cli_only(payload: Any) -> list[str]:
    """Return CLI-only op names found in a steps payload (if any)."""
    steps: list[Any]
    if isinstance(payload, list):
        steps = payload
    elif isinstance(payload, dict) and isinstance(payload.get("steps"), list):
        steps = payload["steps"]
    else:
        return []
    found: list[str] = []
    for s in steps:
        if not isinstance(s, dict):
            continue
        op = s.get("op") or s.get("action") or s.get("type")
        if op is None:
            continue
        name = str(op).strip().lower()
        if name in CLI_ONLY_STEP_OPS and name not in found:
            found.append(name)
    return found


def _layout_batch_call(backend: str, action: str) -> tuple[bool, dict[str, Any]]:
    """
    DBus LayoutBatch(begin|end|release-deferred|chrome-clear) for layout apply.

    begin: defer per-app open renderTree until end (or residual RunSteps commit).
    release-deferred / release / unhide: unhide CL8 deferred maps without ending
    the batch (CL9: before residual plan + RunSteps).
    end: batch depth 0 + deferred commit (does not clear apply chrome).
    chrome-clear: hide apply chrome after residual/belt/retry (or finally).
    Returns (ok, payload). ok=false when DBus/extension fails (caller may continue).
    """
    try:
        raw = call_method(backend, "LayoutBatch", str(action))
        data = json.loads(raw) if isinstance(raw, str) else raw
    except Exception as e:
        return False, {"ok": False, "error": str(e), "action": action}
    if not isinstance(data, dict):
        return False, {"ok": False, "error": "invalid LayoutBatch response", "raw": raw}
    if data.get("ok") is True:
        return True, data
    return False, data


def _layout_final_focus_reassert_ms() -> int:
    """
    Optional always-on second full focus pass delay (default 0 = off).

    Product path uses verify-once (mismatch only). Debug/compare:
    FORGE_LAYOUT_FINAL_FOCUS_REASSERT_MS=<ms>.
    """
    raw = os.environ.get("FORGE_LAYOUT_FINAL_FOCUS_REASSERT_MS", "").strip()
    if raw:
        try:
            return max(0, int(raw))
        except ValueError:
            return 0
    return max(0, int(FINAL_FOCUS_REASSERT_MS or 0))


def _layout_focus_wm_classes(
    forest: Any, focus_actions: Any
) -> list[str]:
    """wmClass values for focus action window ids (heuristic keys)."""
    if not isinstance(focus_actions, list) or not focus_actions:
        return []
    want: set[str] = set()
    for a in focus_actions:
        if not isinstance(a, dict):
            continue
        sel = a.get("selector")
        if sel is None:
            continue
        s = str(sel).strip()
        if s.startswith("id:"):
            wid = s[3:].strip()
            if wid:
                want.add(wid)
    if not want:
        return []
    return _layout_wm_classes_for_ids(forest, want)


def _layout_wm_classes_for_ids(forest: Any, window_ids: Any) -> list[str]:
    """Unique wmClass list for window ids (heuristic keys; no personal roles)."""
    want = {
        str(x).strip()
        for x in (window_ids or [])
        if x is not None and str(x).strip() != ""
    }
    if not want:
        return []
    classes: list[str] = []
    seen: set[str] = set()
    for w in _iter_tree_windows(forest):
        wid = w.get("windowId")
        if wid is None or str(wid) not in want:
            continue
        cls = w.get("wmClass") or w.get("wm_class")
        if cls is None or not str(cls).strip():
            continue
        c = str(cls).strip()
        key = c.casefold()
        if key not in seen:
            seen.add(key)
            classes.append(c)
    return classes


def _layout_soft_geom_pass(
    backend: str,
    window_ids: list[str],
    *,
    process_kind: str,
    apply_log: dict[str, Any],
    log_key: str,
    call_started_mono: Optional[float] = None,
) -> dict[str, Any]:
    """
    Soft geom barrier after hard-ready / move. Records to session store only.
    Flush is top-level (SE6).
    """
    ids = [str(x).strip() for x in window_ids if x is not None and str(x).strip()]
    if not ids:
        out = {"skipped": True, "reason": "no-window-ids"}
        apply_log[log_key] = out
        return out

    session = default_session()
    host = settle_resolve_host()
    t0 = call_started_mono if call_started_mono is not None else time.monotonic()

    def load_windows() -> list[dict[str, Any]]:
        raw = call_method(backend, "GetTree", "{}")
        data = json.loads(raw)
        if isinstance(data, dict) and data.get("error"):
            raise RuntimeError(str(data["error"]))
        return list(_iter_tree_windows(data))

    try:
        forest = _layout_load_tree(backend, None)
    except Exception:
        forest = None
    wm_classes = _layout_wm_classes_for_ids(forest, ids) if forest else []
    soft_ms = resolve_geom_soft_timeout_ms(
        session.store(),
        host=host,
        wm_classes=wm_classes,
        process_kind=process_kind,
    )
    # First-ever learning trial is up to 10s; post-move observe uses a short window.
    entries = (session.store().get("entries") or {}) if session.store() else {}
    classes_for_first = wm_classes or ["unknown"]
    if any(
        is_first_ever(entries.get(make_key(host, c, process_kind, "geom")))
        for c in classes_for_first
    ):
        soft_ms = min(int(soft_ms), int(GEOM_FIRST_EVER_OBSERVE_MS))
    soft = run_soft_geom_barrier(
        load_windows,
        ids,
        soft_timeout_ms=soft_ms,
        call_started_mono=t0,
    )
    for res in soft.get("residuals") or []:
        lat = res.get("latencyMs")
        for cls in wm_classes or ["unknown"]:
            session.record(
                host=host,
                wm_class=cls,
                process_kind=process_kind,
                residual_kind="geom",
                had_residual=True,
                latency_ms=lat,
            )
    if soft.get("softSettled") and not soft.get("residuals"):
        for cls in wm_classes or ["unknown"]:
            session.record(
                host=host,
                wm_class=cls,
                process_kind=process_kind,
                residual_kind="geom",
                had_residual=False,
            )
    out = {
        "softTimeoutMs": soft_ms,
        "classes": wm_classes,
        "host": host,
        "processKind": process_kind,
        "persist": "deferred",
        **{k: v for k, v in soft.items() if k not in ("softTimeoutMs",)},
    }
    apply_log[log_key] = out
    return out


def _layout_flush_settle_heuristics(apply_log: Optional[dict[str, Any]] = None) -> dict[str, Any]:
    """Top-level write of dirty settle heuristics (once per CLI layout apply)."""
    info = default_session().flush()
    if isinstance(apply_log, dict):
        apply_log["settleHeuristicsFlush"] = info
    return info


def _layout_plan_focus_actions(
    backend: str,
    data: dict[str, Any],
    *,
    clean: bool,
    keep_others: bool,
    safe: bool,
    workspace: int,
    role_pins: Optional[dict[str, Any]],
) -> tuple[Optional[dict[str, Any]], list[dict[str, Any]], Optional[dict[str, Any]]]:
    """
    Load forest + plan_reconcile → (plan, focus_actions, forest).
    On plan error: (None, [], None) and caller logs non-fatal.
    """
    forest = _layout_load_tree(backend, None)
    plan_f = plan_reconcile(
        forest,
        data,
        clean=clean,
        keep_others=keep_others,
        safe=safe,
        role_pins=role_pins or None,
        just_opened_roles=set(role_pins.keys()) if role_pins else None,
        workspace=workspace,
    )
    return plan_f, focus_actions_from_plan(plan_f.get("actions")), forest


def _layout_final_focus_pass(
    backend: str,
    data: dict[str, Any],
    *,
    clean: bool,
    keep_others: bool,
    safe: bool,
    workspace: int,
    role_pins: Optional[dict[str, Any]],
    force_close: bool,
    apply_log: dict[str, Any],
) -> tuple[int, Optional[dict[str, Any]]]:
    """
    Focus phase (D019): hard-ready → apply once → soft residual barrier →
    post-settled verify once.

    Soft barrier uses settle-heuristics timeouts; focus steal corrects immediately
    and resets quiet. Returns (rc, last plan) — rc non-zero only on hard RunSteps fail.
    """
    pin_ids = [
        str(w)
        for w in (role_pins or {}).values()
        if w is not None and str(w).strip() != ""
    ]
    settle: dict[str, Any] = {"skipped": True}
    if pin_ids:
        settle = wait_for_window_ids_settled(backend, pin_ids)
    apply_log["finalFocusSettle"] = settle

    quiet_s = max(0, FINAL_FOCUS_QUIET_MS) / 1000.0
    if quiet_s:
        time.sleep(quiet_s)

    last_plan: Optional[dict[str, Any]] = None
    try:
        plan_f, focus_acts, forest0 = _layout_plan_focus_actions(
            backend,
            data,
            clean=clean,
            keep_others=keep_others,
            safe=safe,
            workspace=workspace,
            role_pins=role_pins,
        )
    except Exception as e:
        apply_log["finalFocus"] = {"ok": False, "error": str(e)}
        return 0, last_plan
    last_plan = plan_f
    steps = actions_to_extension_steps(
        focus_acts, force_close=force_close, workspace=workspace
    )
    focus_t0 = time.monotonic()
    if not steps:
        apply_log["finalFocus"] = {"ok": True, "steps": 0, "skipped": True}
    else:
        rc, agg = run_mixed_steps(
            backend, steps, stop_on_error=True, print_each=False
        )
        apply_log["finalFocus"] = {"ok": rc == 0, "steps": len(steps), "agg": agg}
        if rc != 0:
            return rc, last_plan

    # Soft expectation barrier (SE3): learned quiet; steal → correct + reset.
    # Session store: load once, record in memory; flush at top-level layout end.
    session = default_session()
    host = settle_resolve_host()
    heuristics = session.store()
    wm_classes = _layout_focus_wm_classes(forest0, focus_acts)
    soft_ms = resolve_focus_soft_timeout_ms(
        heuristics, host=host, wm_classes=wm_classes
    )
    # Cold/partial open: learned floor (400ms) is too short for chrome late
    # activate; keep soft quiet ≥ COLD_FOCUS_SOFT_FLOOR_MS while pins exist.
    if pin_ids:
        soft_ms = max(int(soft_ms), int(COLD_FOCUS_SOFT_FLOOR_MS))
    apply_log["finalFocusSoftTimeoutMs"] = soft_ms
    soft_rc_holder: list[int] = [0]
    soft_state: dict[str, Any] = {"plan": last_plan}

    def _check_needed() -> list[dict[str, Any]]:
        plan_c, focus_c, forest_c = _layout_plan_focus_actions(
            backend,
            data,
            clean=clean,
            keep_others=keep_others,
            safe=safe,
            workspace=workspace,
            role_pins=role_pins,
        )
        soft_state["plan"] = plan_c
        return focus_actions_still_needed(forest_c, focus_c)

    def _apply_correct(needed: Any) -> None:
        s_steps = actions_to_extension_steps(
            needed, force_close=force_close, workspace=workspace
        )
        if not s_steps:
            return
        rc, agg = run_mixed_steps(
            backend, s_steps, stop_on_error=True, print_each=False
        )
        if rc != 0:
            soft_rc_holder[0] = rc
            soft_state["agg"] = agg
            raise RuntimeError(f"soft focus correct RunSteps rc={rc}")

    soft = run_soft_focus_barrier(
        _check_needed,
        _apply_correct,
        soft_timeout_ms=soft_ms,
        poll_ms=SOFT_FOCUS_POLL_MS,
        call_started_mono=focus_t0,
    )
    last_plan = soft_state.get("plan") or last_plan
    apply_log["finalFocusSoft"] = soft
    if soft_rc_holder[0] != 0:
        return soft_rc_holder[0], last_plan

    # In-memory residual samples; flush once at top-level layout end (SE6/SE7).
    for res in soft.get("residuals") or []:
        lat = res.get("latencyMs")
        for cls in wm_classes or ["unknown"]:
            session.record(
                host=host,
                wm_class=cls,
                process_kind="focus-phase",
                residual_kind="focus",
                had_residual=True,
                latency_ms=lat,
            )
    if soft.get("softSettled") and not soft.get("residuals"):
        for cls in wm_classes or ["unknown"]:
            session.record(
                host=host,
                wm_class=cls,
                process_kind="focus-phase",
                residual_kind="focus",
                had_residual=False,
            )
    apply_log["finalFocusHeuristics"] = {
        "host": host,
        "classes": wm_classes,
        "residualSamples": len(soft.get("residuals") or []),
        "persist": "deferred",
    }

    # Post-settled verify once (D019): one more mismatch check after soft settle.
    try:
        plan_v, focus_all, forest_v = _layout_plan_focus_actions(
            backend,
            data,
            clean=clean,
            keep_others=keep_others,
            safe=safe,
            workspace=workspace,
            role_pins=role_pins,
        )
    except Exception as e:
        apply_log["finalFocusVerify"] = {"ok": False, "error": str(e)}
        return 0, last_plan
    last_plan = plan_v
    needed = focus_actions_still_needed(forest_v, focus_all)
    if not needed:
        apply_log["finalFocusVerify"] = {
            "ok": True,
            "steps": 0,
            "skipped": True,
            "reason": "post-settled open-leaf/profile match",
        }
    else:
        v_steps = actions_to_extension_steps(
            needed, force_close=force_close, workspace=workspace
        )
        if not v_steps:
            apply_log["finalFocusVerify"] = {
                "ok": True,
                "steps": 0,
                "skipped": True,
                "needed": len(needed),
            }
        else:
            rc, agg = run_mixed_steps(
                backend, v_steps, stop_on_error=True, print_each=False
            )
            apply_log["finalFocusVerify"] = {
                "ok": rc == 0,
                "steps": len(v_steps),
                "neededRoles": [a.get("role") for a in needed if isinstance(a, dict)],
                "agg": agg,
            }
            if rc != 0:
                return rc, last_plan

    # Optional debug: always-on second full focus (not the product path).
    reassert_ms = _layout_final_focus_reassert_ms()
    if reassert_ms > 0:
        time.sleep(reassert_ms / 1000.0)
        try:
            plan_r, focus_r, _ = _layout_plan_focus_actions(
                backend,
                data,
                clean=clean,
                keep_others=keep_others,
                safe=safe,
                workspace=workspace,
                role_pins=role_pins,
            )
        except Exception as e:
            apply_log["finalFocusReassert"] = {"ok": False, "error": str(e)}
            return 0, last_plan
        last_plan = plan_r
        r_steps = actions_to_extension_steps(
            focus_r, force_close=force_close, workspace=workspace
        )
        if r_steps:
            rc, agg = run_mixed_steps(
                backend, r_steps, stop_on_error=True, print_each=False
            )
            apply_log["finalFocusReassert"] = {
                "ok": rc == 0,
                "steps": len(r_steps),
                "agg": agg,
            }
            if rc != 0:
                return rc, last_plan
        else:
            apply_log["finalFocusReassert"] = {"ok": True, "steps": 0, "skipped": True}
    else:
        apply_log["finalFocusReassert"] = {
            "skipped": True,
            "reason": "soft barrier + post-settled verify is product path",
        }

    return 0, last_plan


def cmd_run_steps(backend: str, args: argparse.Namespace) -> int:
    """
    DBus RunSteps: freeze → extension ops → unfreeze + one render.

    launch / wait-window / wait are CLI-only — rejected here.
    Mixed scripts: use `forge run` or `forge layout`.
    """
    raw: Optional[str] = None
    if getattr(args, "file", None):
        path = Path(args.file).expanduser()
        if not path.is_file():
            _eprint(f"forge run-steps: file not found: {path}")
            return 1
        try:
            raw = path.read_text(encoding="utf-8")
        except OSError as e:
            _eprint(f"forge run-steps: cannot read {path}: {e}")
            return 1
    elif getattr(args, "json_arg", None) is not None:
        raw = args.json_arg
    else:
        _eprint("forge run-steps: provide JSON string or --file PATH")
        return 1

    raw = (raw or "").strip()
    if not raw:
        _eprint("forge run-steps: empty payload")
        return 1

    try:
        payload = _load_steps_payload(raw)
    except ValueError as e:
        _eprint(f"forge run-steps: {e}")
        return 1

    cli_ops = _payload_has_cli_only(payload)
    if cli_ops:
        _eprint(
            "forge run-steps: launch/wait are CLI-only and not sent via DBus "
            f"(found: {', '.join(cli_ops)}). Use `forge run` / `forge layout` "
            "for mixed scripts, or `forge launch` then run-steps for tree ops."
        )
        return 1

    # Re-serialize so bare arrays and objects round-trip cleanly.
    steps_json = json.dumps(payload, separators=(",", ":"), ensure_ascii=False)
    return _cmd_result(backend, "RunSteps", steps_json, label="run-steps")


def do_launch(
    backend: str,
    *,
    app: str,
    wm_class: Optional[str] = None,
    timeout: Optional[int] = None,
    no_wait: bool = False,
    monitor: Any = None,
    tree_path: Optional[str] = None,
    attach_selector: Optional[str] = None,
    first: bool = False,
    title_contains: Optional[str] = None,
    title_exact: Optional[str] = None,
    print_result: bool = True,
    require_settled: bool = True,
) -> tuple[int, dict[str, Any]]:
    """Shared launch path for `forge launch` and layout/run launch steps.

    require_settled: LF5 default True (wait TILE). CL9 layout deferred opens use
    False (map + windowId only) when waiting serially; parallel path uses no_wait
    then wait_for_open_role_pins.
    """
    app = (app or "").strip().strip("'\"")
    if not app:
        out = {"ok": False, "error": "app required", "op": "launch"}
        if print_result:
            _eprint("forge launch: app required")
        return 1, out

    timeout_ms = int(timeout if timeout is not None else DEFAULT_LAUNCH_TIMEOUT_MS)
    desktop = resolve_desktop_file(app)
    # Rewritten multi-instance argv still needs desktop for StartupWMClass hints.
    if desktop is None and is_ghostty_launch_target(app):
        desktop = resolve_desktop_file("ghostty") or resolve_desktop_file(
            "com.mitchellh.ghostty"
        )
    explicit_class = (wm_class or "").strip() or None
    class_hints = infer_wm_class_hints(app, desktop)
    if not class_hints and is_ghostty_launch_target(app, desktop):
        class_hints = infer_wm_class_hints("ghostty", desktop)
    # Hints first (specific desktop / PWA), then profile sugar (Google-chrome).
    wait_classes = merge_launch_wait_classes(explicit_class, class_hints)
    place_class = prefer_launch_place_class(explicit_class, class_hints)

    place_opts: dict[str, Any] = {}
    if monitor is not None and str(monitor).strip() != "":
        place_opts["monitor"] = monitor
    if tree_path is not None and str(tree_path).strip() != "":
        place_opts["treePath"] = tree_path
    # Nested join (e.g. open nautilus under mon0.s1 ghostty) — PlaceNext attachSelector.
    attach = (attach_selector or "").strip() if attach_selector is not None else ""
    if attach:
        place_opts["attachSelector"] = attach
    if place_class:
        place_opts["wmClass"] = place_class
    tc = (title_contains or "").strip() if title_contains is not None else ""
    te = (title_exact or "").strip() if title_exact is not None else ""
    if tc:
        place_opts["titleContains"] = tc
    if te:
        place_opts["titleExact"] = te
    if first:
        place_opts["first"] = True
    if place_opts and (
        "monitor" in place_opts or "treePath" in place_opts or "attachSelector" in place_opts
    ):
        place_opts["ttlMs"] = max(timeout_ms, DEFAULT_LAUNCH_TIMEOUT_MS)

    if place_opts and (
        "monitor" in place_opts or "treePath" in place_opts or "attachSelector" in place_opts
    ):
        try:
            raw = call_method(backend, "PlaceNext", json.dumps(place_opts))
            data = json.loads(raw)
        except Exception as e:
            out = {"ok": False, "error": f"PlaceNext failed: {e}", "op": "launch", "app": app}
            if print_result:
                _eprint(f"forge launch: PlaceNext failed (is the extension enabled?): {e}")
            return 1, out
        if not isinstance(data, dict) or data.get("ok") is not True:
            err = data.get("error") if isinstance(data, dict) else raw
            out = {"ok": False, "error": f"PlaceNext error: {err}", "op": "launch", "app": app}
            if isinstance(data, dict):
                out["placeNext"] = data
            if print_result:
                _eprint(f"forge launch: PlaceNext error: {err}")
                if isinstance(data, dict):
                    _print_json(data, compact=False)
            return 1, out

    baseline: set[str] = set()
    if not no_wait:
        baseline = _baseline_window_ids(backend)

    try:
        proc = launch_app(app, desktop=desktop)
    except Exception as e:
        out = {"ok": False, "error": str(e), "op": "launch", "app": app}
        if print_result:
            _eprint(f"forge launch: failed to start {app!r}: {e}")
        return 1, out

    if no_wait:
        payload: dict[str, Any] = {
            "ok": True,
            "pid": proc.pid,
            "waited": False,
            "app": app,
            "op": "launch",
            # CL9 parallel open: caller waits for map pins with these classes.
            "waitClasses": wait_classes,
            "acceptAnyNew": wait_classes is None,
            "timeoutMs": timeout_ms,
        }
        if desktop:
            payload["desktop"] = desktop
        if class_hints:
            payload["wmClassCandidates"] = class_hints
        if print_result:
            _print_json(payload, compact=False)
        return 0, payload

    result = wait_for_wm_class(
        backend,
        wait_classes,
        timeout_ms,
        first=first,
        baseline_ids=baseline,
        # Any wait class (explicit or desktop hints) disables accept-any fallback.
        accept_any_new=wait_classes is None,
        require_settled=require_settled,
    )
    result = dict(result)
    result["op"] = "launch"
    result["pid"] = proc.pid
    result["waited"] = True
    result["app"] = app
    result["requireSettled"] = require_settled
    if desktop:
        result["desktop"] = desktop

    if not result.get("ok"):
        cands = wait_classes if wait_classes else class_hints
        if cands:
            result.setdefault("wmClassCandidates", cands)
        if print_result:
            _eprint(f"forge launch: {result.get('error', 'wait failed')}")
            _print_json(result, compact=False)
        return 1, result

    if print_result:
        _print_json(result, compact=False)
    return 0, result


def _run_cli_step(backend: str, step: dict[str, Any], *, print_result: bool = False) -> dict[str, Any]:
    """Execute one CLI-only step; return result dict with ok bool."""
    op_raw = step.get("op") or step.get("action") or step.get("type")
    op = str(op_raw).strip().lower() if op_raw is not None else ""

    if op == "launch":
        fields = launch_fields_from_step(step)
        _rc, result = do_launch(backend, print_result=print_result, **fields)
        return result

    if op == "wait":
        ms = step.get("ms") if "ms" in step else step.get("timeout", 0)
        try:
            n = max(0, int(ms))
        except (TypeError, ValueError):
            return {"ok": False, "op": "wait", "error": f"invalid ms: {ms!r}"}
        time.sleep(n / 1000.0)
        return {"ok": True, "op": "wait", "ms": n}

    if op == "wait-window":
        wc = step.get("wmClass") or step.get("wm_class")
        if wc is None or str(wc).strip() == "":
            return {"ok": False, "op": "wait-window", "error": "wmClass required"}
        timeout = step.get("timeout") if "timeout" in step else step.get("timeoutMs")
        timeout_ms = int(timeout if timeout is not None else DEFAULT_LAUNCH_TIMEOUT_MS)
        first = bool(step.get("first", False))
        result = wait_for_wm_class(
            backend,
            str(wc).strip(),
            timeout_ms,
            first=first,
            baseline_ids=None,
            accept_any_new=False,
        )
        result = dict(result)
        result["op"] = "wait-window"
        return result

    return {"ok": False, "op": op or None, "error": f"unknown CLI op: {op!r}"}


def run_mixed_steps(
    backend: str,
    steps: list[Any],
    *,
    stop_on_error: bool = True,
    print_each: bool = False,
) -> tuple[int, dict[str, Any]]:
    """
    Partition mixed steps; run CLI ops here, extension chunks via DBus RunSteps.
    Returns (exit_code, aggregate JSON).
    """
    chunks = partition_mixed_steps(steps)
    chunk_results: list[dict[str, Any]] = []
    all_ok = True
    step_index = 0

    for chunk in chunks:
        kind = chunk["kind"]
        csteps = chunk["steps"]
        if kind == "cli":
            cli_out: list[dict[str, Any]] = []
            for step in csteps:
                if not isinstance(step, dict):
                    r = {"ok": False, "error": "step must be an object", "index": step_index}
                    cli_out.append(r)
                    all_ok = False
                    if stop_on_error:
                        chunk_results.append({"kind": "cli", "ok": False, "results": cli_out})
                        return 1, {
                            "ok": False,
                            "stoppedAt": step_index,
                            "chunks": chunk_results,
                        }
                    step_index += 1
                    continue
                r = _run_cli_step(backend, step, print_result=print_each)
                r = dict(r)
                r.setdefault("index", step_index)
                cli_out.append(r)
                if not r.get("ok"):
                    all_ok = False
                    if stop_on_error:
                        chunk_results.append({"kind": "cli", "ok": False, "results": cli_out})
                        return 1, {
                            "ok": False,
                            "stoppedAt": step_index,
                            "chunks": chunk_results,
                        }
                step_index += 1
            chunk_results.append(
                {"kind": "cli", "ok": all(x.get("ok") for x in cli_out), "results": cli_out}
            )
        else:
            payload = {"steps": csteps, "stopOnError": stop_on_error}
            steps_json = json.dumps(payload, separators=(",", ":"), ensure_ascii=False)
            try:
                raw = call_method(backend, "RunSteps", steps_json)
                data = json.loads(raw)
            except Exception as e:
                all_ok = False
                chunk_results.append(
                    {
                        "kind": "extension",
                        "ok": False,
                        "error": str(e),
                        "stepIndexBase": step_index,
                    }
                )
                if stop_on_error:
                    return 1, {
                        "ok": False,
                        "stoppedAt": step_index,
                        "chunks": chunk_results,
                    }
                step_index += len(csteps)
                continue

            if not isinstance(data, dict):
                data = {"ok": False, "error": "invalid RunSteps response", "raw": raw}
            # Rebase indices for aggregate readability
            ext_results = data.get("results")
            if isinstance(ext_results, list):
                for er in ext_results:
                    if isinstance(er, dict) and isinstance(er.get("index"), int):
                        er["index"] = step_index + int(er["index"])
            ok = bool(data.get("ok"))
            if not ok:
                all_ok = False
            entry: dict[str, Any] = {
                "kind": "extension",
                "ok": ok,
                "results": ext_results if isinstance(ext_results, list) else [],
            }
            if "stoppedAt" in data and data["stoppedAt"] is not None:
                try:
                    entry["stoppedAt"] = step_index + int(data["stoppedAt"])
                except (TypeError, ValueError):
                    entry["stoppedAt"] = data["stoppedAt"]
            if data.get("error"):
                entry["error"] = data["error"]
            chunk_results.append(entry)
            if not ok and stop_on_error:
                stopped = entry.get("stoppedAt", step_index)
                return 1, {"ok": False, "stoppedAt": stopped, "chunks": chunk_results}
            step_index += len(csteps)

    return (0 if all_ok else 1), {"ok": all_ok, "chunks": chunk_results}


def _load_gdisplays(scene: str) -> int:
    """Shell out to gdisplays load <scene>. Exit ≠0 + install hint if missing."""
    if not shutil.which("gdisplays"):
        _eprint("forge layout: `gdisplays` not found (needed for profile displays)")
        _eprint("Install: install-gdisplays  (shellrc) or ensure gdisplays is on PATH")
        # fallback hint for distros without shellrc
        _eprint("# fallback: ensure shellrc bin or your gdisplays package is installed")
        return 127
    cmd = ["gdisplays", "load", scene]
    _eprint(f"forge layout: {' '.join(shlex.quote(c) for c in cmd)}")
    try:
        proc = subprocess.run(cmd, check=False)
    except OSError as e:
        _eprint(f"forge layout: gdisplays failed: {e}")
        return 1
    if proc.returncode != 0:
        _eprint(f"forge layout: gdisplays load {scene!r} exit {proc.returncode}")
    return int(proc.returncode)


def _layout_parse_tokens(
    tokens: list[str], args: argparse.Namespace
) -> tuple[str, Optional[str], list[str], bool, bool, bool, bool]:
    """
    Parse layout positional tokens + flags.

    Returns
      (action, name, run_tokens, dry_run, force_launch, clean, force_close).
    action: list | show | run | help | save
    name: set for show/save; None for run (use run_tokens).
    run_tokens: raw layout targets for action=run (bare and/or N:name / name@N).
    """
    dry_run = bool(getattr(args, "dry_run", False))
    force_launch = bool(getattr(args, "force_launch", False))
    clean = bool(getattr(args, "clean", False))
    force_close = bool(getattr(args, "force", False))
    if not tokens:
        return "help", None, [], dry_run, force_launch, clean, force_close

    head = tokens[0].strip()
    if head in ("help", "-h", "--help"):
        return "help", None, [], dry_run, force_launch, clean, force_close
    if head == "list":
        return "list", None, [], dry_run, force_launch, clean, force_close
    if head == "show":
        name = tokens[1].strip() if len(tokens) >= 2 else None
        return "show", name, [], dry_run, force_launch, clean, force_close
    if head == "save":
        name = tokens[1].strip() if len(tokens) >= 2 else None
        return "save", name, [], dry_run, force_launch, clean, force_close
    # Apply targets: remaining positionals (exclusive sequential XOR static).
    return "run", None, list(tokens), dry_run, force_launch, clean, force_close


def _layout_load_tree(
    backend: Optional[str], tree_file: Optional[str]
) -> dict[str, Any]:
    if tree_file:
        p = Path(tree_file).expanduser()
        if not p.is_file():
            raise FileNotFoundError(f"tree file not found: {p}")
        data = json.loads(p.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            raise ValueError("tree file must be a JSON object (GetTree forest)")
        return data
    if backend is None:
        raise RuntimeError("DBus backend required (or pass --tree-file)")
    raw = call_method(backend, "GetTree", "{}")
    data = json.loads(raw)
    if not isinstance(data, dict):
        raise ValueError("GetTree returned non-object")
    if data.get("error"):
        raise RuntimeError(str(data["error"]))
    return data


def _layout_target_workspace(forest: dict[str, Any]) -> int:
    """
    0-based workspace for layout apply/save.

    Live GetTree sets activeWorkspace. Offline --tree-file without meta → 0.
    """
    return active_workspace_from_forest(forest, default=0)


def _layout_print_header(
    resolved: dict[str, Any],
    name: str,
    *,
    description: Optional[str] = None,
) -> None:
    """Consistent human header: host, profile, source, short path [, description]."""
    path = resolved.get("path")
    short = format_short_path(path) if path else ""
    _eprint(
        f"forge layout: host={resolved.get('host')} profile={name} "
        f"source={resolved.get('source')}"
        + (f" path={short}" if short else "")
    )
    if isinstance(description, str) and description.strip():
        _eprint(f"  {description.strip()}")


def _layout_display_description(data: Any, profile: Optional[dict[str, Any]] = None) -> str:
    """Stored description if non-empty; else auto one-liner from layout IR/sugar."""
    if isinstance(profile, dict):
        desc = profile.get("description")
        if isinstance(desc, str) and desc.strip():
            return desc.strip()
    if isinstance(data, dict):
        desc = data.get("description")
        if isinstance(desc, str) and desc.strip():
            return desc.strip()
    try:
        return format_layout_description(data if data is not None else profile) or ""
    except (ValueError, TypeError):
        return ""


def _layout_print_counts(counts: dict[str, Any]) -> None:
    struct = counts.get("structure", 0)
    struct_bit = f"   structure  {struct}" if struct else ""
    kept = counts.get("kept", 0)
    kept_bit = f"   kept  {kept}" if kept else ""
    left = counts.get("left", 0)
    left_bit = f"   left  {left}" if left else ""
    closed = counts.get("closed", 0)
    closed_bit = f"   closed  {closed}" if closed else ""
    parked = counts.get("parked", 0)
    parked_bit = f"   parked  {parked}" if parked else ""
    _eprint(
        f"  reused  {counts.get('reused', 0)}   "
        f"opened  {counts.get('opened', 0)}   "
        f"moved  {counts.get('moved', 0)}"
        f"{parked_bit}"
        f"{kept_bit}"
        f"{left_bit}"
        f"{closed_bit}"
        f"{struct_bit}"
    )


def _layout_print_thrash_mode(plan: dict[str, Any], *, safe: bool = False) -> None:
    """Human Mode A/B line from thrashState (always on reconcile dry-run/apply)."""
    state = plan.get("thrashState")
    thrashed = isinstance(state, dict) and bool(state.get("thrashed"))
    label = "B thrash-recover" if thrashed else "A collect"
    safe_bit = "  safe=true (open+move only)" if safe else ""
    _eprint(f"  mode={label}{safe_bit}")


def _layout_print_thrash_state(plan: dict[str, Any]) -> None:
    """One thrashState line when desk is thrashed."""
    state = plan.get("thrashState")
    if not isinstance(state, dict) or not state.get("thrashed"):
        return
    score = int(state.get("score") or 0)
    reasons = state.get("reasons") or []
    reasons_bit = f" reasons={','.join(str(r) for r in reasons[:4])}" if reasons else ""
    _eprint(f"  thrashState  thrashed score={score}{reasons_bit}")


def _layout_print_thrash_risk(plan: dict[str, Any]) -> None:
    risk = plan.get("thrashRisk")
    if not isinstance(risk, dict):
        return
    score = int(risk.get("score") or 0)
    if score <= 0:
        return
    reasons = risk.get("reasons") or []
    hint = f" ({', '.join(str(r) for r in reasons[:4])})" if reasons else ""
    _eprint(f"  thrashRisk  {score}{hint}")


def _layout_plan_meta(
    resolved: dict[str, Any],
    name: str,
    plan: dict[str, Any],
    *,
    dry_run: bool,
) -> dict[str, Any]:
    out = dict(plan)
    out["name"] = name
    out["path"] = str(resolved.get("path") or "")
    out["source"] = resolved.get("source")
    out["host"] = resolved.get("host")
    out["dryRun"] = dry_run
    out["mode"] = MODE_RECONCILE
    return out


def _layout_optional_preamble(
    backend: Optional[str],
    profile: dict[str, Any],
    *,
    dry_run: bool,
) -> int:
    """displays + settings. Skip mutations on dry-run."""
    if dry_run:
        return 0
    if profile.get("displays"):
        rc = _load_gdisplays(str(profile["displays"]))
        if rc != 0:
            return rc
    if profile.get("settings"):
        if backend is None:
            backend = _check_deps()
        try:
            raw = call_method(backend, "SettingsLoad", str(profile["settings"]))
            data = json.loads(raw)
        except Exception as e:
            _eprint(f"forge layout: SettingsLoad failed: {e}")
            return 1
        if not isinstance(data, dict) or data.get("ok") is not True:
            err = data.get("error") if isinstance(data, dict) else raw
            _eprint(f"forge layout: SettingsLoad error: {err}")
            if isinstance(data, dict):
                _print_json(data, compact=False)
            return 1
    return 0


def _layout_is_verbose(args: argparse.Namespace) -> bool:
    return bool(
        getattr(args, "verbose", False) or os.environ.get("FORGE_VERBOSE") == "1"
    )


def _layout_maybe_print_json(data: Any, *, verbose: bool, force: bool = False) -> None:
    """Stdout plan/apply JSON only when verbose, dry-run, or error (force)."""
    if verbose or force:
        _print_json(data, compact=False)


def _layout_run_steps(
    backend: Optional[str],
    resolved: dict[str, Any],
    data: dict[str, Any],
    *,
    dry_run: bool,
    force_launch: bool,
    verbose: bool = False,
) -> int:
    name = resolved["name"]
    path = resolved["path"]
    try:
        # mode: steps / --force-launch may select steps on dual v2 profiles;
        # validate_profile is v1-only — normalize version, keep steps[] body.
        data_v1 = dict(data)
        data_v1["version"] = 1
        if not isinstance(data_v1.get("steps"), list):
            raise ValueError("steps path requires steps[] array")
        profile = validate_profile(data_v1)
    except ValueError as e:
        _eprint(f"forge layout: {e}")
        return 1

    if dry_run:
        _layout_print_header(resolved, name)
        _eprint(
            f"  mode=steps steps={len(profile.get('steps') or [])}"
            f"{' force-launch' if force_launch else ''} (dry-run, no changes)"
        )
        _layout_maybe_print_json(
            {
                "ok": True,
                "dryRun": True,
                "mode": MODE_STEPS,
                "name": name,
                "path": str(path),
                "source": resolved.get("source"),
                "host": resolved.get("host"),
                "steps": profile.get("steps") or [],
                "stopOnError": bool(profile.get("stopOnError", True)),
            },
            verbose=verbose,
            force=True,
        )
        return 0

    _layout_print_header(resolved, name)
    stop_on_error = bool(profile.get("stopOnError", True))
    rc = _layout_optional_preamble(backend, profile, dry_run=False)
    if rc != 0:
        return rc

    steps = profile.get("steps") or []
    if not steps:
        _eprint("  mode=steps steps=0")
        _layout_maybe_print_json(
            {
                "ok": True,
                "profile": name,
                "path": str(path),
                "source": resolved.get("source"),
                "host": resolved.get("host"),
                "mode": MODE_STEPS,
                "chunks": [],
            },
            verbose=verbose,
        )
        return 0

    if backend is None:
        backend = _check_deps()

    _eprint(
        f"  mode=steps steps={len(steps)}"
        f"{' force-launch' if force_launch else ''}"
    )
    rc, aggregate = run_mixed_steps(
        backend, steps, stop_on_error=stop_on_error, print_each=False
    )
    aggregate["profile"] = name
    aggregate["name"] = name
    aggregate["path"] = str(path)
    aggregate["source"] = resolved.get("source")
    aggregate["host"] = resolved.get("host")
    aggregate["mode"] = MODE_STEPS
    aggregate["dryRun"] = False
    if rc == 0:
        _eprint("  ok")
    # Always dump on failure; success only when verbose
    _layout_maybe_print_json(aggregate, verbose=verbose, force=rc != 0)
    return rc


def _layout_run_reconcile(
    backend: Optional[str],
    resolved: dict[str, Any],
    data: dict[str, Any],
    *,
    dry_run: bool,
    tree_file: Optional[str],
    clean: bool = True,
    keep_others: bool = False,
    force_close: bool = False,
    safe: bool = False,
    verbose: bool = False,
    workspace: Optional[int] = None,
    forest: Optional[dict[str, Any]] = None,
    wait_tree_stable: bool = False,
) -> int:
    """
    Plan/apply one reconcile profile on a target workspace.

    workspace: 0-based Meta index; None → activeWorkspace from forest (WS1).
    forest: reuse a loaded GetTree (multi-target); else load via tree_file/bus.
    wait_tree_stable: optional LF6 GetTree fingerprint quiet (debug; default off).
    """
    name = resolved["name"]
    # Early validate for preamble / shape errors. Final IR uses mon_count from
    # GetTree inside plan_reconcile (bare tab|split must not become dual mon).
    try:
        profile = validate_reconcile_profile(data)
    except ValueError as e:
        _eprint(f"forge layout: {e}")
        return 1

    rc = _layout_optional_preamble(backend, profile, dry_run=dry_run)
    if rc != 0:
        return rc

    if forest is None:
        needs_bus = not tree_file
        if needs_bus and backend is None:
            backend = _check_deps()
        try:
            forest = _layout_load_tree(backend, tree_file)
        except Exception as e:
            _eprint(f"forge layout: GetTree failed: {e}")
            return 1

    # WS1/WS2: explicit target or current desk from forest meta.
    if workspace is None:
        workspace = _layout_target_workspace(forest)
    current_ws = _layout_target_workspace(forest)

    try:
        # Pass raw sugar so mon_count can re-desugar; pre-validated IR loses tiles.
        plan = plan_reconcile(
            forest,
            data,
            clean=clean,
            keep_others=keep_others,
            safe=safe,
            workspace=workspace,
        )
    except ValueError as e:
        _eprint(f"forge layout: plan failed: {e}")
        return 1

    _layout_print_header(resolved, name)
    # Human 1-based index; plan/tree use 0-based Meta.
    cur_bit = " (current)" if workspace == current_ws else ""
    _eprint(f"  workspace  {workspace + 1}{cur_bit}")
    if dry_run:
        on_n, ignored = window_candidate_counts(forest, workspace)
        _eprint(
            "  "
            + format_candidate_line(
                workspace + 1,
                on_n,
                ignored,
                is_current=workspace == current_ws,
            )
        )
    _layout_print_thrash_mode(plan, safe=safe)
    if safe:
        _eprint("  residuals=leave (--safe: open+move only)")
    elif keep_others:
        _eprint("  residuals=park (--keep-others: join last mon unit as tabs)")
    else:
        force_bit = " --force" if force_close else ""
        _eprint(f"  residuals=close{force_bit} (default; non-layout windows closed)")
    counts = plan.get("counts") or {}
    _layout_print_counts(counts)
    _layout_print_thrash_state(plan)
    _layout_print_thrash_risk(plan)

    if plan.get("nothingToDo"):
        n = int(counts.get("reused") or 0)
        left_n = int(counts.get("left") or 0)
        left_bit = f", {left_n} residual left in place" if left_n else ""
        _eprint(f"forge layout: nothing to do ({n} roles satisfied{left_bit})")
        _layout_maybe_print_json(
            _layout_plan_meta(resolved, name, plan, dry_run=dry_run),
            verbose=verbose,
        )
        return 0

    if dry_run:
        _eprint("  dry-run (no changes)")
        _layout_maybe_print_json(
            _layout_plan_meta(resolved, name, plan, dry_run=True),
            verbose=verbose,
            force=True,
        )
        return 0

    if backend is None:
        backend = _check_deps()

    ext_actions, open_actions = partition_plan_actions(plan.get("actions"))
    apply_log: dict[str, Any] = {
        "extension": None,
        "opens": [],
        "followUp": None,
    }
    # Settle heuristics: load-on-first-use; flush once when this apply exits.
    try:
        return _layout_run_reconcile_apply(
            backend,
            resolved,
            data,
            plan=plan,
            name=name,
            ext_actions=ext_actions,
            open_actions=open_actions,
            apply_log=apply_log,
            clean=clean,
            keep_others=keep_others,
            force_close=force_close,
            safe=safe,
            verbose=verbose,
            workspace=workspace,
            wait_tree_stable=wait_tree_stable,
        )
    finally:
        _layout_flush_settle_heuristics(apply_log)


def _layout_run_reconcile_apply(
    backend: str,
    resolved: dict[str, Any],
    data: dict[str, Any],
    *,
    plan: dict[str, Any],
    name: str,
    ext_actions: list,
    open_actions: list,
    apply_log: dict[str, Any],
    clean: bool,
    keep_others: bool,
    force_close: bool,
    safe: bool,
    verbose: bool,
    workspace: int,
    wait_tree_stable: bool,
) -> int:
    """Apply half of reconcile (heuristics flush owned by caller)."""

    # 1) Moves / parks / closes / ensure_layout for existing windows.
    # Always strip focus from structure batches: open-leaf + profile keyboard
    # focus is a post-settle phase (soft residual barrier). Mid-session no-open
    # re-runs used to focus here without soft barrier → kbd thrash after actives.
    structure_for_pre = without_focus_actions(ext_actions)
    ext_steps = actions_to_extension_steps(
        structure_for_pre, force_close=force_close, workspace=workspace
    )
    if ext_steps:
        rc, agg = run_mixed_steps(
            backend, ext_steps, stop_on_error=True, print_each=False
        )
        apply_log["extension"] = agg
        if rc != 0:
            _eprint("forge layout: extension steps failed")
            out = _layout_plan_meta(resolved, name, plan, dry_run=False)
            out["ok"] = False
            out["apply"] = apply_log
            _layout_maybe_print_json(out, verbose=verbose, force=True)
            return rc

    # 2–3) Opens under LayoutBatch (CL5/CL9): no per-app mid-batch renderTree.
    # Flow: begin → parallel PlaceNext+launch all → map-pin wait → optional
    # fingerprint quiet (--wait-tree-stable) → release-deferred → end batch →
    # residual RunSteps (bind/place/structure) → chrome-clear. Apply chrome
    # stays through residual: cold bind + structure is the long visual phase
    # (clearing at batch end made the dim drop mid-thrash on Wayland cold).
    # Batch must still end before residual so mon moves stick; chrome is
    # independent of batch depth. Finally clears chrome if still up.
    # Do not abort mid-loop: residual rehome still needs successful pins.
    role_pins: dict[str, Any] = {}
    open_failures: list[Any] = []
    chrome_clear_needed = False
    if open_actions:
        begin_action = f"begin:{name}" if name else "begin"
        batch_ok, batch_begin = _layout_batch_call(backend, begin_action)
        apply_log["layoutBatchBegin"] = batch_begin
        if not batch_ok:
            _eprint(
                "forge layout: LayoutBatch begin failed "
                f"(continuing without batch: {batch_begin.get('error')})"
            )
        else:
            chrome_clear_needed = True

        try:
            # CL9: one baseline before all spawns; PlaceNext+launch without
            # serial TILE-wait; then map/windowId pin wait for every role.
            open_baseline = _baseline_window_ids(backend)
            pending_pins: list[dict[str, Any]] = []
            open_timeout_ms = DEFAULT_LAUNCH_TIMEOUT_MS

            for oa in open_actions:
                fields = open_action_to_launch_fields(oa, workspace=workspace)
                role = oa.get("role")
                # Parallel: never block on TILE settle per role.
                fields = dict(fields)
                fields["no_wait"] = True
                _rc, result = do_launch(backend, print_result=False, **fields)
                entry = dict(result)
                if role is not None:
                    entry["role"] = role
                entry["parallel"] = True
                apply_log["opens"].append(entry)
                if not result.get("ok"):
                    open_failures.append(role if role is not None else entry.get("error"))
                    _eprint(
                        f"forge layout: open spawn failed role={role!r}: "
                        f"{result.get('error', 'unknown')}"
                    )
                    continue
                if role is None or str(role).strip() == "":
                    continue
                wait_classes = result.get("waitClasses")
                accept_any = bool(result.get("acceptAnyNew", wait_classes is None))
                try:
                    t_ms = int(result.get("timeoutMs") or fields.get("timeout") or open_timeout_ms)
                except (TypeError, ValueError):
                    t_ms = open_timeout_ms
                open_timeout_ms = max(open_timeout_ms, t_ms)
                pin_entry: dict[str, Any] = {
                    "role": str(role),
                    "wait_classes": wait_classes,
                    "accept_any_new": accept_any,
                }
                # Title identity from plan match (Chrome multi-open on X11).
                oa_match = oa.get("match") if isinstance(oa.get("match"), dict) else {}
                title_sub = oa_match.get("title~=")
                title_exact = oa_match.get("title")
                if title_sub is not None and str(title_sub).strip() != "":
                    pin_entry["title_contains"] = str(title_sub).strip()
                if title_exact is not None and str(title_exact).strip() != "":
                    pin_entry["title_exact"] = str(title_exact).strip()
                pending_pins.append(pin_entry)

            def _load_live_forest() -> dict[str, Any]:
                return _layout_load_tree(backend, None)

            def _load_live_windows() -> list[dict[str, Any]]:
                return _iter_tree_windows(_load_live_forest())

            if pending_pins:
                pin_wait = wait_for_open_role_pins(
                    _load_live_windows,
                    pending_pins,
                    baseline_ids=open_baseline,
                    timeout_ms=open_timeout_ms,
                    class_eq=_class_eq,
                )
                apply_log["openMapWait"] = {
                    k: v for k, v in pin_wait.items() if k != "role_pins"
                }
                for rid, wid in (pin_wait.get("role_pins") or {}).items():
                    role_pins[str(rid)] = wid
                    # Annotate matching open log entry with pin.
                    for entry in apply_log["opens"]:
                        if (
                            isinstance(entry, dict)
                            and str(entry.get("role")) == str(rid)
                            and entry.get("windowId") is None
                        ):
                            entry["windowId"] = wid
                            entry["waited"] = True
                            entry["requireSettled"] = False
                            entry["matchedBy"] = "map-pin"
                            break
                for miss in pin_wait.get("missing") or []:
                    open_failures.append(miss)
                    _eprint(
                        f"forge layout: open map wait failed role={miss!r}: "
                        f"{pin_wait.get('error', 'timeout')}"
                    )

            # Optional LF6 batch quiet (debug): whole GetTree fingerprint holds
            # N samples. Default off — tree owns slots; map-pin wait is enough.
            stable_info: dict[str, Any] = {"skipped": True}
            if wait_tree_stable:
                stable_info = wait_for_tree_stable(
                    _load_live_forest,
                    timeout_ms=TREE_STABLE_TIMEOUT_MS,
                    poll_ms=TREE_STABLE_POLL_MS,
                    stable_samples=TREE_STABLE_SAMPLES,
                )
                apply_log["treeStable"] = {
                    k: v for k, v in stable_info.items() if k != "forest"
                }
                if not stable_info.get("ok"):
                    _eprint(
                        "forge layout: tree not fully stable after opens "
                        f"(proceeding: {stable_info.get('error')})"
                    )
            else:
                apply_log["treeStable"] = {"skipped": True}

            # CL9: unhide deferred FLOAT maps before residual structure apply.
            # Then end the open batch before residual place. Keeping depth>0
            # through residual made cross-mon chrome moves report ok but not
            # stick (Mode B thrash-recover without batch works). Batch only
            # needs to suppress mid-open render flood through map-pin wait.
            if batch_ok:
                rel_ok, rel_payload = _layout_batch_call(backend, "release-deferred")
                apply_log["layoutBatchRelease"] = rel_payload
                if not rel_ok:
                    _eprint(
                        "forge layout: LayoutBatch release-deferred failed "
                        f"(continuing: {rel_payload.get('error')})"
                    )
                end_ok, end_payload = _layout_batch_call(backend, "end")
                apply_log["layoutBatchEnd"] = end_payload
                if not end_ok:
                    _eprint(
                        "forge layout: LayoutBatch end before residual failed: "
                        f"{end_payload.get('error')}"
                    )
                batch_ok = False  # finally: skip second end
                # Keep apply chrome through residual bind/place/structure.
                # chrome-clear runs in finally after residual/belt (or on error).

            try:
                # Prefer post-release GetTree so residual sees unhide modes,
                # not a stale pre-release FLOAT snapshot from wait_for_tree_stable.
                try:
                    forest2 = _load_live_forest()
                except Exception:
                    forest2 = stable_info.get("forest")
                if not isinstance(forest2, dict):
                    forest2 = stable_info.get("forest")
                if not isinstance(forest2, dict):
                    forest2 = _load_live_forest()
                plan2 = plan_reconcile(
                    forest2,
                    data,
                    clean=clean,
                    keep_others=keep_others,
                    safe=safe,
                    role_pins=role_pins or None,
                    just_opened_roles=set(role_pins.keys()) if role_pins else None,
                    workspace=workspace,
                )
            except Exception as e:
                _eprint(f"forge layout: re-plan after open failed: {e}")
                out = _layout_plan_meta(resolved, name, plan, dry_run=False)
                out["ok"] = False
                out["error"] = str(e)
                out["apply"] = apply_log
                _layout_maybe_print_json(out, verbose=verbose, force=True)
                return 1
            residual_ext, residual_open = partition_plan_actions(plan2.get("actions"))
            # Structure/bind only here — no early focus (chrome late-activate steals
            # lastTabFocus). Final focus pass after residual+belt settles.
            residual_structure = without_focus_actions(residual_ext)
            follow_steps, still_open = residual_follow_up(
                residual_structure,
                residual_open,
                force_close=force_close,
                workspace=workspace,
            )
            if still_open:
                _eprint(f"forge layout: still missing roles after open: {still_open}")
            # Split place vs structure: mon moves must stick before ensure_layout
            # (Wayland partial reopen left mon1 flat when same-batch TABBED ran
            # against pre-move mon0 paths).
            place_steps, _struct_from_plan2 = (
                partition_extension_steps_place_vs_structure(follow_steps)
            )
            if place_steps or follow_steps:
                # After release-deferred, extension processFloats → TILE. Wait
                # longer than LF5 default so structure ops see TILE not FLOAT.
                settle_ids = move_step_window_ids(place_steps or follow_steps)
                for _role, pin_wid in (role_pins or {}).items():
                    if pin_wid is not None and str(pin_wid) not in settle_ids:
                        settle_ids.append(str(pin_wid))
                if settle_ids:
                    settle_info = wait_for_window_ids_settled(backend, settle_ids)
                    apply_log["followUpSettle"] = settle_info
                    if settle_info.get("pending"):
                        _eprint(
                            "forge layout: residual targets not hard-ready: "
                            f"{settle_info['pending']} (moving anyway)"
                        )
                move_t0 = time.monotonic()
                if place_steps:
                    rc, agg = run_mixed_steps(
                        backend, place_steps, stop_on_error=True, print_each=False
                    )
                    apply_log["followUp"] = agg
                    if rc != 0:
                        _eprint("forge layout: follow-up place steps failed")
                        out = _layout_plan_meta(resolved, name, plan2, dry_run=False)
                        out["ok"] = False
                        out["apply"] = apply_log
                        if still_open:
                            out["error"] = (
                                f"follow-up failed; roles still missing after launch: "
                                f"{still_open}"
                            )
                        _layout_maybe_print_json(out, verbose=verbose, force=True)
                        return rc
                    # SE6: soft geom quiet after residual moves (learn + wait).
                    geom_ids = move_step_window_ids(place_steps)
                    if geom_ids:
                        _layout_soft_geom_pass(
                            backend,
                            geom_ids,
                            process_kind="move",
                            apply_log=apply_log,
                            log_key="followUpGeomSoft",
                            call_started_mono=move_t0,
                        )
                else:
                    apply_log["followUp"] = {"ok": True, "skipped": True, "reason": "no place"}

                # Structure replan from post-place forest (fresh mon paths).
                try:
                    forest_struct = _load_live_forest()
                    plan_struct = plan_reconcile(
                        forest_struct,
                        data,
                        clean=clean,
                        keep_others=keep_others,
                        safe=safe,
                        role_pins=role_pins or None,
                        just_opened_roles=(
                            set(role_pins.keys()) if role_pins else None
                        ),
                        workspace=workspace,
                    )
                except Exception as e:
                    _eprint(f"forge layout: structure re-plan after place failed: {e}")
                    plan_struct = plan2
                struct_ext, _struct_open = partition_plan_actions(
                    plan_struct.get("actions")
                )
                # Full residual sans focus from post-place forest. May still need
                # moves when opens landed on the wrong mon (plan2 moved=0) — do
                # not drop place ops. Split place→structure again so mon sticks
                # before ensure_layout.
                struct_structure = without_focus_actions(struct_ext)
                struct_follow, _ = residual_follow_up(
                    struct_structure,
                    [],
                    force_close=force_close,
                    workspace=workspace,
                )
                place2, struct2 = partition_extension_steps_place_vs_structure(
                    struct_follow
                )
                if place2:
                    settle2_ids = move_step_window_ids(place2)
                    if settle2_ids:
                        apply_log["followUpPlace2Settle"] = (
                            wait_for_window_ids_settled(backend, settle2_ids)
                        )
                    rc_p2, agg_p2 = run_mixed_steps(
                        backend, place2, stop_on_error=True, print_each=False
                    )
                    apply_log["followUpPlace2"] = agg_p2
                    if rc_p2 != 0:
                        _eprint("forge layout: follow-up place2 steps failed")
                        out = _layout_plan_meta(
                            resolved, name, plan_struct, dry_run=False
                        )
                        out["ok"] = False
                        out["apply"] = apply_log
                        _layout_maybe_print_json(out, verbose=verbose, force=True)
                        return rc_p2
                    # Fresh structure plan after late mon rehome.
                    try:
                        forest_struct = _load_live_forest()
                        plan_struct = plan_reconcile(
                            forest_struct,
                            data,
                            clean=clean,
                            keep_others=keep_others,
                            safe=safe,
                            role_pins=role_pins or None,
                            just_opened_roles=(
                                set(role_pins.keys()) if role_pins else None
                            ),
                            workspace=workspace,
                        )
                        struct_ext, _ = partition_plan_actions(
                            plan_struct.get("actions")
                        )
                        struct_follow, _ = residual_follow_up(
                            without_focus_actions(struct_ext),
                            [],
                            force_close=force_close,
                            workspace=workspace,
                        )
                        _place3, struct2 = (
                            partition_extension_steps_place_vs_structure(
                                struct_follow
                            )
                        )
                    except Exception as e:
                        _eprint(
                            f"forge layout: structure re-plan after place2 failed: {e}"
                        )
                if struct2:
                    struct_ids = move_step_window_ids(struct2)
                    for _role, pin_wid in (role_pins or {}).items():
                        if pin_wid is not None and str(pin_wid) not in struct_ids:
                            struct_ids.append(str(pin_wid))
                    if struct_ids:
                        apply_log["followUpStructureSettle"] = (
                            wait_for_window_ids_settled(backend, struct_ids)
                        )
                    rc_s, agg_s = run_mixed_steps(
                        backend, struct2, stop_on_error=True, print_each=False
                    )
                    apply_log["followUpStructure"] = agg_s
                    if rc_s != 0:
                        _eprint("forge layout: follow-up structure steps failed")
                        out = _layout_plan_meta(
                            resolved, name, plan_struct, dry_run=False
                        )
                        out["ok"] = False
                        out["apply"] = apply_log
                        _layout_maybe_print_json(out, verbose=verbose, force=True)
                        return rc_s
                else:
                    apply_log["followUpStructure"] = {
                        "ok": True,
                        "skipped": True,
                        "reason": "nothing to structure",
                    }
                plan2 = plan_struct
            plan = plan2

            # Belt: optional stable wait, then wrong-mon rehome for just-opened only.
            # No ensure_layout / ensure_order here (CT cleanup: residual bind owns
            # structure; belt structure rewrite stomped open leaf / mon order).
            if role_pins and not still_open:
                belt_stable: dict[str, Any] = {"skipped": True}
                if wait_tree_stable:
                    belt_stable = wait_for_tree_stable(
                        _load_live_forest,
                        timeout_ms=BELT_STABLE_TIMEOUT_MS,
                        poll_ms=BELT_STABLE_POLL_MS,
                        stable_samples=BELT_STABLE_SAMPLES,
                    )
                    apply_log["beltTreeStable"] = {
                        k: v for k, v in belt_stable.items() if k != "forest"
                    }
                else:
                    apply_log["beltTreeStable"] = {"skipped": True}
                try:
                    forest3 = belt_stable.get("forest")
                    if not isinstance(forest3, dict):
                        forest3 = _load_live_forest()
                    plan3 = plan_reconcile(
                        forest3,
                        data,
                        clean=clean,
                        keep_others=keep_others,
                        safe=safe,
                        role_pins=role_pins,
                        just_opened_roles=set(role_pins.keys()),
                        workspace=workspace,
                    )
                except Exception as e:
                    _eprint(f"forge layout: belt re-plan after residual failed: {e}")
                else:
                    belt_ext, _belt_open = partition_plan_actions(plan3.get("actions"))
                    # Belt: pin-role moves only; focus is final pass after settle.
                    belt_actions = belt_actions_from_plan(
                        belt_ext, role_pins, include_focus=False
                    )
                    belt_steps, _ = residual_follow_up(
                        belt_actions,
                        [],
                        force_close=force_close,
                        workspace=workspace,
                    )
                    if belt_steps:
                        belt_ids = move_step_window_ids(belt_steps)
                        if belt_ids:
                            belt_settle = wait_for_window_ids_settled(
                                backend, belt_ids
                            )
                            apply_log["beltSettle"] = belt_settle
                        belt_t0 = time.monotonic()
                        rc, agg = run_mixed_steps(
                            backend, belt_steps, stop_on_error=True, print_each=False
                        )
                        apply_log["beltFollowUp"] = agg
                        if rc != 0:
                            _eprint("forge layout: belt follow-up moves failed")
                            out = _layout_plan_meta(resolved, name, plan3, dry_run=False)
                            out["ok"] = False
                            out["apply"] = apply_log
                            _layout_maybe_print_json(out, verbose=verbose, force=True)
                            return rc
                        if belt_ids:
                            _layout_soft_geom_pass(
                                backend,
                                belt_ids,
                                process_kind="move",
                                apply_log=apply_log,
                                log_key="beltGeomSoft",
                                call_started_mono=belt_t0,
                            )
                        plan = plan3

                # CT0/CT1: postOpenRetry Mode B thrash-recover is not the cold
                # success path. Default after open: skeleton→bind residual only.
                # Opt-in chaos recover: FORGE_LAYOUT_POST_OPEN_RETRY=1.
                post_open_retry = (
                    os.environ.get("FORGE_LAYOUT_POST_OPEN_RETRY", "")
                    .strip()
                    .lower()
                    in ("1", "true", "yes", "on")
                )
                apply_log["postOpenRetry"] = {
                    "needed": False,
                    "skipped": not post_open_retry,
                    "reason": (
                        None
                        if post_open_retry
                        else "ct1-cold-path (set FORGE_LAYOUT_POST_OPEN_RETRY=1)"
                    ),
                }
                if post_open_retry:
                    try:
                        time.sleep(0.45)
                        forest4 = _load_live_forest()
                        plan4 = plan_reconcile(
                            forest4,
                            data,
                            clean=clean,
                            keep_others=keep_others,
                            safe=safe,
                            role_pins=role_pins,
                            just_opened_roles=set(role_pins.keys()),
                            workspace=workspace,
                        )
                    except Exception as e:
                        _eprint(f"forge layout: post-open re-plan failed: {e}")
                    else:
                        thrash4 = plan4.get("thrashState") or {}
                        need_retry = bool(thrash4.get("thrashed")) or any(
                            isinstance(a, dict)
                            and (
                                str(a.get("op") or "").strip().lower()
                                in ("move", "ensure_order", "bind")
                                or (
                                    str(a.get("op") or "").strip().lower()
                                    == "ensure_layout"
                                    and a.get("windowIds")
                                )
                            )
                            for a in (plan4.get("actions") or [])
                        )
                        apply_log["postOpenRetry"] = {
                            "needed": need_retry,
                            "skipped": False,
                            "thrashed": bool(thrash4.get("thrashed")),
                            "reasons": thrash4.get("reasons"),
                        }
                        if need_retry:
                            retry_ext, _ = partition_plan_actions(
                                plan4.get("actions")
                            )
                            retry_actions = [
                                a
                                for a in retry_ext
                                if isinstance(a, dict)
                                and str(a.get("op") or "").strip().lower()
                                in (
                                    "move",
                                    "bind",
                                    "ensure_layout",
                                    "ensure_order",
                                    "ensure_sizes",
                                    "focus",
                                )
                            ]
                            retry_steps, _ = residual_follow_up(
                                retry_actions,
                                [],
                                force_close=force_close,
                                workspace=workspace,
                            )
                            if retry_steps:
                                retry_ids = move_step_window_ids(retry_steps)
                                if retry_ids:
                                    apply_log["postOpenRetrySettle"] = (
                                        wait_for_window_ids_settled(
                                            backend, retry_ids
                                        )
                                    )
                                rc, agg = run_mixed_steps(
                                    backend,
                                    retry_steps,
                                    stop_on_error=True,
                                    print_each=False,
                                )
                                apply_log["postOpenRetryFollowUp"] = agg
                                if rc != 0:
                                    _eprint("forge layout: post-open retry failed")
                                    out = _layout_plan_meta(
                                        resolved, name, plan4, dry_run=False
                                    )
                                    out["ok"] = False
                                    out["apply"] = apply_log
                                    _layout_maybe_print_json(
                                        out, verbose=verbose, force=True
                                    )
                                    return rc
                                plan = plan4

            if still_open:
                out = _layout_plan_meta(resolved, name, plan2, dry_run=False)
                out["ok"] = False
                out["error"] = f"roles still missing after launch: {still_open}"
                out["apply"] = apply_log
                _layout_maybe_print_json(out, verbose=verbose, force=True)
                return 1

            if open_failures:
                out = _layout_plan_meta(resolved, name, plan, dry_run=False)
                out["ok"] = False
                out["error"] = f"open failed for roles: {open_failures}"
                out["apply"] = apply_log
                _layout_maybe_print_json(out, verbose=verbose, force=True)
                return 1

            # Final open-leaf + profile focus after chrome/PWA map thrash settles.
            focus_rc, focus_plan = _layout_final_focus_pass(
                backend,
                data,
                clean=clean,
                keep_others=keep_others,
                safe=safe,
                workspace=workspace,
                role_pins=role_pins,
                force_close=force_close,
                apply_log=apply_log,
            )
            if focus_rc != 0:
                out = _layout_plan_meta(
                    resolved, name, focus_plan or plan, dry_run=False
                )
                out["ok"] = False
                out["error"] = "final focus pass failed"
                out["apply"] = apply_log
                _layout_maybe_print_json(out, verbose=verbose, force=True)
                return focus_rc
            if isinstance(focus_plan, dict):
                plan = focus_plan
        finally:
            if batch_ok:
                _end_ok, batch_end = _layout_batch_call(backend, "end")
                apply_log["layoutBatchEnd"] = batch_end
                if not _end_ok:
                    _eprint(
                        "forge layout: LayoutBatch end failed: "
                        f"{batch_end.get('error')}"
                    )
            # Clear apply chrome after residual/belt/retry (or error/early exit).
            if chrome_clear_needed:
                _clr_ok, clr_payload = _layout_batch_call(backend, "chrome-clear")
                apply_log["layoutChromeClear"] = clr_payload
                if not _clr_ok:
                    _eprint(
                        "forge layout: LayoutBatch chrome-clear failed: "
                        f"{clr_payload.get('error')}"
                    )
    else:
        # No opens: still one post-structure focus phase + soft barrier.
        focus_rc, focus_plan = _layout_final_focus_pass(
            backend,
            data,
            clean=clean,
            keep_others=keep_others,
            safe=safe,
            workspace=workspace,
            role_pins=role_pins,
            force_close=force_close,
            apply_log=apply_log,
        )
        if focus_rc != 0:
            out = _layout_plan_meta(
                resolved, name, focus_plan or plan, dry_run=False
            )
            out["ok"] = False
            out["error"] = "final focus pass failed"
            out["apply"] = apply_log
            _layout_maybe_print_json(out, verbose=verbose, force=True)
            return focus_rc
        if isinstance(focus_plan, dict):
            plan = focus_plan

    _eprint("  ok")
    out = _layout_plan_meta(resolved, name, plan, dry_run=False)
    out["apply"] = apply_log
    _layout_maybe_print_json(out, verbose=verbose)
    return 0


def _layout_profile_write_path(name: str) -> Path:
    """Host profile path for layout save (creates under hosts/<host>/)."""
    host = resolve_host()
    root = layout_tree_root()
    return root / "hosts" / host / f"{name}.json"


def _layout_run_save(
    backend: Optional[str],
    *,
    name: str,
    tree_file: Optional[str],
    stdout_only: bool,
    quiet: bool = False,
    description_flag: Optional[str] = None,
    no_description: bool = False,
    monitors: bool = False,
    keep_floats: bool = False,
) -> int:
    """Snapshot GetTree → tiles sugar; write host profile or print with --stdout."""
    try:
        name = _normalize_profile_name(name)
    except ValueError as e:
        _eprint(f"forge layout save: {e}")
        return 1

    if no_description and description_flag is not None:
        _eprint("forge layout save: use only one of --description / --no-description")
        return 1

    try:
        forest = _layout_load_tree(backend, tree_file)
    except FileNotFoundError as e:
        _eprint(f"forge layout save: {e}")
        return 1
    except (ValueError, RuntimeError, json.JSONDecodeError, OSError) as e:
        _eprint(f"forge layout save: {e}")
        return 1

    # Current desk only (meta activeWorkspace; offline without meta → ws0 pick).
    workspace = _layout_target_workspace(forest)

    try:
        profile = capture_tiles_profile(
            forest, workspace=workspace, keep_floats=bool(keep_floats)
        )
    except ValueError as e:
        _eprint(f"forge layout save: {e}")
        return 1

    dest = _layout_profile_write_path(name)
    existing = None if stdout_only else read_existing_description(dest)
    auto = auto_description_for_profile(profile)
    interactive = is_interactive_tty() and not quiet
    try:
        desc = resolve_save_description(
            auto=auto,
            existing=existing,
            description_flag=description_flag,
            no_description=no_description,
            interactive=interactive,
            profile_name=name,
            print_fn=_eprint,
        )
    except (EOFError, KeyboardInterrupt):
        _eprint("forge layout save: cancelled")
        return 130
    apply_description(profile, desc)

    payload = profile_for_output(profile, monitors=bool(monitors))
    body = json.dumps(payload, indent=2, ensure_ascii=False) + "\n"
    host = resolve_host()

    if stdout_only:
        if not quiet:
            _eprint(format_capture_stderr(profile))
            _eprint(f"forge layout save: stdout only host={host} name={name}")
        sys.stdout.write(body)
        return 0

    try:
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(body, encoding="utf-8")
    except OSError as e:
        _eprint(f"forge layout save: write failed: {e}")
        return 1
    if not quiet:
        _eprint(format_capture_stderr(profile))
        _eprint(f"forge layout save: wrote {dest} host={host} name={name}")
    return 0


def cmd_layout(backend: Optional[str], args: argparse.Namespace) -> int:
    """forge layout list | show | save | <targets…> [--dry-run] [--keep-others] [--safe]."""
    tokens: list[str] = list(getattr(args, "layout_tokens", None) or [])
    (
        action,
        name,
        run_tokens,
        dry_run,
        force_launch,
        _clean_flag,
        force_close,
    ) = _layout_parse_tokens(tokens, args)
    tree_file = getattr(args, "tree_file", None)
    verbose = _layout_is_verbose(args)
    safe = bool(getattr(args, "safe", False))
    keep_others = bool(
        getattr(args, "keep_others", False) or getattr(args, "keep", False)
    )
    # Product default: close non-layout windows. --keep-others parks instead.
    # --clean remains accepted (explicit close; same as default).
    if keep_others:
        clean = False
    else:
        clean = True
    wait_tree_stable = layout_wait_tree_stable_enabled(
        flag=bool(getattr(args, "wait_tree_stable", False)),
    )
    if force_close and keep_others:
        _eprint("forge layout: --force only applies when closing residuals (ignored with --keep-others)")
        force_close = False
    elif force_close and not clean:
        _eprint("forge layout: --force only applies when closing residuals (ignored)")
        force_close = False

    if action == "help":
        print_layout_help()
        return 0

    if action == "list":
        if len(tokens) > 1:
            _eprint("forge layout list: unexpected arguments")
            return 1
        host = resolve_host()
        # Default: this host only (hosts/<host>/…); not common/XDG flat.
        profiles = host_profiles_only(list_profiles_resolved())
        if not profiles:
            _eprint(f"forge layout: no profiles for host {host}")
            print("[]")
            return 0
        rows = []
        for p in profiles:
            row: dict[str, Any] = {"name": p["name"]}
            if p.get("description"):
                row["description"] = p["description"]
            else:
                row["description"] = ""
            rows.append(row)
        # TTY: Name/Description table only. Non-TTY: JSON name+description for scripts.
        try:
            tty = bool(sys.stdout.isatty())
        except Exception:
            tty = False
        if tty:
            print(format_profile_list_table(profiles, stream=sys.stdout))
        else:
            _print_json(rows, compact=False)
        return 0

    if action == "show":
        if not name or len(tokens) != 2:
            _eprint("forge layout show: need exactly one profile name")
            return 1
        try:
            resolved = resolve_profile(name)
        except ValueError as e:
            _eprint(f"forge layout show: {e}")
            return 1
        if not resolved["found"] or resolved["path"] is None:
            _eprint(f"forge layout show: profile not found: {name}")
            return 1
        path = resolved["path"]
        try:
            data = load_profile_file(path)
            mode = detect_layout_mode(data, force_launch=False)
            mon_count = None
            if mode == MODE_RECONCILE:
                # Prefer live mon count so bare tab|split is not dual-mon on 1-mon.
                try:
                    from layout_plan import forest_physical_mon_count

                    forest = _layout_load_tree(None, None)
                    mon_count = forest_physical_mon_count(forest)
                except Exception:
                    mon_count = None
                profile = validate_reconcile_profile(data, mon_count=mon_count)
            else:
                profile = validate_profile(data)
        except FileNotFoundError as e:
            _eprint(f"forge layout show: {e}")
            return 1
        except ValueError as e:
            _eprint(f"forge layout show: {e}")
            return 1
        show_desc = _layout_display_description(data, profile if isinstance(profile, dict) else None)
        _layout_print_header(resolved, name, description=show_desc or None)
        _eprint(f"  mode={mode}")
        out = {
            "path": str(path),
            "source": resolved["source"],
            "host": resolved["host"],
            "mode": mode,
            "profile": profile,
        }
        _print_json(out, compact=False)
        return 0

    if action == "save":
        if not name:
            _eprint("forge layout save: need profile name (`forge layout save <name>`)")
            return 1
        if len(tokens) > 2:
            _eprint("forge layout save: unexpected extra arguments")
            return 1
        # WS2: reject : / @ before path write (clear reserved-charset message).
        try:
            name = validate_layout_name(name)
        except LayoutParseError as e:
            _eprint(f"forge layout save: {e.message}")
            return 1
        stdout_only = bool(getattr(args, "stdout", False))
        desc_flag = getattr(args, "description", None)
        no_desc = bool(getattr(args, "no_description", False))
        return _layout_run_save(
            backend,
            name=name,
            tree_file=tree_file,
            stdout_only=stdout_only,
            quiet=bool(getattr(args, "quiet", False)),
            description_flag=desc_flag,
            no_description=no_desc,
            monitors=bool(getattr(args, "monitors", False)),
            keep_floats=bool(getattr(args, "keep_floats", False)),
        )

    if action != "run":
        _eprint(f"forge layout: unknown action {action!r}")
        return 1

    if not run_tokens:
        _eprint(
            "forge layout: use `forge layout <name>` "
            "(or list / show <name> / save <name>)"
        )
        return 1

    return _layout_run_multi(
        backend,
        run_tokens,
        dry_run=dry_run,
        tree_file=tree_file,
        clean=clean,
        keep_others=keep_others,
        force_close=force_close,
        safe=safe,
        verbose=verbose,
        force_launch=force_launch,
        wait_tree_stable=wait_tree_stable,
        focus_override=getattr(args, "focus", None),
    )


def _layout_eprint_error(msg: str) -> None:
    """Print multi-line layout error; first line prefixed, continuations indented."""
    lines = str(msg).splitlines() or [str(msg)]
    _eprint(f"forge layout: {lines[0]}")
    for line in lines[1:]:
        if line.startswith(" "):
            _eprint(line)
        else:
            _eprint(f"  {line}")


def _layout_run_multi(
    backend: Optional[str],
    run_tokens: list[str],
    *,
    dry_run: bool,
    tree_file: Optional[str],
    clean: bool,
    keep_others: bool = False,
    force_close: bool,
    safe: bool,
    verbose: bool,
    force_launch: bool,
    wait_tree_stable: bool = False,
    focus_override: Optional[str] = None,
) -> int:
    """
    Apply one or more layout targets after all-or-nothing preflight (WS2).

    Sequential: bare names → current, current+1, …
    Static: only N:name / name@N (1-based).
    Mixed bare + numbered → error, apply nothing.
    On first apply failure: stop and report (later targets not applied).
    """
    needs_bus = not tree_file
    if needs_bus and backend is None:
        backend = _check_deps()
    try:
        forest = _layout_load_tree(backend, tree_file)
    except Exception as e:
        _eprint(f"forge layout: GetTree failed: {e}")
        return 1

    current_0 = _layout_target_workspace(forest)
    n_ws = n_workspaces_from_forest(forest)
    if n_ws is None:
        _layout_eprint_error(
            "cannot determine workspace count "
            "(GetTree missing nWorkspaces and mon workspace ids)\n"
            "  hint: use a live session or a forest with nWorkspaces / moNwsW mon ids"
        )
        return 1

    try:
        mode_label, targets, resolved_list = preflight_layout_run(
            run_tokens,
            current_0based=current_0,
            n_workspaces=n_ws,
            resolve_name=resolve_profile,
        )
    except LayoutParseError as e:
        _layout_eprint_error(e.message)
        return 1

    # Load profile bodies after preflight (all names already resolve).
    payloads: list[tuple[Any, dict[str, Any], dict[str, Any], str]] = []
    for target, resolved in zip(targets, resolved_list):
        path = resolved.get("path") if isinstance(resolved, dict) else None
        if path is None:
            _layout_eprint_error(f"profile {target.name!r} not found")
            return 1
        try:
            data = load_profile_file(path)
            if focus_override is not None and str(focus_override).strip() != "":
                try:
                    data = apply_focus_override(data, focus_override)
                except ValueError as e:
                    _eprint(f"forge layout: --focus: {e}")
                    return 1
            layout_mode = detect_layout_mode(data, force_launch=force_launch)
        except (FileNotFoundError, ValueError) as e:
            _eprint(f"forge layout: {e}")
            return 1
        if layout_mode == MODE_STEPS and len(targets) > 1:
            _layout_eprint_error(
                f"multi-layout only supports reconcile profiles "
                f"({target.name!r} is steps mode)\n"
                "  hint: apply steps profiles one at a time"
            )
            return 1
        payloads.append((target, resolved, data, layout_mode))

    # Single steps profile (legacy path).
    if len(payloads) == 1 and payloads[0][3] == MODE_STEPS:
        _target, resolved, data, _lm = payloads[0]
        if clean:
            _eprint("forge layout: --clean applies to reconcile only (steps mode)")
        if safe:
            _eprint("forge layout: --safe applies to reconcile only (steps mode)")
        return _layout_run_steps(
            backend,
            resolved,
            data,
            dry_run=dry_run,
            force_launch=force_launch,
            verbose=verbose,
        )

    if len(targets) > 1:
        _eprint(
            f"forge layout: {mode_label} mode  "
            f"{len(targets)} target(s)  "
            f"current workspace {current_0 + 1}  "
            f"session {n_ws}"
        )

    applied: list[str] = []
    for target, resolved, data, _lm in payloads:
        # Fresh forest between applies so later desks see post-mutate state.
        if applied and not dry_run:
            try:
                forest = _layout_load_tree(backend, tree_file)
            except Exception as e:
                _eprint(f"forge layout: GetTree failed after {applied[-1]!r}: {e}")
                _eprint(
                    f"forge layout: stopped after {len(applied)}/"
                    f"{len(targets)} (applied: {', '.join(applied)})"
                )
                return 1
        rc = _layout_run_reconcile(
            backend,
            resolved,
            data,
            dry_run=dry_run,
            tree_file=tree_file,
            clean=clean,
            keep_others=keep_others,
            force_close=force_close,
            safe=safe,
            verbose=verbose,
            workspace=target.workspace_0based,
            forest=forest,
            wait_tree_stable=wait_tree_stable,
        )
        if rc != 0:
            if applied:
                _eprint(
                    f"forge layout: stopped after failure on {target.name!r} "
                    f"(ws {target.workspace_1based}); "
                    f"succeeded: {', '.join(applied)}"
                )
            else:
                _eprint(
                    f"forge layout: failed on {target.name!r} "
                    f"(ws {target.workspace_1based}); nothing applied"
                )
            return rc
        applied.append(f"{target.name}@ws{target.workspace_1based}")

    return 0


def _origin_paths() -> list[Path]:
    paths: list[Path] = []
    env = os.environ.get("FORGE_ORIGIN_PATH")
    if env:
        paths.append(Path(env).expanduser())
    paths.append(_DEFAULT_ORIGIN)
    paths.append(_EXT_ORIGIN)
    return paths


def _load_install_origin() -> Optional[dict[str, Any]]:
    for p in _origin_paths():
        if p.is_file():
            try:
                data = json.loads(p.read_text(encoding="utf-8"))
                if isinstance(data, dict):
                    data["_origin_path"] = str(p)
                    return data
            except (OSError, json.JSONDecodeError) as e:
                _eprint(f"forge: warn: could not read {p}: {e}")
    return None


def _repo_from_this_cli() -> Optional[Path]:
    """If this CLI lives under a forge git tree, return that repo root."""
    # scripts/forge/forge → repo is parents[2]
    here = Path(__file__).resolve()
    if here.parent.name == "forge" and here.parent.parent.name == "scripts":
        root = here.parent.parent.parent
        if (root / "scripts" / "install.zsh").is_file() and (root / "metadata.json").is_file():
            return root
        if (root / "Makefile").is_file() and (root / "metadata.json").is_file():
            return root
    return None


def _find_install_script(repo: Path, rel: str = "scripts/install.zsh") -> Optional[Path]:
    """Return install script path under repo, or None if tree incomplete."""
    for name in (
        rel,
        "scripts/install.zsh",
        "scripts/forge/rebuild.zsh",
        "scripts/forge/build-install.zsh",
    ):
        p = repo / name
        if p.is_file():
            return p
    return None


def _resolve_install_script(origin: Optional[dict[str, Any]]) -> tuple[Path, Path]:
    """
    Return (repo, install_script_path).

    Priority:
      1. FORGE_REPO_ROOT env (explicit override)
      2. install-origin.json (git) — **error if missing/incomplete** (no silent fallback)
      3. CLI lives inside a forge tree (dev convenience when no stamp yet)
    """
    env_repo = os.environ.get("FORGE_REPO_ROOT")
    if env_repo:
        repo = Path(env_repo).expanduser().resolve()
        script = _find_install_script(repo)
        if script is not None:
            return repo, script
        raise FileNotFoundError(
            f"FORGE_REPO_ROOT={repo} has no scripts/install.zsh (or forge install helpers)"
        )

    if origin is not None:
        source = origin.get("source") or "unknown"
        if source == "ego":
            raise FileNotFoundError(
                "install origin source is ego (extensions.gnome.org).\n"
                "`forge install` for EGO reinstall is not implemented yet.\n"
                "Use GNOME Extensions / scripts/forge/install-ego.zsh for now."
            )
        if source != "git":
            raise FileNotFoundError(
                f"install origin source={source!r} is not supported by `forge install` yet.\n"
                "Re-run ./install from a git clone of this tree."
            )
        repo_raw = origin.get("repo") or ""
        if not repo_raw:
            raise FileNotFoundError(
                "install origin has source=git but empty repo path.\n"
                f"stamp: {origin.get('_origin_path', _DEFAULT_ORIGIN)}"
            )
        repo = Path(str(repo_raw)).expanduser()
        # Do not resolve() if missing — resolve can still work on non-existing parents
        if not repo.is_dir():
            raise FileNotFoundError(
                f"install origin git tree not found (removed or moved):\n"
                f"  repo:   {repo}\n"
                f"  stamp:  {origin.get('_origin_path', _DEFAULT_ORIGIN)}\n"
                "Restore the clone or re-run ./install from a valid forge tree."
            )
        repo = repo.resolve()
        rel = str(origin.get("install_script") or "scripts/install.zsh")
        script = _find_install_script(repo, rel)
        if script is None:
            raise FileNotFoundError(
                f"install origin tree is incomplete (install script missing):\n"
                f"  repo:   {repo}\n"
                f"  script: {rel}\n"
                f"  stamp:  {origin.get('_origin_path', _DEFAULT_ORIGIN)}\n"
                "Restore the full clone or re-run ./install from a valid forge tree."
            )
        return repo, script

    # No origin stamp: allow CLI living inside a repo (first-time / dev path)
    cli_repo = _repo_from_this_cli()
    if cli_repo is not None:
        script = _find_install_script(cli_repo)
        if script is not None:
            return cli_repo, script

    raise FileNotFoundError(
        "no install origin recorded and this CLI is not inside a forge repo.\n"
        "Install once from a clone:\n"
        "  cd /path/to/forge && ./install --force\n"
        "That writes ~/.local/share/forge-manage/install-origin.json for later\n"
        "`forge install` re-runs."
    )


def _resolve_manage_script(
    rel: str, origin: Optional[dict[str, Any]] = None
) -> tuple[Path, Path]:
    """
    Return (repo, script_path) for a scripts/forge/*.zsh helper.

    Same resolution as install: FORGE_REPO_ROOT → origin → CLI tree.
    """
    if origin is None:
        origin = _load_install_origin()
    # Prefer install resolution (sets repo from origin / env / CLI location).
    try:
        repo, _install = _resolve_install_script(origin)
    except FileNotFoundError:
        # Still allow uninstall when only the CLI tree is known.
        cli_repo = _repo_from_this_cli()
        if cli_repo is None:
            raise
        repo = cli_repo
    script = repo / rel
    if not script.is_file():
        # Alternate: next to this CLI file
        alt = Path(__file__).resolve().parent / Path(rel).name
        if alt.is_file():
            return repo, alt
        raise FileNotFoundError(
            f"manage script missing: {script}\n"
            "Restore the forge git tree or re-run from a clone."
        )
    return repo, script


def _git(repo: Path, *git_args: str) -> subprocess.CompletedProcess[str]:
    """Run git -C repo … (no exception on non-zero)."""
    return subprocess.run(
        ["git", "-C", str(repo), *git_args],
        capture_output=True,
        text=True,
        check=False,
    )


def _git_is_repo(repo: Path) -> bool:
    r = _git(repo, "rev-parse", "--is-inside-work-tree")
    return r.returncode == 0 and r.stdout.strip() == "true"


def _git_update_preflight(repo: Path) -> Optional[str]:
    """
    Require clean tree on master. Return error message, or None if OK.
    """
    if not _git_is_repo(repo):
        return "update failed: not a git repository"
    branch = _git(repo, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    if branch != "master":
        return (
            f"update failed: non-master branch ({branch!r}). "
            "Checkout master (clean) and retry."
        )
    porcelain = _git(repo, "status", "--porcelain").stdout
    if porcelain.strip():
        return (
            "update failed: dirty git tree. "
            "Commit, stash, or discard local changes and retry."
        )
    return None


def cmd_install(_backend: Optional[str], args: argparse.Namespace) -> int:
    """Re-install from recorded git origin (or this CLI's tree). No DBus."""
    origin = _load_install_origin()
    try:
        repo, script = _resolve_install_script(origin)
    except FileNotFoundError as e:
        _eprint(f"forge: {e}")
        return 1

    verbose = bool(getattr(args, "verbose", False) or os.environ.get("FORGE_VERBOSE") == "1")

    if verbose:
        if origin:
            _eprint(
                f"forge: install origin source={origin.get('source')} "
                f"repo={origin.get('repo')} (stamp {origin.get('_origin_path')})"
            )
        else:
            _eprint(f"forge: no origin stamp; using CLI tree {repo}")

    cmd = [str(script)]
    # Forward known flags (restart is default in install.zsh; pass opt-outs only)
    if getattr(args, "force", False):
        cmd.append("--force")
    if getattr(args, "prod", False):
        cmd.append("--prod")
    if getattr(args, "dev", False):
        cmd.append("--dev")
    if getattr(args, "save", False):
        cmd.append("--save")
    if getattr(args, "no_save", False):
        cmd.append("--no-save")
    if getattr(args, "no_restart", False):
        cmd.append("--no-restart")
    elif getattr(args, "restart_shell", False):
        cmd.append("--restart-shell")
    if getattr(args, "reload_theme", False):
        cmd.append("--reload-theme")
    if getattr(args, "skip_npm", False):
        cmd.append("--skip-npm")
    if getattr(args, "no_host_defaults", False):
        cmd.append("--no-host-defaults")
    if verbose:
        cmd.append("--verbose")
    if getattr(args, "extra", None):
        cmd.extend(args.extra)

    env = os.environ.copy()
    env["FORGE_REPO_ROOT"] = str(repo)
    if getattr(args, "force", False):
        env["FORGE_FORCE"] = "1"
    if verbose:
        env["FORGE_VERBOSE"] = "1"

    if verbose:
        _eprint(f"forge: exec {' '.join(shlex.quote(c) for c in cmd)}")
    try:
        proc = subprocess.run(cmd, env=env, check=False)
    except OSError as e:
        _eprint(f"forge: failed to run install script: {e}")
        return 127
    return int(proc.returncode)


def cmd_update(_backend: Optional[str], args: argparse.Namespace) -> int:
    """
    Fetch origin; ff-pull when behind; always forge install so live code matches tree.

    Repo may already match origin/master while the extension install is stale —
    update still rebuilds and installs. Refuses dirty trees and non-master branches.
    """
    origin = _load_install_origin()
    try:
        repo, _script = _resolve_install_script(origin)
    except FileNotFoundError as e:
        _eprint(f"forge: {e}")
        return 1

    err = _git_update_preflight(repo)
    if err:
        _eprint(f"forge: {err}")
        return 1

    _eprint(f"forge: update repo {repo}")
    fetch = _git(repo, "fetch", "origin")
    if fetch.returncode != 0:
        detail = (fetch.stderr or fetch.stdout or "").strip()
        _eprint("forge: update failed: git fetch origin failed")
        if detail:
            _eprint(detail)
        return 1

    verify = _git(repo, "rev-parse", "--verify", "origin/master")
    if verify.returncode != 0:
        _eprint(
            "forge: update failed: origin/master not found after fetch. "
            "Set origin to lukebmay/forge (or a remote that publishes master)."
        )
        return 1

    behind_s = _git(repo, "rev-list", "--count", "HEAD..origin/master").stdout.strip()
    ahead_s = _git(repo, "rev-list", "--count", "origin/master..HEAD").stdout.strip()
    try:
        behind = int(behind_s or "0")
        ahead = int(ahead_s or "0")
    except ValueError:
        _eprint("forge: update failed: could not compare HEAD to origin/master")
        return 1

    if behind > 0:
        _eprint(f"forge: {behind} commit(s) on origin/master — pulling (ff-only)…")
        pull = _git(repo, "pull", "--ff-only", "origin", "master")
        if pull.returncode != 0:
            detail = (pull.stderr or pull.stdout or "").strip()
            _eprint("forge: update failed: git pull --ff-only origin master failed")
            if detail:
                _eprint(detail)
            if ahead > 0:
                _eprint(
                    f"hint: local master is also ahead by {ahead} commit(s); "
                    "ff-only cannot diverge — merge/rebase manually, then forge install"
                )
            return 1

        err2 = _git_update_preflight(repo)
        if err2:
            _eprint(f"forge: update failed after pull: {err2}")
            return 1
        _eprint("forge: pull ok — running install…")
    elif ahead > 0:
        _eprint(
            f"forge: git already up to date with origin/master "
            f"(local master is ahead by {ahead} commit(s); nothing to pull) "
            "— installing so live extension matches this tree…"
        )
    else:
        _eprint(
            "forge: git already up to date with origin/master "
            "— installing so live extension matches this tree…"
        )

    # Always install: tree may be current while extension files are stale.
    if not getattr(args, "force", False):
        args.force = True
    return cmd_install(_backend, args)


def _jobs_format_age(started_at: Any, *, now: Optional[float] = None) -> str:
    try:
        started = float(started_at)
    except (TypeError, ValueError):
        return "?"
    ts = time.time() if now is None else float(now)
    sec = max(0, int(ts - started))
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{sec // 60}m"
    if sec < 86400:
        return f"{sec // 3600}h"
    return f"{sec // 86400}d"


def _jobs_resolve_id(jobs_root: Path, job_id: str) -> str:
    """Accept full id or unique prefix."""
    jid = (job_id or "").strip()
    if not jid:
        raise JobNotFoundError(job_id or "")
    direct = job_dir(jobs_root, jid)
    if (direct / "status.json").is_file():
        return jid
    matches = [
        p.name
        for p in jobs_root.iterdir()
        if p.is_dir() and p.name.startswith(jid) and (p / "status.json").is_file()
    ] if jobs_root.is_dir() else []
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        raise ValueError(
            f"ambiguous job id {jid!r}; matches: {', '.join(sorted(matches))}"
        )
    raise JobNotFoundError(jid)


def cmd_jobs(_backend: Optional[str], args: argparse.Namespace) -> int:
    """Manage durable forge jobs (list/status/attach/cancel/log). No DBus."""
    root = default_jobs_root()
    try:
        reap_stale_jobs(root)
    except OSError:
        pass

    action = str(getattr(args, "jobs_action", "list") or "list").strip().lower()
    job_id_arg = getattr(args, "job_id", None)
    follow = bool(getattr(args, "follow", False))
    compact = bool(getattr(args, "compact", False))

    if action in ("list", ""):
        rows = list_jobs(root)
        if compact:
            _print_json(rows, compact=True)
            return 0
        if not rows:
            print("no jobs")
            return 0
        # active first already by started_at desc in list_jobs; group active top
        active = [r for r in rows if str(r.get("status")) not in TERMINAL_STATUSES]
        done = [r for r in rows if str(r.get("status")) in TERMINAL_STATUSES]
        ordered = active + done
        print(f"{'ID':<28} {'STATUS':<10} {'PID':<8} {'AGE':<6} COMMAND")
        for r in ordered:
            jid = str(r.get("job_id") or "")
            st = str(r.get("status") or "")
            pid = r.get("pid")
            pid_s = str(pid) if pid is not None else "-"
            age = _jobs_format_age(r.get("started_at"))
            cmd = str(r.get("command") or "")
            argv = r.get("argv") or []
            if isinstance(argv, list) and len(argv) >= 3:
                # python forge <cmd> ...
                tail = " ".join(str(x) for x in argv[2:6])
                if len(argv) > 6:
                    tail += " …"
                cmd = tail or cmd
            print(f"{jid:<28} {st:<10} {pid_s:<8} {age:<6} {cmd}")
        return 0

    if not job_id_arg:
        _eprint(f"forge jobs {action}: need job id")
        return 1
    try:
        jid = _jobs_resolve_id(root, str(job_id_arg))
    except JobNotFoundError as e:
        _eprint(f"forge jobs: {e}")
        return 1
    except ValueError as e:
        _eprint(f"forge jobs: {e}")
        return 1

    jdir = job_dir(root, jid)

    if action == "status":
        try:
            st = read_status(jdir)
        except JobNotFoundError as e:
            _eprint(f"forge jobs: {e}")
            return 1
        _print_json(st, compact=compact)
        return 0

    if action == "cancel":
        try:
            st = read_status(jdir)
        except JobNotFoundError as e:
            _eprint(f"forge jobs: {e}")
            return 1
        if str(st.get("status")) in TERMINAL_STATUSES:
            print(f"job {jid} already {st.get('status')}")
            return 0
        ok = request_cancel(root, jid)
        if not ok:
            _eprint(f"forge jobs cancel: could not signal job {jid}")
            return 1
        print(f"job {jid} cancel signaled")
        return 0

    if action == "attach":
        try:
            st = read_status(jdir)
        except JobNotFoundError as e:
            _eprint(f"forge jobs: {e}")
            return 1
        if str(st.get("status")) in TERMINAL_STATUSES:
            # drain logs and return stored exit
            for name in ("stdout.log", "stderr.log"):
                path = jdir / name
                if path.is_file():
                    sys.stdout.write(path.read_text(encoding="utf-8", errors="replace"))
            code = st.get("exit_code")
            return int(code) if code is not None else (0 if st.get("status") == "ok" else 1)
        try:
            handle = load_handle(root, jid)
        except Exception as e:
            _eprint(f"forge jobs attach: {e}")
            return 1
        return int(attach(handle))

    if action == "log":
        stdout_path = jdir / "stdout.log"
        stderr_path = jdir / "stderr.log"
        if follow:
            off_out = 0
            off_err = 0
            try:
                while True:
                    if stdout_path.is_file():
                        with open(
                            stdout_path, "r", encoding="utf-8", errors="replace"
                        ) as fh:
                            fh.seek(off_out)
                            data = fh.read()
                            off_out = fh.tell()
                        if data:
                            sys.stdout.write(data)
                            sys.stdout.flush()
                    if stderr_path.is_file():
                        with open(
                            stderr_path, "r", encoding="utf-8", errors="replace"
                        ) as fh:
                            fh.seek(off_err)
                            data = fh.read()
                            off_err = fh.tell()
                        if data:
                            sys.stderr.write(data)
                            sys.stderr.flush()
                    try:
                        st = read_status(jdir)
                    except JobNotFoundError:
                        break
                    if str(st.get("status")) in TERMINAL_STATUSES:
                        break
                    pid = st.get("pid")
                    if pid is not None and not pid_alive(int(pid)):
                        break
                    time.sleep(0.1)
            except KeyboardInterrupt:
                return 130
            return 0
        if stdout_path.is_file():
            sys.stdout.write(stdout_path.read_text(encoding="utf-8", errors="replace"))
        if stderr_path.is_file():
            err_text = stderr_path.read_text(encoding="utf-8", errors="replace")
            if err_text:
                if not err_text.endswith("\n"):
                    err_text += "\n"
                sys.stderr.write(err_text)
        return 0

    _eprint(f"forge jobs: unknown action {action!r}")
    return 1


def cmd_uninstall(_backend: Optional[str], args: argparse.Namespace) -> int:
    """Remove extension + forge-owned ~/.local/bin/forge. No DBus."""
    origin = _load_install_origin()
    try:
        repo, script = _resolve_manage_script("scripts/forge/uninstall.zsh", origin)
    except FileNotFoundError as e:
        _eprint(f"forge: {e}")
        return 1

    cmd = [str(script)]
    if getattr(args, "force", False):
        cmd.append("--force")
    if getattr(args, "purge_config", False):
        cmd.append("--purge-config")
    if getattr(args, "purge_dconf", False):
        cmd.append("--purge-dconf")
    if getattr(args, "keep_cli", False):
        cmd.append("--keep-cli")

    env = os.environ.copy()
    env["FORGE_REPO_ROOT"] = str(repo)
    if getattr(args, "force", False):
        env["FORGE_FORCE"] = "1"

    _eprint(f"forge: exec {' '.join(shlex.quote(c) for c in cmd)}")
    try:
        proc = subprocess.run(cmd, env=env, check=False)
    except OSError as e:
        _eprint(f"forge: failed to run uninstall script: {e}")
        return 127
    return int(proc.returncode)


def cmd_run(backend: str, args: argparse.Namespace) -> int:
    """forge run <file.json> — mixed steps (CLI launch/wait + extension RunSteps)."""
    path = Path(args.file).expanduser() if args.file else None
    if not path:
        _eprint("forge run: file required")
        return 1
    if not path.is_file():
        _eprint(f"forge run: file not found: {path}")
        return 1
    try:
        raw = path.read_text(encoding="utf-8")
    except OSError as e:
        _eprint(f"forge run: cannot read {path}: {e}")
        return 1
    raw = raw.strip()
    if not raw:
        _eprint("forge run: empty file")
        return 1
    try:
        payload = _load_steps_payload(raw)
        steps, stop_on_error = extract_steps_and_stop(payload)
    except ValueError as e:
        _eprint(f"forge run: {e}")
        return 1

    # Pure extension payload → single RunSteps (same as run-steps)
    cli_ops = _payload_has_cli_only(payload if isinstance(payload, (list, dict)) else {"steps": steps})
    if not cli_ops:
        steps_json = json.dumps(payload, separators=(",", ":"), ensure_ascii=False)
        return _cmd_result(backend, "RunSteps", steps_json, label="run")

    rc, aggregate = run_mixed_steps(
        backend, steps, stop_on_error=stop_on_error, print_each=False
    )
    aggregate["file"] = str(path)
    _print_json(aggregate, compact=False)
    return rc


