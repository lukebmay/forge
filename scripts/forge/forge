def _job_layout_head(args: argparse.Namespace) -> str:
    tokens = list(getattr(args, "layout_tokens", None) or [])
    return tokens[0].strip() if tokens else ""


def _should_use_job_runner(args: argparse.Namespace) -> bool:
    cmd = getattr(args, "command", None) or ""
    if cmd == "layout":
        return is_mutating_job_command(
            "layout",
            layout_head=_job_layout_head(args),
            dry_run=bool(getattr(args, "dry_run", False)),
        )
    return is_mutating_job_command(cmd)


def _dispatch_command(args: argparse.Namespace) -> int:
    """Run the parsed subcommand (in-process). Shared by parent worker path."""
    cmd_name = getattr(args, "command", None) or ""
    if cmd_name in _NO_DBUS_COMMANDS or getattr(args, "func", None) in (
        cmd_install,
        cmd_update,
        cmd_uninstall,
        cmd_help,
        cmd_jobs,
    ):
        return int(args.func(None, args))

    if cmd_name == "thrash":
        action = str(getattr(args, "thrash_action", None) or "catalog").strip().lower()
        if action in ("heuristics", "heuristics-status", "reset-heuristics"):
            return int(args.func(None, args))
        backend = _check_deps()
        return int(args.func(backend, args))

    if cmd_name == "layout":
        tokens = list(getattr(args, "layout_tokens", None) or [])
        head = tokens[0].strip() if tokens else ""
        dry = bool(getattr(args, "dry_run", False))
        tree_file = getattr(args, "tree_file", None)
        if head in ("list", "show", "help", "-h", "--help") or not tokens:
            return int(args.func(None, args))
        if head == "save" and tree_file:
            return int(args.func(None, args))
        if dry and tree_file:
            return int(args.func(None, args))
        backend = _check_deps()
        return int(args.func(backend, args))

    backend = _check_deps()
    return int(args.func(backend, args))


def main(argv: Optional[list[str]] = None) -> int:
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    cleaned_argv, detach, foreground = extract_job_meta_flags(raw_argv)
    argv = cleaned_argv
    argv, color_mode = parse_color_flag(argv)
    if color_mode is not None:
        try:
            set_color_mode(color_mode)
        except ValueError as e:
            _eprint(f"forge: {e}")
            return 1

    # Allow `forge --help` / bare `forge` without DBus deps (colorized)
    if not argv or argv[0] in ("-h", "--help"):
        print_forge_help()
        return 0
    if argv[0] == "--version":
        print(f"forge {FORGE_VERSION}")
        return 0
    if argv[0] == "help":
        print_forge_help()
        return 0
    if argv[0] == "test":
        _eprint(_TEST_MIGRATION)
        return 2
    if argv[0] == "nested":
        _eprint(_NESTED_MIGRATION)
        return 2

    # Global --first before subcommand: forge --first focus 'class:Foo'
    global_first = False
    pre: list[str] = []
    rest: list[str] = []
    seen_cmd = False
    for a in argv:
        if not seen_cmd and a == "--first":
            global_first = True
            continue
        if not seen_cmd and not a.startswith("-"):
            seen_cmd = True
        if seen_cmd:
            rest.append(a)
        else:
            pre.append(a)
    argv = pre + rest

    parser = build_parser()
    args = parser.parse_args(argv)
    if global_first:
        args.first = True
    elif not hasattr(args, "first"):
        args.first = False
    if getattr(args, "color", None):
        try:
            set_color_mode(args.color)
        except ValueError as e:
            _eprint(f"forge: {e}")
            return 1

    cmd_name = getattr(args, "command", None) or ""

    # Durable job wrap for mutating commands (default attach; --detach = no wait)
    if (
        _should_use_job_runner(args)
        and not is_job_worker()
        and not foreground
    ):
        try:
            reap_stale_jobs(default_jobs_root())
        except OSError:
            pass
        forge_script = Path(__file__).resolve()
        worker_argv = [sys.executable, str(forge_script), *argv]
        timeout_sec = default_timeout_for_command(cmd_name)
        try:
            job_rc = maybe_run_as_job(
                worker_argv,
                detach=detach,
                foreground=False,
                command=cmd_name,
                timeout_sec=timeout_sec,
            )
        except BusyError as e:
            _eprint(f"forge: another mutating job is running: {e.job_id}")
            _eprint(
                f"  status: {default_jobs_root() / e.job_id / 'status.json'}"
            )
            _eprint("  wait for it to finish, or set FORGE_JOB=0 / --foreground to bypass")
            return 1
        except Exception as e:
            _eprint(f"forge: job runner failed: {e}")
            return 1
        if job_rc is not None:
            return int(job_rc)

    return _dispatch_command(args)


if __name__ == "__main__":
    _exit = 1
    try:
        if is_job_worker():
            worker_install_signal_policy()
        _exit = int(main())
    except SystemExit as e:
        code = e.code
        if code is None:
            _exit = 0
        elif isinstance(code, int):
            _exit = code
        else:
            _exit = 1
    except KeyboardInterrupt:
        _exit = 130
    except BaseException:
        if is_job_worker():
            worker_mark_done(1)
        raise
    if is_job_worker():
        worker_mark_done(_exit, cancelled=(_exit == 130))
    sys.exit(_exit)
