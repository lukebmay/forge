def _project_node_to_portable(node: dict[str, Any]) -> dict[str, Any] | None:
    """Convert a GetTree node into session-layout portable form."""
    if not isinstance(node, dict):
        return None
    ntype = node.get("nodeType")
    if ntype == "WINDOW":
        wid = node.get("windowId")
        if wid is None:
            return None
        out: dict[str, Any] = {
            "id": wid,
            "percent": node.get("percent") or 0,
            "userSized": bool(node.get("userSized")),
        }
        if node.get("wmClass") is not None:
            out["wmClass"] = node.get("wmClass")
        if node.get("title") is not None:
            out["title"] = node.get("title")
        if node.get("pid"):
            out["pid"] = node.get("pid")
        if isinstance(node.get("monitor"), int) and node["monitor"] >= 0:
            out["monitor"] = node["monitor"]
        rect = node.get("rect")
        if isinstance(rect, dict) and all(k in rect for k in ("x", "y", "width", "height")):
            out["frame"] = {
                "x": rect["x"],
                "y": rect["y"],
                "width": rect["width"],
                "height": rect["height"],
            }
        return out
    # CON / MONITOR children
    children_in = node.get("children") or []
    children: list[dict[str, Any]] = []
    for ch in children_in:
        p = _project_node_to_portable(ch)
        if p:
            children.append(p)
    if not children and ntype != "MONITOR":
        return None
    layout = node.get("layout")
    if ntype == "MONITOR":
        mon_id = node.get("id")
        if not mon_id or not children:
            return None
        mon: dict[str, Any] = {
            "id": mon_id,
            "layout": layout or "HSPLIT",
            "children": children,
        }
        if node.get("stableKey"):
            mon["stableKey"] = node["stableKey"]
        return mon
    # CON
    if not layout or not children:
        return None
    out_con: dict[str, Any] = {
        "layout": layout,
        "percent": node.get("percent") or 0,
        "userSized": bool(node.get("userSized")),
        "children": children,
    }
    # Which tab/stack leaf is open — required for install/update restore.
    ltf = node.get("lastTabFocusId")
    if ltf is not None:
        out_con["lastTabFocusId"] = ltf
    return out_con


def _write_session_layout_from_tree(forest: dict[str, Any]) -> dict[str, Any]:
    """Write session-layout.json from a GetTree forest (DBus-less fallback)."""
    portable_mons: list[dict[str, Any]] = []
    for m in forest.get("monitors") or []:
        if not (m.get("children") or []):
            continue
        pm = _project_node_to_portable(m)
        if pm:
            portable_mons.append(pm)
    if not portable_mons:
        return {"ok": False, "error": "no non-empty monitors in tree"}

    envelope: dict[str, Any] = {
        "kind": "forge-session-layout",
        "sessionVersion": 1,
        "savedMonotonicUs": time.monotonic_ns() // 1000,
        "savedAtMs": int(time.time() * 1000),
        "forest": {"version": 1, "monitors": portable_mons},
    }
    fw = forest.get("focusWindowId")
    if fw is not None:
        envelope["focusWindowId"] = fw
    conf = Path.home() / ".config" / "forge" / "config"
    conf.mkdir(parents=True, exist_ok=True)
    path = conf / "session-layout.json"
    path.write_text(json.dumps(envelope, indent=2) + "\n", encoding="utf-8")
    return {
        "ok": True,
        "path": str(path),
        "monitors": len(portable_mons),
        "source": "GetTree",
    }


def cmd_save_session_layout(backend: str, _args: argparse.Namespace) -> int:
    """Flush last-good tile topology before install / Shell reload."""
    try:
        raw = call_method(backend, "SaveSessionLayout")
        data = json.loads(raw)
        if isinstance(data, dict) and data.get("ok") is True:
            _print_json(data, compact=False)
            return 0
    except Exception:
        data = None

    try:
        raw = call_method(backend, "GetTree", "{}")
        forest = json.loads(raw)
        if isinstance(forest, dict) and forest.get("error"):
            _eprint(f"forge save-session-layout: {forest['error']}")
            return 1
        result = _write_session_layout_from_tree(forest)
        _print_json(result, compact=False)
        return 0 if result.get("ok") else 1
    except Exception as e:
        _eprint(f"forge save-session-layout: failed: {e}")
        if data is not None:
            _print_json(data, compact=False)
        return 1


