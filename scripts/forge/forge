def main(argv: Optional[list[str]] = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    # Allow `forge --help` without DBus deps
    if not argv or argv[0] in ("-h", "--help", "--version"):
        parser = build_parser()
        if argv and argv[0] == "--version":
            print(f"forge {FORGE_VERSION}")
            return 0
        parser.print_help()
        return 0

    # Global --first before subcommand: forge --first focus 'class:Foo'
    global_first = False
    pre: list[str] = []
    rest: list[str] = []
    seen_cmd = False
    for a in argv:
        if not seen_cmd and a == "--first":
            global_first = True
            continue
        if not seen_cmd and not a.startswith("-"):
            seen_cmd = True
        if seen_cmd:
            rest.append(a)
        else:
            pre.append(a)
    argv = pre + rest

    parser = build_parser()
    args = parser.parse_args(argv)
    if global_first:
        args.first = True
    elif not hasattr(args, "first"):
        args.first = False

    # install / uninstall / workon list|show do not need DBus
    cmd_name = getattr(args, "command", None) or ""
    if cmd_name in _NO_DBUS_COMMANDS or getattr(args, "func", None) in (
        cmd_install,
        cmd_uninstall,
    ):
        return int(args.func(None, args))

    if cmd_name == "workon":
        tokens = list(getattr(args, "workon_tokens", None) or [])
        head = tokens[0].strip() if tokens else ""
        if head in ("list", "show") or not tokens:
            return int(args.func(None, args))
        backend = _check_deps()
        return int(args.func(backend, args))

    backend = _check_deps()
    return int(args.func(backend, args))


if __name__ == "__main__":
    sys.exit(main())
