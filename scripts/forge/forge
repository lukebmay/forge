def cmd_thrash(backend: Optional[str], args: argparse.Namespace) -> int:
    """Thrash/settle debug: extension catalog, heuristics file status, or reset."""
    action = str(getattr(args, "thrash_action", None) or "catalog").strip().lower()
    compact = bool(getattr(args, "compact", False))

    if action in ("heuristics", "heuristics-status"):
        status = store_file_status()
        _print_json(status, compact=compact)
        return 0 if status.get("reason") in ("ok", "missing") else 0

    if action == "reset-heuristics":
        unlink = bool(getattr(args, "unlink", False))
        result = reset_heuristics_file(unlink=unlink)
        if not result.get("ok"):
            _eprint(
                f"forge thrash reset-heuristics: {result.get('error') or 'failed'}"
            )
            _print_json(result, compact=compact)
            return 1
        path = result.get("path") or ""
        if result.get("action") == "removed":
            _eprint(f"forge thrash: removed settle heuristics {path}")
        elif result.get("action") == "missing":
            _eprint(f"forge thrash: no settle heuristics file ({path})")
        else:
            _eprint(
                f"forge thrash: wrote empty settle heuristics "
                f"v{result.get('schemaVersion')} → {path}"
            )
        _print_json(result, compact=compact)
        return 0

    # Default: dump extension thrash/settle catalog (GetThrashCatalog).
    if backend is None:
        _eprint("forge thrash: DBus backend required for catalog dump")
        return 1
    try:
        raw = call_method(backend, "GetThrashCatalog")
    except Exception as e:
        _eprint(f"forge thrash: bus call failed (is the extension enabled?): {e}")
        return 1
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        print(raw)
        return 1
    if isinstance(data, dict) and data.get("ok") is False:
        err = data.get("error") or "thrash catalog failed"
        _eprint(f"forge thrash: {err}")
        _print_json(data, compact=compact)
        return 1
    _print_json(data, compact=compact)
    return 0


