def main(argv: Optional[list[str]] = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    argv, color_mode = parse_color_flag(argv)
    if color_mode is not None:
        try:
            set_color_mode(color_mode)
        except ValueError as e:
            _eprint(f"forge: {e}")
            return 1

    # Allow `forge --help` / bare `forge` without DBus deps (colorized)
    if not argv or argv[0] in ("-h", "--help"):
        print_forge_help()
        return 0
    if argv[0] == "--version":
        print(f"forge {FORGE_VERSION}")
        return 0
    if argv[0] == "help":
        print_forge_help()
        return 0

    # Global --first before subcommand: forge --first focus 'class:Foo'
    global_first = False
    pre: list[str] = []
    rest: list[str] = []
    seen_cmd = False
    for a in argv:
        if not seen_cmd and a == "--first":
            global_first = True
            continue
        if not seen_cmd and not a.startswith("-"):
            seen_cmd = True
        if seen_cmd:
            rest.append(a)
        else:
            pre.append(a)
    argv = pre + rest

    parser = build_parser()
    args = parser.parse_args(argv)
    if global_first:
        args.first = True
    elif not hasattr(args, "first"):
        args.first = False
    if getattr(args, "color", None):
        try:
            set_color_mode(args.color)
        except ValueError as e:
            _eprint(f"forge: {e}")
            return 1

    # install / update / uninstall / help / layout list|show|help do not need DBus
    cmd_name = getattr(args, "command", None) or ""
    if cmd_name in _NO_DBUS_COMMANDS or getattr(args, "func", None) in (
        cmd_install,
        cmd_update,
        cmd_uninstall,
        cmd_help,
    ):
        return int(args.func(None, args))

    if cmd_name == "layout":
        tokens = list(getattr(args, "layout_tokens", None) or [])
        head = tokens[0].strip() if tokens else ""
        dry = bool(getattr(args, "dry_run", False))
        tree_file = getattr(args, "tree_file", None)
        if head in ("list", "show", "help", "-h", "--help") or not tokens:
            return int(args.func(None, args))
        # Offline: save / dry-run when forest is on disk
        if head == "save" and tree_file:
            return int(args.func(None, args))
        if dry and tree_file:
            return int(args.func(None, args))
        backend = _check_deps()
        return int(args.func(backend, args))

    backend = _check_deps()
    return int(args.func(backend, args))


if __name__ == "__main__":
    sys.exit(main())
