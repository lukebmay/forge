def do_launch(
    backend: str,
    *,
    app: str,
    wm_class: Optional[str] = None,
    timeout: Optional[int] = None,
    no_wait: bool = False,
    monitor: Any = None,
    tree_path: Optional[str] = None,
    attach_selector: Optional[str] = None,
    first: bool = False,
    title_contains: Optional[str] = None,
    title_exact: Optional[str] = None,
    print_result: bool = True,
    require_settled: bool = True,
) -> tuple[int, dict[str, Any]]:
    """Shared launch path for `forge launch` and layout/run launch steps.

    require_settled: LF5 default True (wait TILE). CL9 layout deferred opens use
    False (map + windowId only) when waiting serially; parallel path uses no_wait
    then wait_for_open_role_pins.
    """
    app = (app or "").strip().strip("'\"")
    if not app:
        out = {"ok": False, "error": "app required", "op": "launch"}
        if print_result:
            _eprint("forge launch: app required")
        return 1, out

    timeout_ms = int(timeout if timeout is not None else DEFAULT_LAUNCH_TIMEOUT_MS)
    desktop = resolve_desktop_file(app)
    # Rewritten multi-instance argv still needs desktop for StartupWMClass hints.
    if desktop is None and is_ghostty_launch_target(app):
        desktop = resolve_desktop_file("ghostty") or resolve_desktop_file(
            "com.mitchellh.ghostty"
        )
    explicit_class = (wm_class or "").strip() or None
    class_hints = infer_wm_class_hints(app, desktop)
    if not class_hints and is_ghostty_launch_target(app, desktop):
        class_hints = infer_wm_class_hints("ghostty", desktop)
    # Hints first (specific desktop / PWA), then profile sugar (Google-chrome).
    wait_classes = merge_launch_wait_classes(explicit_class, class_hints)
    place_class = prefer_launch_place_class(explicit_class, class_hints)

    place_opts: dict[str, Any] = {}
    if monitor is not None and str(monitor).strip() != "":
        place_opts["monitor"] = monitor
    if tree_path is not None and str(tree_path).strip() != "":
        place_opts["treePath"] = tree_path
    # Nested join (e.g. open nautilus under mon0.s1 ghostty) — PlaceNext attachSelector.
    attach = (attach_selector or "").strip() if attach_selector is not None else ""
    if attach:
        place_opts["attachSelector"] = attach
    if place_class:
        place_opts["wmClass"] = place_class
    tc = (title_contains or "").strip() if title_contains is not None else ""
    te = (title_exact or "").strip() if title_exact is not None else ""
    if tc:
        place_opts["titleContains"] = tc
    if te:
        place_opts["titleExact"] = te
    if first:
        place_opts["first"] = True
    if place_opts and (
        "monitor" in place_opts or "treePath" in place_opts or "attachSelector" in place_opts
    ):
        place_opts["ttlMs"] = max(timeout_ms, DEFAULT_LAUNCH_TIMEOUT_MS)

    if place_opts and (
        "monitor" in place_opts or "treePath" in place_opts or "attachSelector" in place_opts
    ):
        try:
            raw = call_method(backend, "PlaceNext", json.dumps(place_opts))
            data = json.loads(raw)
        except Exception as e:
            out = {"ok": False, "error": f"PlaceNext failed: {e}", "op": "launch", "app": app}
            if print_result:
                _eprint(f"forge launch: PlaceNext failed (is the extension enabled?): {e}")
            return 1, out
        if not isinstance(data, dict) or data.get("ok") is not True:
            err = data.get("error") if isinstance(data, dict) else raw
            out = {"ok": False, "error": f"PlaceNext error: {err}", "op": "launch", "app": app}
            if isinstance(data, dict):
                out["placeNext"] = data
            if print_result:
                _eprint(f"forge launch: PlaceNext error: {err}")
                if isinstance(data, dict):
                    _print_json(data, compact=False)
            return 1, out

    baseline: set[str] = set()
    if not no_wait:
        baseline = _baseline_window_ids(backend)

    try:
        proc = launch_app(app, desktop=desktop)
    except Exception as e:
        out = {"ok": False, "error": str(e), "op": "launch", "app": app}
        if print_result:
            _eprint(f"forge launch: failed to start {app!r}: {e}")
        return 1, out

    if no_wait:
        payload: dict[str, Any] = {
            "ok": True,
            "pid": proc.pid,
            "waited": False,
            "app": app,
            "op": "launch",
            # CL9 parallel open: caller waits for map pins with these classes.
            "waitClasses": wait_classes,
            "acceptAnyNew": wait_classes is None,
            "timeoutMs": timeout_ms,
        }
        if desktop:
            payload["desktop"] = desktop
        if class_hints:
            payload["wmClassCandidates"] = class_hints
        if print_result:
            _print_json(payload, compact=False)
        return 0, payload

    result = wait_for_wm_class(
        backend,
        wait_classes,
        timeout_ms,
        first=first,
        baseline_ids=baseline,
        # Any wait class (explicit or desktop hints) disables accept-any fallback.
        accept_any_new=wait_classes is None,
        require_settled=require_settled,
    )
    result = dict(result)
    result["op"] = "launch"
    result["pid"] = proc.pid
    result["waited"] = True
    result["app"] = app
    result["requireSettled"] = require_settled
    if desktop:
        result["desktop"] = desktop

    if not result.get("ok"):
        cands = wait_classes if wait_classes else class_hints
        if cands:
            result.setdefault("wmClassCandidates", cands)
        if print_result:
            _eprint(f"forge launch: {result.get('error', 'wait failed')}")
            _print_json(result, compact=False)
        return 1, result

    if print_result:
        _print_json(result, compact=False)
    return 0, result


def _run_cli_step(backend: str, step: dict[str, Any], *, print_result: bool = False) -> dict[str, Any]:
    """Execute one CLI-only step; return result dict with ok bool."""
    op_raw = step.get("op") or step.get("action") or step.get("type")
    op = str(op_raw).strip().lower() if op_raw is not None else ""

    if op == "launch":
        fields = launch_fields_from_step(step)
        _rc, result = do_launch(backend, print_result=print_result, **fields)
        return result

    if op == "wait":
        ms = step.get("ms") if "ms" in step else step.get("timeout", 0)
        try:
            n = max(0, int(ms))
        except (TypeError, ValueError):
            return {"ok": False, "op": "wait", "error": f"invalid ms: {ms!r}"}
        time.sleep(n / 1000.0)
        return {"ok": True, "op": "wait", "ms": n}

    if op == "wait-window":
        wc = step.get("wmClass") or step.get("wm_class")
        if wc is None or str(wc).strip() == "":
            return {"ok": False, "op": "wait-window", "error": "wmClass required"}
        timeout = step.get("timeout") if "timeout" in step else step.get("timeoutMs")
        timeout_ms = int(timeout if timeout is not None else DEFAULT_LAUNCH_TIMEOUT_MS)
        first = bool(step.get("first", False))
        result = wait_for_wm_class(
            backend,
            str(wc).strip(),
            timeout_ms,
            first=first,
            baseline_ids=None,
            accept_any_new=False,
        )
        result = dict(result)
        result["op"] = "wait-window"
        return result

    return {"ok": False, "op": op or None, "error": f"unknown CLI op: {op!r}"}


def _partition_mixed_steps_layout(steps: Any) -> list[dict[str, Any]]:
    """Layout-only chunker (CLI forge run uses JS partitionMixedSteps)."""
    if not isinstance(steps, list):
        return []
    chunks: list[dict[str, Any]] = []
    for step in steps:
        op_raw = None
        if isinstance(step, dict):
            op_raw = step.get("op") or step.get("action") or step.get("type")
        op = str(op_raw).strip().lower() if op_raw is not None else ""
        kind = "cli" if op in CLI_ONLY_STEP_OPS else "extension"
        if chunks and chunks[-1]["kind"] == kind:
            chunks[-1]["steps"].append(step)
        else:
            chunks.append({"kind": kind, "steps": [step]})
    return chunks


def run_mixed_steps(
    backend: str,
    steps: list[Any],
    *,
    stop_on_error: bool = True,
    print_each: bool = False,
) -> tuple[int, dict[str, Any]]:
    """
    Partition mixed steps; run CLI ops here, extension chunks via DBus RunSteps.
    Returns (exit_code, aggregate JSON). Layout apply still uses this path.
    """
    chunks = _partition_mixed_steps_layout(steps)
    chunk_results: list[dict[str, Any]] = []
    all_ok = True
    step_index = 0

    for chunk in chunks:
        kind = chunk["kind"]
        csteps = chunk["steps"]
        if kind == "cli":
            cli_out: list[dict[str, Any]] = []
            for step in csteps:
                if not isinstance(step, dict):
                    r = {"ok": False, "error": "step must be an object", "index": step_index}
                    cli_out.append(r)
                    all_ok = False
                    if stop_on_error:
                        chunk_results.append({"kind": "cli", "ok": False, "results": cli_out})
                        return 1, {
                            "ok": False,
                            "stoppedAt": step_index,
                            "chunks": chunk_results,
                        }
                    step_index += 1
                    continue
                r = _run_cli_step(backend, step, print_result=print_each)
                r = dict(r)
                r.setdefault("index", step_index)
                cli_out.append(r)
                if not r.get("ok"):
                    all_ok = False
                    if stop_on_error:
                        chunk_results.append({"kind": "cli", "ok": False, "results": cli_out})
                        return 1, {
                            "ok": False,
                            "stoppedAt": step_index,
                            "chunks": chunk_results,
                        }
                step_index += 1
            chunk_results.append(
                {"kind": "cli", "ok": all(x.get("ok") for x in cli_out), "results": cli_out}
            )
        else:
            payload = {"steps": csteps, "stopOnError": stop_on_error}
            steps_json = json.dumps(payload, separators=(",", ":"), ensure_ascii=False)
            try:
                raw = call_method(backend, "RunSteps", steps_json)
                data = json.loads(raw)
            except Exception as e:
                all_ok = False
                chunk_results.append(
                    {
                        "kind": "extension",
                        "ok": False,
                        "error": str(e),
                        "stepIndexBase": step_index,
                    }
                )
                if stop_on_error:
                    return 1, {
                        "ok": False,
                        "stoppedAt": step_index,
                        "chunks": chunk_results,
                    }
                step_index += len(csteps)
                continue

            if not isinstance(data, dict):
                data = {"ok": False, "error": "invalid RunSteps response", "raw": raw}
            # Rebase indices for aggregate readability
            ext_results = data.get("results")
            if isinstance(ext_results, list):
                for er in ext_results:
                    if isinstance(er, dict) and isinstance(er.get("index"), int):
                        er["index"] = step_index + int(er["index"])
            ok = bool(data.get("ok"))
            if not ok:
                all_ok = False
            entry: dict[str, Any] = {
                "kind": "extension",
                "ok": ok,
                "results": ext_results if isinstance(ext_results, list) else [],
            }
            if "stoppedAt" in data and data["stoppedAt"] is not None:
                try:
                    entry["stoppedAt"] = step_index + int(data["stoppedAt"])
                except (TypeError, ValueError):
                    entry["stoppedAt"] = data["stoppedAt"]
            if data.get("error"):
                entry["error"] = data["error"]
            chunk_results.append(entry)
            if not ok and stop_on_error:
                stopped = entry.get("stoppedAt", step_index)
                return 1, {"ok": False, "stoppedAt": stopped, "chunks": chunk_results}
            step_index += len(csteps)

    return (0 if all_ok else 1), {"ok": all_ok, "chunks": chunk_results}


def _load_gdisplays(scene: str) -> int:
    """Shell out to gdisplays load <scene>. Exit ≠0 + install hint if missing."""
    if not shutil.which("gdisplays"):
        _eprint("forge layout: `gdisplays` not found (needed for profile displays)")
        _eprint("Install: install-gdisplays  (shellrc) or ensure gdisplays is on PATH")
        # fallback hint for distros without shellrc
        _eprint("# fallback: ensure shellrc bin or your gdisplays package is installed")
        return 127
    cmd = ["gdisplays", "load", scene]
    _eprint(f"forge layout: {' '.join(shlex.quote(c) for c in cmd)}")
    try:
        proc = subprocess.run(cmd, check=False)
    except OSError as e:
        _eprint(f"forge layout: gdisplays failed: {e}")
        return 1
    if proc.returncode != 0:
        _eprint(f"forge layout: gdisplays load {scene!r} exit {proc.returncode}")
    return int(proc.returncode)


def _layout_parse_tokens(
    tokens: list[str], args: argparse.Namespace
) -> tuple[str, Optional[str], list[str], bool, bool, bool, bool]:
    """
    Parse layout positional tokens + flags.

    Returns
      (action, name, run_tokens, dry_run, force_launch, clean, force_close).
    action: list | show | run | help | save
    name: set for show/save; None for run (use run_tokens).
    run_tokens: raw layout targets for action=run (bare and/or N:name / name@N).
    """
    dry_run = bool(getattr(args, "dry_run", False))
    force_launch = bool(getattr(args, "force_launch", False))
    clean = bool(getattr(args, "clean", False))
    force_close = bool(getattr(args, "force", False))
    if not tokens:
        return "help", None, [], dry_run, force_launch, clean, force_close

    head = tokens[0].strip()
    if head in ("help", "-h", "--help"):
        return "help", None, [], dry_run, force_launch, clean, force_close
    if head == "list":
        return "list", None, [], dry_run, force_launch, clean, force_close
    if head == "show":
        name = tokens[1].strip() if len(tokens) >= 2 else None
        return "show", name, [], dry_run, force_launch, clean, force_close
    if head == "save":
        name = tokens[1].strip() if len(tokens) >= 2 else None
        return "save", name, [], dry_run, force_launch, clean, force_close
    # Apply targets: remaining positionals (exclusive sequential XOR static).
    return "run", None, list(tokens), dry_run, force_launch, clean, force_close


def _layout_load_tree(
    backend: Optional[str], tree_file: Optional[str]
) -> dict[str, Any]:
    if tree_file:
        p = Path(tree_file).expanduser()
        if not p.is_file():
            raise FileNotFoundError(f"tree file not found: {p}")
        data = json.loads(p.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            raise ValueError("tree file must be a JSON object (GetTree forest)")
        return data
    if backend is None:
        raise RuntimeError("DBus backend required (or pass --tree-file)")
    raw = call_method(backend, "GetTree", '{"includeMeta":true}')
    data = json.loads(raw)
    if not isinstance(data, dict):
        raise ValueError("GetTree returned non-object")
    if data.get("error"):
        raise RuntimeError(str(data["error"]))
    return data


def _layout_target_workspace(forest: dict[str, Any]) -> int:
    """
    0-based workspace for layout apply/save.

    Live GetTree sets activeWorkspace. Offline --tree-file without meta → 0.
    """
    return active_workspace_from_forest(forest, default=0)


