#!/usr/bin/env python3
"""forge — tiling control CLI (DBus → Forge extension). Distinct from forge-ctl install manager."""

from __future__ import annotations

import argparse
import json
import os
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Optional

FORGE_VERSION = "fc2"
BUS_NAME = "org.gnome.Shell.Extensions.Forge"
OBJECT_PATH = "/org/gnome/Shell/Extensions/Forge"
INTERFACE = "org.gnome.Shell.Extensions.Forge"

# Methods that take string in-args (all return a single string).
_METHOD_IN_ARGS: dict[str, int] = {
    "Ping": 0,
    "GetTree": 1,
    "Focus": 1,
    "Swap": 2,
    "Move": 2,
    "PlaceNext": 1,
}

DEFAULT_LAUNCH_TIMEOUT_MS = 15000
HARD_DEPS = ("python3", "PyGObject (gi.repository.Gio) or gdbus")


def _eprint(*args: object) -> None:
    print(*args, file=sys.stderr)


def _check_deps() -> str:
    """Return backend 'gi' or 'gdbus', or exit 127."""
    try:
        import gi  # noqa: F401

        gi.require_version("Gio", "2.0")
        from gi.repository import Gio  # noqa: F401

        return "gi"
    except Exception:
        pass
    if shutil.which("gdbus"):
        return "gdbus"
    _eprint("forge: missing DBus client (needed to talk to the extension)")
    _eprint("Install: python3-gi  (preferred)")
    _eprint("# fallback: gdbus (glib2 / libglib2.0-bin)")
    _eprint("# Debian/Ubuntu: sudo apt install python3-gi")
    sys.exit(127)


def _call_gi(method: str, args: tuple = ()) -> str:
    import gi

    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    n = _METHOD_IN_ARGS.get(method)
    if n is None:
        raise ValueError(f"unknown method {method}")
    if n == 0:
        params = None
    elif n == 1:
        params = GLib.Variant("(s)", (args[0] if args else "",))
    elif n == 2:
        params = GLib.Variant("(ss)", (args[0] if len(args) > 0 else "", args[1] if len(args) > 1 else ""))
    else:
        raise ValueError(f"unsupported arity {n} for {method}")

    try:
        result = bus.call_sync(
            BUS_NAME,
            OBJECT_PATH,
            INTERFACE,
            method,
            params,
            GLib.VariantType("(s)"),
            Gio.DBusCallFlags.NONE,
            5000,
            None,
        )
    except GLib.Error as e:
        raise RuntimeError(str(e)) from e
    return result.unpack()[0]


def _call_gdbus(method: str, args: tuple = ()) -> str:
    import subprocess

    cmd = [
        "gdbus",
        "call",
        "--session",
        "--dest",
        BUS_NAME,
        "--object-path",
        OBJECT_PATH,
        "--method",
        f"{INTERFACE}.{method}",
    ]
    n = _METHOD_IN_ARGS.get(method)
    if n is None:
        raise ValueError(f"unknown method {method}")
    for i in range(n):
        cmd.append(args[i] if i < len(args) else "")
    try:
        proc = subprocess.run(cmd, check=False, capture_output=True, text=True, timeout=8)
    except FileNotFoundError as e:
        raise RuntimeError("gdbus not found") from e
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout or "").strip() or f"exit {proc.returncode}"
        raise RuntimeError(err)
    # gdbus prints e.g. ('{"ok":true}',) or with newlines
    out = (proc.stdout or "").strip()
    if out.startswith("(") and out.endswith(")"):
        # Single string arg: ('...',) — use ast for reliable parse when possible
        try:
            import ast

            tup = ast.literal_eval(out)
            if isinstance(tup, tuple) and len(tup) >= 1:
                return str(tup[0])
        except Exception:
            pass
        # Fallback: strip outer parens/quotes
        inner = out[1:-1].strip().rstrip(",")
        if inner.startswith("'") and inner.endswith("'"):
            return inner[1:-1].encode("utf-8").decode("unicode_escape")
        if inner.startswith('"') and inner.endswith('"'):
            return json.loads(inner)
    return out


def call_method(backend: str, method: str, *args: str) -> str:
    if backend == "gi":
        return _call_gi(method, args)
    return _call_gdbus(method, args)


def _print_json(data: Any, compact: bool) -> None:
    if compact:
        print(json.dumps(data, separators=(",", ":"), ensure_ascii=False))
    else:
        print(json.dumps(data, indent=2, ensure_ascii=False))


def _with_first(selector: str, first: bool) -> str:
    """If --first, wrap plain selector as JSON with first:true."""
    if not first:
        return selector
    s = selector.strip()
    if s.startswith("{"):
        try:
            obj = json.loads(s)
            if isinstance(obj, dict):
                obj["first"] = True
                return json.dumps(obj)
        except json.JSONDecodeError:
            pass
    return json.dumps({"selector": selector, "first": True})


def _cmd_result(backend: str, method: str, *dbus_args: str, label: str) -> int:
    try:
        raw = call_method(backend, method, *dbus_args)
    except Exception as e:
        _eprint(f"forge {label}: bus call failed (is the extension enabled?): {e}")
        return 1
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        print(raw)
        return 1
    if isinstance(data, dict) and data.get("error"):
        err = data["error"]
        _eprint(f"forge {label}: {err}")
        if data.get("candidates"):
            _print_json({"error": err, "candidates": data["candidates"]}, compact=False)
        elif data.get("which"):
            _print_json(data, compact=False)
        else:
            _print_json(data, compact=False)
        return 1
    _print_json(data, compact=False)
    if isinstance(data, dict) and data.get("ok") is True:
        return 0
    # Success payloads without ok (e.g. GetTree forest) already handled by callers
    if isinstance(data, dict) and "error" not in data:
        return 0
    return 1


def cmd_ping(backend: str, _args: argparse.Namespace) -> int:
    try:
        raw = call_method(backend, "Ping")
    except Exception as e:
        _eprint(f"forge ping: bus call failed (is the extension enabled?): {e}")
        return 1
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        print(raw)
        return 1
    _print_json(data, compact=False)
    if isinstance(data, dict) and data.get("ok") is True:
        return 0
    return 1


def cmd_tree(backend: str, args: argparse.Namespace) -> int:
    options: dict[str, Any] = {}
    if args.monitor is not None:
        options["monitor"] = args.monitor
    if args.workspace is not None:
        options["workspace"] = args.workspace
    if args.max_depth is not None:
        options["maxDepth"] = args.max_depth
    options_json = json.dumps(options)
    try:
        raw = call_method(backend, "GetTree", options_json)
    except Exception as e:
        _eprint(f"forge tree: bus call failed (is the extension enabled?): {e}")
        return 1
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        print(raw)
        return 1
    if isinstance(data, dict) and data.get("error"):
        _eprint(f"forge tree: {data['error']}")
        _print_json(data, compact=args.compact)
        return 1
    _print_json(data, compact=args.compact)
    return 0


def cmd_focus(backend: str, args: argparse.Namespace) -> int:
    sel = _with_first(args.selector, args.first)
    return _cmd_result(backend, "Focus", sel, label="focus")


def cmd_swap(backend: str, args: argparse.Namespace) -> int:
    a = _with_first(args.selector_a, args.first)
    b = _with_first(args.selector_b, args.first)
    return _cmd_result(backend, "Swap", a, b, label="swap")


def cmd_move(backend: str, args: argparse.Namespace) -> int:
    tile = _with_first(args.tile, args.first)
    dest = _with_first(args.dest, args.first)
    return _cmd_result(backend, "Move", tile, dest, label="move")


def _xdg_data_dirs() -> list[str]:
    dirs: list[str] = []
    home = Path.home()
    dirs.append(str(home / ".local" / "share"))
    xdg = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share")
    for part in xdg.split(":"):
        part = part.strip()
        if part and part not in dirs:
            dirs.append(part)
    return dirs


def resolve_desktop_file(app: str) -> Optional[str]:
    """Return absolute path to a .desktop file, or None."""
    app = app.strip()
    if not app:
        return None
    p = Path(app).expanduser()
    if p.is_file() and p.suffix == ".desktop":
        return str(p.resolve())

    name = app if app.endswith(".desktop") else f"{app}.desktop"
    # Flatpak-style ids may include path segments; only basename search here.
    base = Path(name).name
    for data in _xdg_data_dirs():
        candidate = Path(data) / "applications" / base
        if candidate.is_file():
            return str(candidate.resolve())
    return None


def launch_app(app: str) -> subprocess.Popen:
    """
    Start an app out-of-process.
    Prefer gio launch / gtk-launch for .desktop ids; else spawn argv.
    """
    desktop = resolve_desktop_file(app)
    if desktop:
        if shutil.which("gio"):
            return subprocess.Popen(
                ["gio", "launch", desktop],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        if shutil.which("gtk-launch"):
            did = Path(desktop).stem
            return subprocess.Popen(
                ["gtk-launch", did],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        # Last resort: desktop file path is not executable — try gtk-launch-less gio
        raise RuntimeError(
            f"found desktop file {desktop} but neither gio nor gtk-launch is on PATH"
        )

    # Executable on PATH or absolute path / shell-ish argv
    argv = shlex.split(app)
    if not argv:
        raise RuntimeError("empty app command")
    exe = argv[0]
    if not os.path.isabs(exe) and not shutil.which(exe):
        raise RuntimeError(
            f"app not found as desktop id or executable: {app!r} "
            f"(tried *.desktop under XDG applications and PATH)"
        )
    return subprocess.Popen(
        argv,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def _iter_tree_windows(node: Any) -> list[dict[str, Any]]:
    """Collect WINDOW dicts from a GetTree forest/node."""
    out: list[dict[str, Any]] = []

    def walk(n: Any) -> None:
        if not isinstance(n, dict):
            return
        ntype = n.get("nodeType") or n.get("type")
        if ntype == "WINDOW":
            out.append(n)
        kids = n.get("children") or n.get("childNodes") or []
        if isinstance(kids, list):
            for c in kids:
                walk(c)

    if isinstance(node, dict):
        if "monitors" in node and isinstance(node["monitors"], list):
            for m in node["monitors"]:
                walk(m)
        else:
            walk(node)
    elif isinstance(node, list):
        for m in node:
            walk(m)
    return out


def _windows_matching_class(forest: Any, wm_class: str) -> list[dict[str, Any]]:
    want = wm_class
    hits = []
    for w in _iter_tree_windows(forest):
        cls = w.get("wmClass") or w.get("wm_class")
        if cls == want:
            hits.append(w)
    return hits


def wait_for_wm_class(
    backend: str,
    wm_class: str,
    timeout_ms: int,
    *,
    first: bool,
    baseline_ids: Optional[set[str]] = None,
) -> dict[str, Any]:
    """
    Poll GetTree until a window with wmClass appears (or timeout).
    Prefer windows whose windowId was not in baseline_ids when provided.
    """
    deadline = time.monotonic() + max(0, timeout_ms) / 1000.0
    baseline_ids = baseline_ids or set()
    last_err = "timeout"
    while time.monotonic() <= deadline:
        try:
            raw = call_method(backend, "GetTree", "{}")
            data = json.loads(raw)
        except Exception as e:
            last_err = str(e)
            time.sleep(0.15)
            continue
        if isinstance(data, dict) and data.get("error"):
            last_err = str(data["error"])
            time.sleep(0.15)
            continue
        hits = _windows_matching_class(data, wm_class)
        # Prefer newly appeared ids
        fresh = [
            h
            for h in hits
            if h.get("windowId") is None or str(h.get("windowId")) not in baseline_ids
        ]
        pool = fresh if fresh else hits
        if pool:
            if len(pool) > 1 and not first:
                # Still success for launch: pick first but note multi
                chosen = pool[0]
            else:
                chosen = pool[0]
            return {
                "ok": True,
                "windowId": chosen.get("windowId"),
                "title": chosen.get("title"),
                "wmClass": chosen.get("wmClass") or wm_class,
                "path": chosen.get("path"),
            }
        time.sleep(0.12)
    return {"ok": False, "error": f"wait timeout after {timeout_ms}ms ({last_err})", "wmClass": wm_class}


def _baseline_window_ids(backend: str) -> set[str]:
    try:
        raw = call_method(backend, "GetTree", "{}")
        data = json.loads(raw)
    except Exception:
        return set()
    if isinstance(data, dict) and data.get("error"):
        return set()
    ids: set[str] = set()
    for w in _iter_tree_windows(data):
        wid = w.get("windowId")
        if wid is not None:
            ids.add(str(wid))
    return ids


def cmd_launch(backend: str, args: argparse.Namespace) -> int:
    app = (args.app or "").strip()
    if not app:
        _eprint("forge launch: app required")
        return 1

    wm_class = args.wm_class
    timeout_ms = int(args.timeout if args.timeout is not None else DEFAULT_LAUNCH_TIMEOUT_MS)
    no_wait = bool(args.no_wait)
    monitor = args.monitor
    tree_path = args.tree_path
    first = bool(getattr(args, "first", False))

    place_opts: dict[str, Any] = {}
    if monitor is not None and str(monitor).strip() != "":
        place_opts["monitor"] = monitor
    if tree_path is not None and str(tree_path).strip() != "":
        place_opts["treePath"] = tree_path
    if wm_class:
        place_opts["wmClass"] = wm_class
    if first:
        place_opts["first"] = True
    # Align hint TTL with wait timeout when placing
    if place_opts and ("monitor" in place_opts or "treePath" in place_opts):
        place_opts["ttlMs"] = max(timeout_ms, DEFAULT_LAUNCH_TIMEOUT_MS)

    if place_opts and ("monitor" in place_opts or "treePath" in place_opts):
        try:
            raw = call_method(backend, "PlaceNext", json.dumps(place_opts))
            data = json.loads(raw)
        except Exception as e:
            _eprint(f"forge launch: PlaceNext failed (is the extension enabled?): {e}")
            return 1
        if not isinstance(data, dict) or data.get("ok") is not True:
            err = data.get("error") if isinstance(data, dict) else raw
            _eprint(f"forge launch: PlaceNext error: {err}")
            if isinstance(data, dict):
                _print_json(data, compact=False)
            return 1

    baseline: set[str] = set()
    if not no_wait:
        if not wm_class:
            _eprint(
                "forge launch: --wm-class required when waiting "
                "(or pass --no-wait). Example: --wm-class=Google-chrome"
            )
            return 1
        baseline = _baseline_window_ids(backend)

    try:
        proc = launch_app(app)
    except Exception as e:
        _eprint(f"forge launch: failed to start {app!r}: {e}")
        return 1

    if no_wait:
        _print_json({"ok": True, "pid": proc.pid, "waited": False}, compact=False)
        return 0

    result = wait_for_wm_class(
        backend,
        wm_class,
        timeout_ms,
        first=first,
        baseline_ids=baseline,
    )
    if not result.get("ok"):
        _eprint(f"forge launch: {result.get('error', 'wait failed')}")
        _print_json(result, compact=False)
        return 1
    result["pid"] = proc.pid
    result["waited"] = True
    _print_json(result, compact=False)
    return 0


_SELECTOR_HELP = """\
Tile selectors:
  focus | lft
  title:Exact | title~=substr | title~=/regex/flags?
  class:WmClass | class:WmClass@mon
  path:mo0ws0/0/1   (mon then child indices; cN/wN ok)
  id:WINDOW_ID
  JSON: '{"selector":"class:Foo","first":true}'
"""


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="forge",
        description=(
            "Forge tiling control CLI (DBus). Distinct from forge-ctl (install/migrate).\n"
            "\n"
            "Hard dependencies:\n"
            "  - python3\n"
            "  - python3-gi (PyGObject)  OR  gdbus\n"
            "  - Forge extension enabled (org.gnome.Shell.Extensions.Forge on session bus)\n"
            "\n"
            f"{_SELECTOR_HELP}"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--version", action="version", version=f"forge {FORGE_VERSION}")
    p.add_argument(
        "--first",
        action="store_true",
        help="On ambiguous match, use the first candidate (also per-subcommand)",
    )
    sub = p.add_subparsers(dest="command", required=True)

    ping = sub.add_parser("ping", help="Ping extension DBus; print health JSON")
    ping.set_defaults(func=cmd_ping)

    tree = sub.add_parser("tree", help="Dump tiling forest as JSON")
    tree.add_argument(
        "--monitor",
        metavar="ID|INDEX",
        help="Filter by monitor index, moNwsW id, or stableKey",
    )
    tree.add_argument(
        "--workspace",
        type=int,
        metavar="N",
        help="Filter by workspace index",
    )
    tree.add_argument(
        "--max-depth",
        type=int,
        metavar="N",
        dest="max_depth",
        help="Cap tree projection depth",
    )
    tree.add_argument(
        "--compact",
        action="store_true",
        help="Single-line JSON (default is pretty)",
    )
    tree.set_defaults(func=cmd_tree)

    focus = sub.add_parser("focus", help="Focus a tile by selector")
    focus.add_argument("selector", help="Tile selector (see main --help)")
    focus.add_argument(
        "--first",
        action="store_true",
        help="Use first match when ambiguous",
    )
    focus.set_defaults(func=cmd_focus)

    swap = sub.add_parser("swap", help="Swap two tiles")
    swap.add_argument("selector_a", help="First tile selector")
    swap.add_argument("selector_b", help="Second tile selector")
    swap.add_argument(
        "--first",
        action="store_true",
        help="Use first match when ambiguous",
    )
    swap.set_defaults(func=cmd_swap)

    move = sub.add_parser(
        "move",
        help="Move tile to dest (window: insert after; path CON/MONITOR: append)",
    )
    move.add_argument("tile", help="Source tile selector")
    move.add_argument("dest", help="Dest selector (window or path to CON/MONITOR)")
    move.add_argument(
        "--first",
        action="store_true",
        help="Use first match when ambiguous",
    )
    move.set_defaults(func=cmd_move)

    launch = sub.add_parser(
        "launch",
        help="Launch app (gio launch / spawn) and optionally PlaceNext + wait",
        description=(
            "Launch a desktop id or command. Default placement uses OP1 LFT "
            "attach (no PlaceNext). Pass --monitor and/or --tree-path to set a "
            "one-shot place hint before spawn. Already-mapped windows: use "
            "`forge move` after wait instead of PlaceNext.\n"
            "\n"
            "Deps: python3, python3-gi|gdbus; gio or gtk-launch for .desktop; "
            "extension enabled for PlaceNext/wait."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    launch.add_argument(
        "app",
        help="Desktop id (e.g. google-chrome.desktop / org.foo.Bar) or command",
    )
    launch.add_argument(
        "--wm-class",
        dest="wm_class",
        metavar="CLASS",
        help="wm_class to match for wait / PlaceNext (required unless --no-wait)",
    )
    launch.add_argument(
        "--timeout",
        type=int,
        default=DEFAULT_LAUNCH_TIMEOUT_MS,
        metavar="MS",
        help=f"Wait timeout in ms (default {DEFAULT_LAUNCH_TIMEOUT_MS})",
    )
    launch.add_argument(
        "--no-wait",
        action="store_true",
        help="Do not wait for the window to appear",
    )
    launch.add_argument(
        "--monitor",
        metavar="INDEX|moN|stableKey|primary",
        help="Explicit home monitor for PlaceNext (optional)",
    )
    launch.add_argument(
        "--tree-path",
        dest="tree_path",
        metavar="PATH",
        help="Attach path (path:mo0ws0/0 or mo0ws0/0) for PlaceNext",
    )
    launch.add_argument(
        "--last-focused",
        action="store_true",
        help="Default attach after LFT (OP1); no-op — documented default",
    )
    launch.add_argument(
        "--first",
        action="store_true",
        help="When waiting, accept first matching class if several",
    )
    launch.set_defaults(func=cmd_launch)

    return p


def main(argv: Optional[list[str]] = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    # Allow `forge --help` without DBus deps
    if not argv or argv[0] in ("-h", "--help", "--version"):
        parser = build_parser()
        if argv and argv[0] == "--version":
            print(f"forge {FORGE_VERSION}")
            return 0
        parser.print_help()
        return 0

    # Global --first before subcommand: forge --first focus 'class:Foo'
    global_first = False
    pre: list[str] = []
    rest: list[str] = []
    seen_cmd = False
    for a in argv:
        if not seen_cmd and a == "--first":
            global_first = True
            continue
        if not seen_cmd and not a.startswith("-"):
            seen_cmd = True
        if seen_cmd:
            rest.append(a)
        else:
            pre.append(a)
    argv = pre + rest

    parser = build_parser()
    args = parser.parse_args(argv)
    if global_first:
        args.first = True
    elif not hasattr(args, "first"):
        args.first = False
    backend = _check_deps()
    return int(args.func(backend, args))


if __name__ == "__main__":
    sys.exit(main())
