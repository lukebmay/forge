def _load_steps_payload(raw: str) -> Any:
    """Parse JSON steps payload (array or {steps,...})."""
    try:
        return json.loads(raw)
    except json.JSONDecodeError as e:
        raise ValueError(f"invalid JSON: {e}") from e


def _payload_has_cli_only(payload: Any) -> list[str]:
    """Return CLI-only op names found in a steps payload (if any)."""
    steps: list[Any]
    if isinstance(payload, list):
        steps = payload
    elif isinstance(payload, dict) and isinstance(payload.get("steps"), list):
        steps = payload["steps"]
    else:
        return []
    found: list[str] = []
    for s in steps:
        if not isinstance(s, dict):
            continue
        op = s.get("op") or s.get("action") or s.get("type")
        if op is None:
            continue
        name = str(op).strip().lower()
        if name in CLI_ONLY_STEP_OPS and name not in found:
            found.append(name)
    return found


def _layout_ping_payload(backend: str) -> dict[str, Any]:
    """Best-effort Ping JSON for ApplyLayout feature detect."""
    try:
        raw = call_method(backend, "Ping")
        data = json.loads(raw) if isinstance(raw, str) else raw
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _layout_profile_for_apply(data: Any) -> Any:
    """Bare-array sugar → object (ApplyLayout rejects top-level arrays)."""
    if isinstance(data, list):
        return {"tiles": data}
    return data


def _layout_run_reconcile_apply_layout(
    backend: str,
    resolved: dict[str, Any],
    data: dict[str, Any],
    *,
    name: str,
    workspace: int,
    clean: bool,
    keep_others: bool,
    force_close: bool,
    safe: bool,
    verbose: bool,
    wait_tree_stable: bool,
) -> int:
    """Product path: ApplyLayout + Progress/Done (extension owns spine)."""
    request = build_apply_layout_request(
        profile=_layout_profile_for_apply(data),
        name=name,
        workspace=workspace,
        host_job_id=host_job_id_from_env(),
        flags={
            "clean": clean,
            "keepOthers": keep_others,
            "safe": safe,
            "forceClose": force_close,
            "waitTreeStable": wait_tree_stable,
        },
    )
    if verbose:
        _eprint("  path=ApplyLayout")

    def apply_fn(req_json: str) -> dict[str, Any]:
        return parse_json_obj(call_method(backend, "ApplyLayout", req_json))

    def get_fn(apply_id: str) -> dict[str, Any]:
        return parse_json_obj(call_method(backend, "GetLayoutApply", str(apply_id)))

    def cancel_fn(apply_id: str) -> dict[str, Any]:
        return parse_json_obj(
            call_method(backend, "CancelLayoutApply", str(apply_id))
        )

    rc, done = run_apply_layout_client(
        request=request,
        apply_fn=apply_fn,
        get_fn=get_fn,
        cancel_fn=cancel_fn,
        print_fn=_eprint,
        write_apply_id_fn=write_job_apply_id,
        start_watcher_fn=start_gi_signal_watcher,
        timeout_s=float(default_timeout_for_command("layout") or 300),
        verbose=verbose,
    )
    if rc == 0 and not verbose:
        _eprint("forge layout: ok")
    if rc != 0 or verbose:
        out: dict[str, Any] = {
            "ok": isinstance(done, dict) and done.get("ok") is True,
            "name": name,
            "path": str(resolved.get("path") or ""),
            "source": resolved.get("source"),
            "host": resolved.get("host"),
            "mode": MODE_RECONCILE,
            "workspace": workspace,
            "applyId": (done or {}).get("applyId") if isinstance(done, dict) else None,
            "phase": (done or {}).get("phase") if isinstance(done, dict) else None,
            "done": done,
        }
        if isinstance(done, dict):
            if done.get("error") is not None:
                out["error"] = done.get("error")
            if done.get("code") is not None:
                out["code"] = done.get("code")
        _layout_maybe_print_json(out, verbose=verbose, force=rc != 0)
    return int(rc)


def _layout_run_reconcile(
    backend: Optional[str],
    resolved: dict[str, Any],
    data: dict[str, Any],
    *,
    dry_run: bool,
    tree_file: Optional[str],
    clean: bool = True,
    keep_others: bool = False,
    force_close: bool = False,
    safe: bool = False,
    verbose: bool = False,
    workspace: Optional[int] = None,
    forest: Optional[dict[str, Any]] = None,
    wait_tree_stable: bool = False,
) -> int:
    """
    Plan/apply one reconcile profile on a target workspace.

    Live: ApplyLayout (AL8). Dry-run / --tree-file: host GetTree + plan only.
    """
    name = resolved["name"]
    try:
        profile = validate_reconcile_profile(data)
    except ValueError as e:
        _eprint(f"forge layout: {e}")
        return 1

    rc = _layout_optional_preamble(backend, profile, dry_run=dry_run)
    if rc != 0:
        return rc

    if forest is None or workspace is None:
        needs_bus = not tree_file
        if needs_bus and backend is None:
            backend = _check_deps()
        if forest is None:
            try:
                forest = _layout_load_tree(backend, tree_file)
            except Exception as e:
                _eprint(f"forge layout: GetTree failed: {e}")
                return 1
    if workspace is None:
        workspace = _layout_target_workspace(forest)
    current_ws = _layout_target_workspace(forest)

    # Header/context: dry-run always; live apply only with -v.
    show_context = bool(verbose or dry_run or tree_file)
    if show_context:
        _layout_print_header(resolved, name)
        cur_bit = " (current)" if workspace == current_ws else ""
        _eprint(f"  workspace  {workspace + 1}{cur_bit}")
        if safe:
            _eprint("  residuals=leave (--safe: open+move only)")
        elif keep_others:
            _eprint("  residuals=park (--keep-others: join last mon unit as tabs)")
        else:
            force_bit = " --force" if force_close else ""
            _eprint(f"  residuals=close{force_bit} (default; non-layout windows closed)")

    if not dry_run and not tree_file:
        if backend is None:
            backend = _check_deps()
        ping = _layout_ping_payload(backend)
        if ping_supports_apply_layout(ping):
            return _layout_run_reconcile_apply_layout(
                backend,
                resolved,
                data,
                name=name,
                workspace=int(workspace),
                clean=clean,
                keep_others=keep_others,
                force_close=force_close,
                safe=safe,
                verbose=verbose,
                wait_tree_stable=wait_tree_stable,
            )
        _eprint(
            f"forge layout: ApplyLayout requires apiVersion "
            f"{APPLY_LAYOUT_MIN_API}+ (got {ping.get('apiVersion')!r})"
        )
        _eprint("  hint: ./install --kit=vim then reload the extension tip")
        return 1

    try:
        plan = plan_reconcile(
            forest,
            data,
            clean=clean,
            keep_others=keep_others,
            safe=safe,
            workspace=workspace,
        )
    except ValueError as e:
        _eprint(f"forge layout: plan failed: {e}")
        return 1

    on_n, ignored = window_candidate_counts(forest, workspace)
    _eprint(
        "  "
        + format_candidate_line(
            workspace + 1,
            on_n,
            ignored,
            is_current=workspace == current_ws,
        )
    )
    _layout_print_thrash_mode(plan, safe=safe)
    counts = plan.get("counts") or {}
    _layout_print_counts(counts)
    _layout_print_thrash_state(plan)
    _layout_print_thrash_risk(plan)

    if plan.get("nothingToDo"):
        n = int(counts.get("reused") or 0)
        left_n = int(counts.get("left") or 0)
        left_bit = f", {left_n} residual left in place" if left_n else ""
        _eprint(f"forge layout: nothing to do ({n} roles satisfied{left_bit})")
        _layout_maybe_print_json(
            _layout_plan_meta(resolved, name, plan, dry_run=dry_run),
            verbose=verbose,
        )
        return 0

    _eprint(
        "  dry-run (no changes)" if dry_run else "  plan-only (--tree-file; no apply)"
    )
    _layout_maybe_print_json(
        _layout_plan_meta(resolved, name, plan, dry_run=True),
        verbose=verbose,
        force=True,
    )
    return 0


