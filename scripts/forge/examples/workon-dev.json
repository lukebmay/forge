{
  "version": 1,
  "description": "Dual-mon: left Chrome(luke)+Grok | Ghostty; right Ghostty | YT+Gmail+Voice",
  "stopOnError": true,
  "steps": [
    {
      "op": "launch",
      "app": "google-chrome",
      "monitor": "0",
      "path": "mo0ws0",
      "wmClass": "Google-chrome",
      "timeout": 25000
    },
    { "op": "wait", "ms": 500 },
    {
      "op": "layout",
      "mode": "tabbed",
      "selector": "focus"
    },
    {
      "op": "launch",
      "app": "Grok",
      "wmClass": "Google-chrome",
      "timeout": 25000
    },
    {
      "op": "launch",
      "app": "ghostty",
      "monitor": "0",
      "path": "mo0ws0",
      "timeout": 15000
    },
    {
      "op": "launch",
      "app": "ghostty",
      "monitor": "1",
      "path": "mo1ws0",
      "timeout": 15000
    },
    {
      "op": "launch",
      "app": "YouTube",
      "monitor": "1",
      "path": "mo1ws0",
      "wmClass": "Google-chrome",
      "timeout": 25000
    },
    { "op": "wait", "ms": 500 },
    {
      "op": "layout",
      "mode": "tabbed",
      "selector": "focus"
    },
    {
      "op": "launch",
      "app": "Gmail",
      "wmClass": "Google-chrome",
      "timeout": 25000
    },
    {
      "op": "launch",
      "app": "Google Voice",
      "wmClass": "Google-chrome",
      "timeout": 25000
    }
  ]
}
