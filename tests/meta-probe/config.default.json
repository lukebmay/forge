{
  "version": 4,
  "probeVersion": "0.3.0",
  "phase": "full-suite",
  "suite": "full-suite",
  "samples": 10,
  "recordDetail": "summary",
  "matrix": {
    "calibrateEachOp": true,
    "comment": "Each app+op: 1 calibration then samples full trials. Ops never interleave."
  },
  "settle": {
    "comment": "Agreement-only: check every checkIntervalMs. Hard d_* resets stable duration; soft s_* recorded only. Settled when hard-stable for settleDurationMs. See AGREEMENT.md.",
    "checkIntervalMs": 100,
    "settleDurationMs": 3000,
    "calibrationCheckIntervalMs": 50,
    "bootstrapCheckIntervalMs": 50,
    "bootstrapSettleDurationMs": 10000,
    "maxWaitMs": 120000,
    "noteSlowHosts": "Slow machines → longer settleDurationMs after bootstrap (more jitter spacing), never shorter."
  },
  "cooldownMs": 500,
  "betweenAppsMs": 2000,
  "open": {
    "mapMaxWaitMs": 120000,
    "postMapSettle": true
  },
  "workspace": {
    "preferIndex": 3,
    "returnIndex": 0,
    "comment": "preferIndex=test desk. returnIndex=WS1 only when measurement finishes (never mid-run)."
  },
  "safety": {
    "requireForgeDisabled": true,
    "requireRivalsDisabled": true,
    "closeAfterApp": true,
    "onlyTouchOwnedWindows": true,
    "rivalUuids": [
      "tiling-assistant@ubuntu.com",
      "tiling-assistant@leleat-on-github",
      "pop-shell@system76.com",
      "paperwm@paperwm.github.com",
      "tilingshell@ferrarodomenico.com",
      "gTile@vibou",
      "gSnap@micahosborne",
      "winTile@nowsci.com",
      "shelltile@emasab.it",
      "material-shell@papyelgringo",
      "tactile@lundalomer.github.com"
    ]
  },
  "hosts": {
    "black": "daily dual-4K Shell 46",
    "gray": "laptop ~2018",
    "green": "desktop ~2012"
  },
  "output": {
    "dir": "results",
    "writeLatestSymlink": true,
    "namespace": true,
    "writeOnlyAtEnd": true,
    "comment": "results/<host>/<session>/<suite>/ — single write after matrix"
  },
  "suites": {
    "calibration": {
      "phase": "calibration",
      "samples": 0,
      "comment": "Cal denseness only (bootstrap 10s then derived); samples=0 means no full 10×"
    },
    "full-suite": {
      "phase": "full-suite",
      "samples": 10
    },
    "pilot": {
      "phase": "pilot",
      "samples": 2
    },
    "strict": {
      "phase": "strict",
      "samples": 10,
      "settle": {
        "settleDurationMs": 5000,
        "checkIntervalMs": 50,
        "bootstrapSettleDurationMs": 10000
      }
    }
  },
  "pilot": {
    "stages": [
      { "id": "stage1-nautilus", "apps": ["nautilus"], "samples": 2 },
      { "id": "stage2-ghostty", "apps": ["ghostty"], "samples": 2 },
      { "id": "stage3-inkscape", "apps": ["inkscape"], "samples": 2 }
    ]
  }
}
