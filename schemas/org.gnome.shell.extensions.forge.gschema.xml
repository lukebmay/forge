<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
    <schema id="org.gnome.shell.extensions.forge" path="/org/gnome/shell/extensions/forge/">
        <!-- Main Settings -->
        <key type="b" name="focus-border-toggle">
            <default>true</default>
            <summary>Show window border on focused window</summary>
        </key>

        <key type="b" name="split-border-toggle">
            <default>true</default>
            <summary>Show split direction border on focused window</summary>
        </key>

        <key type="u" name="window-gap-size">
            <default>4</default>
            <summary>
                The size of the gap between windows in the workarea
            </summary>
        </key>

        <key type="u" name="resize-amount">
            <default>15</default>
            <summary>
                The window resize increment/decrement in pixels
            </summary>
        </key>

        <key type="u" name="window-gap-size-increment">
            <default>1</default>
            <summary>
                The size increment of the gaps. size-increment * gap-size
            </summary>
        </key>

        <key type="u" name="window-margin-top">
            <default>0</default>
            <summary>Extra margin at top of screen (for auto-hide panels)</summary>
        </key>

        <key type="u" name="window-margin-bottom">
            <default>0</default>
            <summary>Extra margin at bottom of screen (for auto-hide docks)</summary>
        </key>

        <key type="u" name="window-margin-left">
            <default>0</default>
            <summary>Extra margin at left of screen</summary>
        </key>

        <key type="u" name="window-margin-right">
            <default>0</default>
            <summary>Extra margin at right of screen</summary>
        </key>

        <key type="b" name="window-gap-hidden-on-single">
            <default>false</default>
            <summary>Hide gap when single window toggle</summary>
        </key>

        <key type="b" name="focus-border-hidden-on-single">
            <default>false</default>
            <summary>Hide focus border when single window toggle</summary>
        </key>

        <key type="b" name="window-maximize-on-single">
            <default>false</default>
            <summary>Maximize window when it is the only one on workspace</summary>
        </key>

        <key type="s" name="default-window-layout">
            <default>'tiled'</default>
            <summary>Default layout for new containers: tiled, tabbed, stacked</summary>
        </key>

        <key type="b" name="tiling-mode-enabled">
            <default>true</default>
            <summary>Tiling mode on/off</summary>
        </key>

        <key type="b" name="quick-settings-enabled">
            <default>true</default>
            <summary>Forge quick settings toggle</summary>
        </key>

        <key type="b" name="tray-icon-enabled">
            <default>true</default>
            <summary>Show tray icon in top bar</summary>
        </key>

        <key type="s" name="workspace-skip-tile">
            <default>''</default>
            <summary>Skips tiling on the provided workspace indices</summary>
        </key>

        <key type="s" name="monitor-skip-tile">
            <default>''</default>
            <summary>Skips tiling on the provided monitor indices</summary>
        </key>

        <key type="b" name="stacked-tiling-mode-enabled">
            <default>true</default>
            <summary>Stacked tiling mode on/off</summary>
        </key>

        <key type="b" name="tabbed-tiling-mode-enabled">
            <default>true</default>
            <summary>Tabbed tiling mode on/off</summary>
        </key>

        <!-- Development Settings -->
        <key type="u" name="log-level">
            <default>0</default>
            <summary>
                Provide log4j-like logging levels:
                0 - OFF
                1 - FATAL
                2 - ERROR
                3 - WARN
                4 - INFO
                5 - DEBUG
                6 - TRACE
                7 - ALL
            </summary>
        </key>
        <key type="b" name="logging-enabled">
            <default>false</default>
            <summary>Enable logging</summary>
        </key>

        <key type="b" name="layout-debug-overlay-enabled">
            <default>false</default>
            <summary>Show per-window layout debug overlay (parent layout, percent, monitor id)</summary>
        </key>

        <key type="u" name="layout-verify-interval-ms">
            <default>0</default>
            <summary>Debug: periodic Meta↔slot verify interval in ms (0 = off; production stays event-driven)</summary>
            <description>
                When greater than zero, schedules a repeating requestVerify("periodic").
                Default 0 keeps layout verify event-driven only. Intended for debug, not daily use.
            </description>
        </key>

        <key type="s" name="css-updated">
            <default>''</default>
            <summary>Timestamp when css is last updated. Also triggers reload of St</summary>
        </key>

        <key type="u" name="css-last-update">
            <default>1</default>
        </key>

        <key type="s" name="dnd-center-layout">
            <default>'tabbed'</default>
            <summary>
                The default center layout when dragging/dropping a window.
                The values are `tabbed` and `stacked`.
            </summary>
        </key>
        <key type="b" name="move-pointer-focus-enabled">
            <default>false</default>
            <summary>Move the pointer when focusing or swapping via kbd</summary>
        </key>
        <key type="b" name="focus-on-hover-enabled">
            <default>false</default>
            <summary>Focus switches to the window under the pointer.</summary>
        </key>
        <key type="b" name="float-always-on-top-enabled">
            <default>false</default>
            <summary>Floating windows toggle always-on-top</summary>
        </key>
        <key type="b" name="auto-exit-tabbed">
            <default>true</default>
            <summary>Exit tabbed tiling mode when only a single tab remains</summary>
        </key>
        <key type="b" name="auto-reorient-on-close">
            <default>false</default>
            <summary>Re-orient a split container by its aspect ratio when a child window closes</summary>
            <description>When enabled, closing a window in a split container flips its orientation (horizontal/vertical) to match the container's current shape. This overrides a manually chosen split-vertical/split-horizontal orientation, so it is off by default.</description>
        </key>
        <key type="b" name="auto-split-enabled">
            <default>false</default>
            <summary>Enable auto split or quarter-tiling based based on smaller side</summary>
        </key>
        <key type="b" name="tiny-pane-tab-fallback-enabled">
            <default>false</default>
            <summary>On open-app aspect split, join as tabs when panes would be too small</summary>
            <description>When auto-split is on, if a 50/50 split of the last focused tile would make either child narrower or shorter than the min-edge threshold, create or join a tab group instead. Off by default.</description>
        </key>
        <key type="u" name="tiny-pane-min-edge">
            <default>320</default>
            <summary>Minimum pane edge (px) before open-app prefers tabs over split</summary>
            <description>Used with ~12% of the monitor workarea min edge and app min-size. Only applies when tiny-pane-tab-fallback-enabled is on.</description>
        </key>
        <key type="b" name="disable-edge-tiling">
            <default>true</default>
            <summary>Disable GNOME's built-in edge/half-tiling while Forge is enabled</summary>
        </key>
        <key type="s" name="new-window-size-policy">
            <choices>
                <choice value="preserve"/>
                <choice value="equalize"/>
            </choices>
            <default>'preserve'</default>
            <summary>
                When a new tiled window is added and siblings already have
                user-resized sizes: preserve keeps relative proportions
                (carve 1/(n+1) for the newcomer); equalize re-equalizes all.
                Until any sibling is user-resized, new windows always equalize.
            </summary>
        </key>
        <key type="s" name="new-window-placement">
            <choices>
                <choice value="pointer"/>
                <choice value="window-actual"/>
            </choices>
            <default>'pointer'</default>
            <summary>Generic open monitor: 'pointer' follows last focused tile (OP1; id kept for configs); 'window-actual' uses the window's own monitor. Dock sticky mon wins when a dock launch is detected.</summary>
        </key>
        <key type="b" name="preview-hint-enabled">
            <default>false</default>
            <summary>Whether to show preview hint DND</summary>
        </key>
        <key type="b" name="showtab-decoration-enabled">
            <default>true</default>
            <summary>Whether to show the tab decoration or not</summary>
        </key>

        <key type="u" name="window-overrides-reload-trigger">
            <default>0</default>
            <summary>Timestamp to trigger window overrides reload</summary>
        </key>

        <key type="u" name="focus-border-radius">
            <default>14</default>
            <summary>The border radius of focus borders in pixels</summary>
        </key>

        <key type="u" name="tabbed-tab-margin">
            <default>1</default>
            <summary>The margin between tabs in tabbed mode (pixels)</summary>
        </key>

        <key type="u" name="stacked-tab-bar-height">
            <range min="1" max="200"/>
            <default>35</default>
            <summary>Height of each stacked/tabbed title bar (pixels). Minimum 1; 0 would collide with the hidden-decoration path.</summary>
        </key>

        <key type="u" name="max-tabs-per-line">
            <default>0</default>
            <summary>Max tab labels per row in tabbed mode (0 = unlimited single row; wrap into more rows when set).</summary>
        </key>

        <key type="s" name="tab-position">
            <choices>
                <choice value="top"/>
                <choice value="bottom"/>
            </choices>
            <default>"top"</default>
            <summary>Position of the stacked/tabbed title bar within its container (top or bottom).</summary>
        </key>

        <key type="b" name="auto-unmaximize-for-tiling">
            <default>true</default>
            <summary>Automatically unmaximize windows when a new window is tiled alongside</summary>
        </key>

        <key type="b" name="focus-on-hover-tiling-only">
            <default>false</default>
            <summary>Only enable hover-to-focus when tiling mode is active</summary>
        </key>

        <key type="s" name="launch-app-command">
            <default>'gnome-terminal'</default>
            <summary>Application to launch with hotkey</summary>
        </key>

        <!-- Portable Config Sync Settings -->
        <key type="t" name="config-last-import">
            <default>0</default>
            <summary>Timestamp of last config file import (Unix epoch in seconds)</summary>
        </key>

        <key type="t" name="config-last-export">
            <default>0</default>
            <summary>Timestamp of last config file export (Unix epoch in seconds)</summary>
        </key>

        <key type="b" name="config-file-sync-enabled">
            <default>false</default>
            <summary>Whether to automatically sync changes to config files</summary>
        </key>

    </schema>
